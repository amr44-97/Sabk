// build scripts: top-level #run code, run once the program checks, that
// sets how it's built (std/build)
// no-interp: it compiles a C file in, which the VM can't run
#import "std/io";
#import "std/build";
#import "lib/needs_libm";

fn sqrt(x: f64) -> f64 #foreign;
fn helper_twice(x: i32) -> i32 #foreign;

#run configure();
#run println("a second step, after the first");

fn configure() {
    link_library("m");
    add_c_file("lib/build_helper.c");     // relative to this file
    add_c_flags("-DSABK_TEST=1");
    let kind = "debug";
    if (is_release())
        kind = "release";
    println("building a % program", kind);
}

fn main() {
    println("% % %", sqrt(16.0), cbrt(27.0), helper_twice(21));
}
