// a switch that handles every variant still catches a value made with `as`
#import "std/io";

enum Color { Red, Green }

fn name(c: Color) -> string {
    switch (c) {
    case .Red: return "red";
    case .Green: return "green";
    }
}

fn main() {
    println(name(.Green));
    println(name(7 as Color));
}
