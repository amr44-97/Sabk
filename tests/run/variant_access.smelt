// x.Variant: the value a variant holds, checked to be that variant unless
// it's known to be (narrowing); a place, assignable through a pointer
import "std/io";

enum Shape { Circle(r: f64), Rect(w: f64, h: f64), Dot }
struct Item { shape: Shape; name: string; }

fn width(s: Shape) -> f64 {
    if (s !is .Rect) return 0.0;
    return s.Rect.w;                       // narrowed: no check
}

fn grow(p: *Shape) {
    p.Circle.r *= 2.0;                     // through a pointer: checked
}

fn find(xs: []i64, want: i64) -> ?isize {
    for (x, i in xs)
        if (x == want) return i;
    return .None;
}

fn area(it: Item) -> f64 {
    if (it.shape is .Circle && it.shape.Circle.r > 1.0)   // narrowed by &&
        return 3.0 * it.shape.Circle.r * it.shape.Circle.r;
    return 0.0;
}

const AT = #run find(.[5, 6, 7], 7).Some;  // checked in #run too

fn main() {
    let c = Shape.Circle(2.0);
    grow(&c);
    println("% % %", c.Circle.r, width(.Rect(3.0, 4.0)), width(.Dot));
    let o = find(.[1, 2, 3], 3);
    if (o is .Some)
        println("found at %", o.Some);
    println("% %", area(.{ .shape = .Circle(2.0), .name = "a" }), AT);
    let d = Shape.Dot;
    println("now a dot");
    println("%", d.Circle.r);              // panics: it's .Dot
}
