// #no_bounds_check: a function whose indexing and slicing aren't checked.
// Here the slices view part of a larger array, so reading past their
// length still reads the array
import "std/io";

fn peek(xs: []i32, i: isize) -> i32 #no_bounds_check {
    return xs[i];                           // past xs.len: not checked
}

fn widen(xs: []i32, n: isize) -> []i32 #no_bounds_check {
    return xs[0..n];                        // nor this
}

fn get_row(rows: *[2][3]i32, i: isize, j: isize) -> i32 #no_bounds_check {
    return rows.*[i][j];                    // arrays too
}

fn sum(xs: []$T) -> T #no_bounds_check { // and a generic's instances
    let total: T = 0;
    for (i in 0..xs.len) total += xs[i];
    return total;
}

fn checked(xs: []i32, i: isize) -> i32 { return xs[i]; }

fn main() {
    let all: [5]i32 = .[1, 2, 3, 4, 5];
    let two = all[0..2];
    println("% %", peek(two, 3), widen(two, 5));
    let rows: [2][3]i32 = .[.[1, 2, 3], .[4, 5, 6]];
    println("%", get_row(&rows, 0, 4));     // row 0, element 4: the 5
    println("%", sum(two));
    println("%", checked(two, 3));          // still checked: panics
}
