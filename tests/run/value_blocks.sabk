// if expressions, labeled blocks (statements and expressions), and labeled
// switch expressions whose cases run statements, at run time and in #run
#import "std/io";
#import "std/str";

enum Shape { Circle(f64), Rect(w: f64, h: f64), Dot }

fn sign(x: i64) -> i64 { return if (x < 0) -1 else 1; }

fn size(shape: Shape) -> f64 {
    let s = sz: switch (shape) {
    case .Circle(r): 3.0 * r * r;
    case .Rect{w, h}:
        if (w < 0 || h < 0) println("negative rect: % x %", w, h);
        break sz = w * h;
    case .Dot: 0;
    };
    return s;
}

fn workers(text: string) -> i64 {
    return parse_int(text) or_else w: {
        println("bad worker count '%', using 1", text);
        break w = 1;
    };
}

fn first_even(xs: []i64) -> i64 {
    let found = search: {
        for (x in xs)
            if (x % 2 == 0) break search = x;
        break search = -1;
    };
    return found;
}

fn deferred() -> i64 {
    let v = b: {
        defer println("left the block");
        break b = 7;
    };
    return v;
}

const SMALL = if (POINTER_SIZE == 8) 64 else 32;
fn compute() -> i64 { return sign(-5) * 100 + first_even(.[1, 3, 4, 5]) * 10 + (if (true) 2 else 3); }
const COMPUTED = #run compute();

fn main() {
    println("% % %", sign(-3), sign(4), if (sign(2) > 0) "pos" else "neg");
    println("% % %", size(.Circle(1)), size(.Rect(2, 3)), size(.Rect(-1, 2)));
    println("% %", workers("4"), workers("x"));
    println("% % %", first_even(.[1, 3, 8]), first_even(.[1]), deferred());
    let e: Shape = .Circle(2);
    println("% %", if (e is .Circle(r)) r else 0.0, if (true) 1 else 2.5);
    println("% % %", SMALL, compute(), COMPUTED);
    done: {
        if (SMALL > 0) break done;
        println("not printed");
    }
    println("end");
}
