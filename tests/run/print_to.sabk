// formatting and appending text onto a [..]u8, at run time and in #run
#import "std/io";
#import "std/fmt";
#import "std/str";
#import "std/array";
#import "std/mem";

fn report(n: i64) -> string {
    let buf: [..]u8;
    append_string(&buf, "total: ");
    print_to(&buf, "% item%", n, if (n == 1) "" else "s");
    print_to(&buf, " (100%)");               // no values: the text as it is
    return buf as string;
}

const BAKED = #run report(1);

fn main() {
    let buf: [..]u8;
    print_to(&buf, "%{x} %{.2} %", 255, 3.14159, .[1, 2]);
    append_string(&buf, "!");
    println(buf as string);
    array_reserve(&buf, 256);                // grows: print_to keeps up
    for (i in 0..40) print_to(&buf, "%", i % 10);
    println("% %", buf.len, (buf as string)[buf.len - 10..]);
    println(report(3));
    println(BAKED);

    let scratch: [..]u8;                     // any allocator
    scratch.allocator = context.temp_allocator;
    print_to(&scratch, "temp %", 7);
    println(scratch as string);
    free_all(context.temp_allocator);
    array_free(&buf);
}
