import "std/io";
import "std/mem";
import "std/array";
import "std/sorting";
import "std/str";

struct Point { x: i32; y: i32; }

// a struct holding a slice of itself: its slice helpers need the struct
// defined first
struct Tree { value: i32; children: []Tree; }

fn tree_sum(t: Tree) -> i32 {
    let total = t.value;
    for (child in t.children) total += tree_sum(child);
    return total;
}

const DAYS: []string = .["mon", "tue", "wed"];    // static, lives forever
const EMPTY: []i32 = .[];

fn sum(items: []i64) -> i64 {
    let total: i64 = 0;
    for (x in items) total += x;
    return total;
}

fn main() {
    let primes: []i32 = .[2, 3, 5, 7, 11];
    print("%", primes.len); print(" "); print("%", primes[4]); println();
    primes[0] = 1;                              // the elements are writable
    print("%", primes[0]); println();

    print("%", sum(.[1, 2, 3, 4])); println(); // untyped constants become i64

    let xs: [..]i32;
    array_append(&xs, i32.[9, 8, 7]);
    array_append(&xs, primes[1..3]);
    sort(xs);
    for (x in xs) { print("%", x); print(" "); }
    println();

    let names: []string = .["pear", "fig", "apple"];
    sort_by(names, string_less);
    for (n in names) { print(n); print(" "); }
    println();

    let grid: [][]i32 = .[.[1, 2], .[3], .[]];
    for (row in grid) { print("%", row.len); print(" "); }
    println();

    let points: []Point = .[Point.{ .x = 1, .y = 2 }, Point.{ .x = 3, .y = 4 }];
    print("%", points[1].y); println();

    for (d in DAYS) { print(d); print(" "); }
    print("%", EMPTY.len); println();

    let tree = Tree.{ .value = 1, .children = .[
        Tree.{ .value = 2 },
        Tree.{ .value = 3, .children = .[Tree.{ .value = 4 }] },
    ] };
    print("%", tree_sum(tree)); println();

    // filled in each iteration
    let total = 0;
    for (i in 0..3) {
        let pair: []isize = .[i, i * 10];
        total += pair[0] + pair[1];
    }
    print("%", total); println();

    // the elements live until the function returns, not just their block
    let picked: []string;
    if (total > 0) {
        picked = .["kept", "after", "the block"];
    }
    for (word in picked) { print(word); print(" "); }
    println();

    // to keep them past the function, copy them (std/mem)
    let kept = make_kept();
    print("%", kept[0] + kept[1]); println();
}

fn make_kept() -> []i32 {
    return clone_slice(i32.[20, 22]);
}
