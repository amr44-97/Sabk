// a library's operators: importing it brings them, and callers' own
// `operator +` joins its one
#import "std/fmt";

struct Vec3 { x: i64; y: i64; z: i64; }

fn operator +(a: Vec3, b: Vec3) -> Vec3 { return .{ .x = a.x + b.x, .y = a.y + b.y, .z = a.z + b.z }; }
fn operator ==(a: Vec3, b: Vec3) -> bool { return a.x == b.x && a.y == b.y && a.z == b.z; }

fn show(v: Vec3) -> string { return tformat("(%, %, %)", v.x, v.y, v.z); }
