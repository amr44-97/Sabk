// A `$T: type` argument isn't passed: the arguments after it go to the
// value parameters. #run counted the type argument too, took 2.5 for a C
// variadic's extra argument and passed it as an f64 to an f32 (it read 0).
#import "std/io";

fn same($T: type, x: T) -> T { return x; }
fn scaled($T: type, x: T, k: T) -> T { return x * k; }
fn wrap() -> f32 { return same(f32, 2.5); }

const A = #run same(f32, 2.5);
const B = #run scaled(f32, 1.5, 3);
const C = #run wrap();

fn main() {
    println("% % %", A, B, C);
    println("% %", same(f32, 2.5), scaled(f32, 1.5, 3));
}
