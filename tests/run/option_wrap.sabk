// a value where a ?T is expected becomes .Some(value): lets, arguments,
// returns, and literals that take their type from there
import "std/io";

struct Point { x: i32; y: i32; }
enum Color { Red, Green }

fn find(xs: []i64, want: i64) -> ?isize {
    for (x, i in xs)
        if (x == want)
            return i;              // .Some(i)
    return .None;
}

fn first(p: ?Point) -> i32 {
    if (p is .Some(q))
        return q.x;
    return -1;
}

const BAKED: ?i32 = #run wrapped();
fn wrapped() -> ?i32 { return 40 + 2; }

fn main() {
    let o: ?i64 = 5;
    let small: ?u8 = 200;
    let p: ?Point = .{ .x = 1, .y = 2 };
    let c: ?Color = .Green;
    let none: ?Color = .None;
    let arr: ?[2]i32 = .[3, 4];
    println("% % % % % %", o, small, p, c, none, arr);
    println("% % %", find(.[4, 5, 6], 6), find(.[1], 9), first(.{ .x = 7, .y = 0 }));
    println("% %", first(.None), BAKED);
}
