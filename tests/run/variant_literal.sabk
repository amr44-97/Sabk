// a variant with fields made like a struct: K.Let{ .declared = 1 } or
// .Let{ ... } where the enum is known, by name or in order, the rest
// defaulted
#import "std/io";
enum K { Let(declared: i32, value: i32 = 7, uninit: bool), Wrap(i32), Nil }
fn make() -> K { return .Let{ .uninit = true, .declared = 9 }; }
const BAKED = #run make();
fn main() {
    let a = K.Let{ .declared = 1, .uninit = true };
    let b: K = .Let{ .declared = 2 };
    let c = K.Let{ 3, 4, false };
    println("% % % % %", a, b, c, make(), BAKED);
}
