// pointer arithmetic counts in what the pointer points at, as p[i] does:
// p + n is &p[n], q - p how many lie between; the VM agrees with the C
#import "std/io";

struct Pair { a: i32; b: i64; }

fn walk() -> isize {
    let xs: [6]i32 = .[10, 20, 30, 40, 50, 60];
    let p = &xs[0];
    let q = p + 4;
    let total: isize = 0;
    for (let it = p; it < q; it++) total += it.*;
    let back = q - 2;
    let n: u8 = 1;
    return total * 1000 + (q - p) * 100 + back.* / 10 + (n + p).* / 10 - 1;
}

fn main() {
    println("%", walk());
    println("%", #run walk());                     // the VM agrees

    let pairs: [3]Pair = .[.{ 1, 2 }, .{ 3, 4 }, .{ 5, 6 }];
    let first = &pairs[0];
    let last = first + 2;                          // whole Pairs, not bytes
    println("% % %", last.a, (last - first), (last - 1).b);
    let walker = first;
    walker += 2;
    walker -= 1;
    println("%", walker.a);

    let rows: [2][3]i32 = .[.[1, 2, 3], .[4, 5, 6]];
    let r = &rows[0];
    println("%", (r + 1).*);                       // the next row
    let bytes = &rows as *u8;
    let i: i32 = -4;
    println("%", ((bytes + 16) + i) as *i32 == &rows[1][0]);
}
