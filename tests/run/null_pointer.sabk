// following a null pointer panics at the Sabk line, where bounds are
// checked
import "std/io";
struct Node { value: i32; next: *Node; }
fn main() {
    let n = Node.{ .value = 1 };
    let p = &n;
    p.value += 1;
    println("% %", p.value, p.*.value);
    let q = n.next;
    println("before");
    println("%", q.value);
}
