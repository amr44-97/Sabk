// .len is an isize, and so is an integer `let` without a type: lengths mix
// with other signed integers without casts, and counting down stops at 0
import "std/io";
import "std/str";

extern fn printf(format: *u8, ...) -> i32;
extern fn memset(memory: *void, value: i32, size: usize) -> *void;

fn average(xs: []i64) -> i64 {
    let total: i64 = 0;
    for (x in xs) total += x;
    return total / xs.len;                    // isize widens to i64
}

// i >= 0 ends the loop after 0; an empty slice starts at -1, never entering
fn reversed(xs: []string) -> string {
    let b = make_builder();
    for (let i = xs.len - 1; i >= 0; i -= 1)
        builder_append(&b, xs[i]);
    return builder_string(&b);
}

fn last_index(xs: []i64, x: i64) -> isize {
    for (let i = xs.len - 1; i >= 0; i--)
        if (xs[i] == x)
            return i;
    return -1;
}

fn count_all(lists: [][]i64) -> isize {
    let seen = 0;                             // isize
    for (l in lists) seen += l.len;
    return seen;
}

const AVERAGE = #run average(.[2, 4, 9]);
const REVERSED = #run reversed(.["a", "b", "c"]);
const LAST = #run last_index(.[1, 2, 1, 3], 1);
const COUNT = #run count_all(.[.[1, 2], .[3], .[]]);

fn main() {
    println("% %", average(.[2, 4, 9]), AVERAGE);
    println("% % [%]", reversed(.["a", "b", "c"]), REVERSED, reversed(.[]));
    println("% % %", last_index(.[1, 2, 1, 3], 1), LAST, last_index(.[1], 7));
    println("% %", count_all(.[.[1, 2], .[3], .[]]), COUNT);

    // sizeof is a constant, so it fits C's size_t; untyped constants passed
    // to C's `...` are C ints
    let buf: [4]u8;
    memset(&buf, 7, sizeof([4]u8));
    printf("%d %d\n", buf[3], 42);

    let xs: []i64 = .[10, 20, 30];
    let i = xs.len - 4;
    println("about to index with %", i);
    println("%", xs[i]);
}
