// Sabk evaluates left to right, the same in the program and while
// compiling, even where C would leave the order open
import "std/io";
import "std/fmt";
import "std/str";

let trace: [16]u8;
let traced = 0;

// records that it ran, and returns its value
fn step(name: u8, value: i32) -> i32 {
    trace[traced] = name;
    traced++;
    return value;
}

fn bump(x: *isize) -> isize {
    x.* += 10;
    return 1;
}

fn pair(a: isize, b: isize) -> isize { return a * 10 + b; }

struct Point { x: i32; y: i32; }

fn run_all() -> string {
    traced = 0;
    let b = make_builder();

    // arguments, left to right
    let p = pair(step('a', 1), step('b', 2));
    // operands: x is read before bump changes it
    let x = 5;
    let sum = x + bump(&x);
    // a struct literal's values in the order written, not declared
    let pt = Point.{ .y = step('y', 2), .x = step('x', 1) };
    // a call's result read after the call that sets it
    let r = 0;
    let both = pair(bump(&r), r);
    // the place assigned to is found before the value
    let xs = isize.[0, 0, 0];
    let i = 0;
    xs[i] = bump(&i);
    // division: a zero divisor would panic; -1 wraps
    let min = -9223372036854775807 as i64 - 1;
    let minus_one: i64 = -1;

    builder_print(&b, "% % % % % % % %", p, sum, pt, both, xs, i, min / minus_one,
                  trace[..traced] as string);
    return builder_string(&b);
}

const WHILE_COMPILING = #run run_all();

fn main() {
    println(run_all());
    println(WHILE_COMPILING);
}
