// C's type names come from the prelude, as aliases of Sabk's own types.
#import "std/c";
#import "std/io";

fn abs(x: int) -> int #foreign libc;
fn strlen(s: *char) -> size_t #foreign libc;

struct Sample { int: int; double: double; }

fn twice(x: long) -> long { return x * 2; }

fn main() {
    println("sizes: % % % % % % %", sizeof(char), sizeof(short), sizeof(int),
            sizeof(long), sizeof(longlong), sizeof(double), sizeof(size_t));
    println("signed: % %", sizeof(schar), sizeof(ptrdiff_t));

    // aliases mix freely with the types they name
    let a: int = 5;
    let b: i32 = a;
    let c: i64 = b;
    let u: uint = 7;
    let v: u32 = u;
    println("mixed: % % % %", a, b, c, v);
    println("long: %", twice(21));

    // C calls with C types
    println("abs: %", abs(-42));
    println("strlen: %", strlen("hello"));

    let f: float = 3.25;
    println("float: %", f);
    let d: double = 2.5;
    let e: f64 = d;
    println("double: %", e);

    // a field can still be called that, as it can be called `type`
    let s: Sample = .{ .int = 1, .double = 2.5 };
    println("fields: % %", s.int, s.double);
}

// variants too: `CType.long`
enum CType { char, int, long }
const WIDEST = CType.long;
