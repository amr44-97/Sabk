src/main.smelt | dir [src] base [main.smelt] stem [main] ext [.smelt]
main.smelt | dir [] base [main.smelt] stem [main] ext [.smelt]
/usr/lib/libc.so.6 | dir [/usr/lib] base [libc.so.6] stem [libc.so] ext [.6]
/tmp | dir [/] base [tmp] stem [tmp] ext []
a//b | dir [a] base [b] stem [b] ext []
dir/ | dir [dir] base [] stem [] ext []
.bashrc | dir [] base [.bashrc] stem [.bashrc] ext []
.. | dir [] base [..] stem [..] ext []
 | dir [] base [] stem [] ext []
src/main.smelt src/x /abs
[x]
a/./b/../c -> a/c
/../x -> /x
../../a -> ../../a
a/.. -> .
/ -> /
a//b///c/ -> a/b/c
./ -> .
x/../../y -> ../y
true false
None true true
/ None
NotFound
fmt
[exit 0]
