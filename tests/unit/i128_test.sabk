// prints every operation on every pair of a set of edge values; compared
// with Python's integers by tests/unit/i128_check.py
import "std/io";
import "std/array";
import "../../src/const";

fn main() {
    let small = .[0, 1, -1, 2, -2, 7, -7, 10, 100, -100, 9223372036854775807, -9223372036854775807 - 1];
    let values: [..]I128;
    for (v in small) array_add(&values, i128(v));
    array_add(&values, i128_u(18446744073709551615));      // 2^64 - 1
    array_add(&values, i128_shl(i128(1), 64));              // 2^64
    array_add(&values, i128_neg(i128_shl(i128(1), 64)));    // -2^64
    array_add(&values, i128_add(i128_shl(i128(1), 100), i128(12345)));
    array_add(&values, i128_shl(i128(1), 127));             // the minimum
    for (a in values) {
        for (b in values) {
            print("% % ", i128_to_string(a), i128_to_string(b));
            print("% % % ", i128_to_string(i128_add(a, b)), i128_to_string(i128_sub(a, b)), i128_to_string(i128_mul(a, b)));
            if (!i128_is_zero(b))
                print("% % ", i128_to_string(i128_div(a, b)), i128_to_string(i128_mod(a, b)));
            else
                print("- - ");
            print("% % % % ", i128_to_string(i128_and(a, b)), i128_to_string(i128_or(a, b)), i128_to_string(i128_xor(a, b)), i128_cmp(a, b));
            println("");
        }
        for (s in .[0, 1, 5, 63, 64, 65, 100, 127])
            println("shift % % % %", i128_to_string(a), s, i128_to_string(i128_shl(a, s)), i128_to_string(i128_shr(a, s)));
        for (bits in .[8, 16, 32, 64])
            println("fit % % % % % %", i128_to_string(a), bits, i128_fits(a, bits as i32, true), i128_fits(a, bits as i32, false),
                    i128_to_string(i128_wrap(a, bits as i32, true)), i128_to_string(i128_wrap(a, bits as i32, false)));
        println("neg % %", i128_to_string(i128_neg(a)), i128_to_string(i128_not(a)));
    }
}
