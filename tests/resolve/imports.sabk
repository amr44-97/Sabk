// a plain import: the names directly, and the module name too
#import "std/io";
// a file name that is not a valid name: the names directly, no module name
#import "lib/my-lib";
// `as`: only through the name
#import "std/mem" as m;

fn print() {}                 // joins io.print; print() fits only ours

fn main() {
    print();                  // ours
    io.print("qualified");    // io's
    f();                      // my-lib's
    let p = m.alloc(16);
}
