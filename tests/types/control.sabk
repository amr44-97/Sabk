enum Dir { Up, Down }

fn sign(x: i32) -> i32 {
    if (x < 0) return -1;
    else if (x > 0) return 1;
    else return 0;
}

fn forever() -> i32 { while (true) {} }
fn forever2() -> i32 { for (;;) { if (true) continue; } }

fn by_switch(d: Dir) -> i32 {
    switch (d) {
    case Dir.Up: return 1;
    default: return 2;
    }
}

fn loops(items: []f32, grid: *[3]u8) {
    for (i in 0..10) {}
    let n: u64 = 4;
    for (j in 0..n) {}
    for (x in items) {}
    for (b in grid.*) {}
    for (let k: i8 = 0; k < 5; k++) {}
    do { n -= 1; } while (n > 0);
    switch (n) { case 1, 2, 3: break; default: }
}
