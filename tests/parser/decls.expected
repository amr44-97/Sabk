ROOT `#`
  IMPORT `"std/io"`
  IMPORT `"vendor/my-lib"`
    rhs: IDENTIFIER `lib`
  STRUCT `Vec2`
    STRUCT_FIELD `x`
      type: TYPE_NAME `f32`
    STRUCT_FIELD `y`
      type: TYPE_NAME `f32`
      lhs: FLOAT_LITERAL `1.0`
  CONST_DECL `NAME`
    lhs: STRING_LITERAL `"x"`
  FUN_DECL `noop`
    rhs: BLOCK
  SCOPE_REGION `#scope_file`
  UNION `Bits`
    STRUCT_FIELD `i`
      type: TYPE_NAME `u32`
    STRUCT_FIELD `f`
      type: TYPE_NAME `f32`
  STRUCT `Empty`
  ENUM `Color`
    type: TYPE_NAME `u8`
    ENUM_VARIANT `Red`
    ENUM_VARIANT `Green`
    ENUM_VARIANT `Blue`
      lhs: NUMBER_LITERAL `10`
  ENUM `Plain`
    ENUM_VARIANT `A`
  CONST_DECL `Callback`
    lhs: TYPE_EXPR
      lhs: TYPE_FN
        type: TYPE_NAME `bool`
        TYPE_NAME `i32`
        TYPE_PTR `*`
          lhs: TYPE_NAME `u8`
  CONST_DECL `Handler`
    lhs: TYPE_EXPR
      lhs: TYPE_FN
  CONST_DECL `Grid`
    lhs: TYPE_EXPR `[`
      lhs: TYPE_ARRAY `[`
        lhs: TYPE_ARRAY `[`
          lhs: TYPE_NAME `f32`
          rhs: NUMBER_LITERAL `4`
        rhs: NUMBER_LITERAL `4`
  CONST_DECL `Bytes`
    lhs: TYPE_EXPR `[`
      lhs: TYPE_SLICE `[`
        lhs: TYPE_NAME `u8`
  CONST_DECL `Alloc`
    lhs: MEMBER `Allocator`
      lhs: IDENTIFIER `mem`
  CONST_DECL `MAX`
    type: TYPE_NAME `i32`
    lhs: NUMBER_LITERAL `64`
  VAR_DECL `counter`
    type: TYPE_NAME `u64`
  VAR_DECL `ready`
    lhs: BOOL_LITERAL `false`
  FUN_DECL `printf` [foreign libc] [variadic]
    type: TYPE_NAME `i32`
    FUN_PARAM `fmt`
      type: TYPE_PTR `*`
        lhs: TYPE_NAME `u8`
  FUN_DECL `exit` [foreign libc]
    FUN_PARAM `code`
      type: TYPE_NAME `i32`
  FUN_DECL `callback` [c_call]
    type: TYPE_NAME `i32`
    rhs: BLOCK
      RETURN
        lhs: IDENTIFIER `x`
    FUN_PARAM `x`
      type: TYPE_NAME `i32`
  FUN_DECL `alloc`
    type: TYPE_PTR `*`
      lhs: TYPE_NAME `void`
    rhs: BLOCK
      RETURN
        lhs: NULL_LITERAL
    FUN_PARAM `size`
      type: TYPE_NAME `usize`
    FUN_PARAM `a`
      type: TYPE_MEMBER `Allocator`
        lhs: TYPE_NAME `mem`
      lhs: MEMBER `allocator`
        lhs: CONTEXT
