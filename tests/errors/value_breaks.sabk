// break name = value goes to a labeled block or switch expression; what
// the resolver refuses
fn f() -> i64 {
    for (i in 0..3) {
        let h = inner: {
            break;                          // would leave inner, not the loop
        };
    }
    outer: for (i in 0..3) {
        break outer = 1;                    // a loop gives no value
    }
    named: {
        continue named;                     // a block can't be continued
    }
    let k = v: { break v; };                // needs a value
    return 0;
}
