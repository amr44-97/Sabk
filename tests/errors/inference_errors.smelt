struct List($T) { items: []T; }
struct Box($T) { value: T; }
struct Same($T) { a: T; b: T; }
fn zero_of($T: Type) -> T { let z: T; return z; }
fn make($T: Type, n: usize) -> List(T) { let l: List(T); return l; }
fn f() {
    let a = zero_of();                    // nothing says what T is
    let b = make(4);                      // ... here either
    let c = List.{ .items = null };       // null doesn't say
    let d = Box.{};                       // no fields to go by
    let e = Same.{ .a = 1 as i32, .b = 2 as u64 };  // the fields disagree
    let g: Box(u8) = Box.{ .value = 300 }; // the context says u8: 300 doesn't fit
}
