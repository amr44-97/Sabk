// #run catches a Sabk function called through a C function type
fn twice(x: i64) -> i64 { return 2 * x; }

fn wrong() -> i64 {
    let held: *void = twice as *void;
    let f = held as fn(i64) -> i64 #c_call;          // C would call it without its context
    return f(21);
}

const X = #run wrong();
fn main() {}
