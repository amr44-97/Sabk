// p[i] on a *[N]T is the i-th array from p, as in C
fn f(p: *[4]i32) {
    p[3] = 7;                  // meant p.*[3]
    let a: i32 = p[0];         // meant p.*[0]
    let same = p[1] == 3;      // meant p.*[1]
    let sum = p[0] + p[1];     // two arrays
    for (v in p) {}            // meant p.*
    let tail = p[1..];         // a pointer has no length
    let fine = p.*[1..];       // the array's elements
}
