// untaken code still has its names checked: a typo is an error on every
// platform, while names from any branch are fine
#if (POINTER_SIZE == 3) {
    fn exotic_sleep(ms: u32) #foreign;
    struct Exotic { handle: *void; count: i6; }   // a typo in a type
}

fn nap() {
    #if (POINTER_SIZE == 3) exotic_sleep(1);       // fine: declared there
    #if (POINTER_SIZE == 3) exotic_slep(1);        // a typo
}

fn main() {}
