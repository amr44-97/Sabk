// p[i] on a *[..]T would step over whole arrays: an error where the type
// is written out, but not on `.ptr` or in a generic instance (array_add
// of a [..]i32 indexes a *[..]i32 itself)
#import "std/io";
#import "std/array";
fn double_all(xs: *[..]i64) {
    for (i in 0..xs.len) xs[i] *= 2;
    let part = xs[1..3];
    println("%", xs[0]);
}
fn main() {
    let rows: [..][..]i32;            // an instance's *T into an array of them
    let row: [..]i32;
    array_add(&rows, row);
    array_add(&row, 5);
    let p = rows.ptr;
    let first = rows.ptr[0];          // fine: .ptr
    let again = p[0];                 // error: a *[..]i32 written out
}
