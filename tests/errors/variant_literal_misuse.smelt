// braces after a variant are for its fields: not for one holding a value
// of another type, or none, or a plain enum's
import "std/io";
enum K { Let(declared: i32, uninit: bool), Wrap(i32), Nil }
enum Color { Red }
struct Point { x: i32; }
fn main() {
    let a = K.Wrap{ 1 };
    let b = K.Nil{};
    let c = K.Let{ .nope = 1 };
    let d = Color.Red{};
    let e = .Let{ .declared = 1 };
}
