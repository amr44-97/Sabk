// or_return returns from the function it's written in
enum Fail: Error { Bad }
fn get() -> (i64, Fail) { return 1, .None; }

fn twice(body: Code) #expand {
    let x = get() or_return;              // would return from the caller
    #insert body;
}

fn f() -> Fail {
    defer get() or_return;                // can't return from a defer
    twice() { }
    return .None;
}

fn main() { f(); }
