// a #nodiscard function's result can't be dropped without `_ =`
#import "std/io";
enum SaveError: Error { Full }
fn save() -> SaveError #nodiscard { return .None; }
fn counts() -> (i64, bool) #nodiscard { return 1, true; }
fn twice(x: i64) -> i64 #nodiscard #expand { return x * 2; }
fn plain() -> i64 { return 1; }

fn main() {
    save();                              // dropped
    io.println("%", 1);
    counts();                            // both results
    twice(2);                            // a macro too
    defer save();                        // in a defer
    plain();                             // fine: not #nodiscard
    _ = save();                          // fine
    let f = save;
    f();                                 // through a value: not checked
    let n = counts();                    // takes the first, drops the bool
    let total = counts() + 1;            // the same, in an expression
    let m, ok = counts();                // fine: takes both
    let k, _ = counts();                 // fine: `_` takes it
}

fn three() -> (i64, isize, SaveError) #nodiscard { return 1, 2, .None; }

fn more() {
    let a, b = three();                  // takes two of three
    let x: i64;
    let y: isize;
    x, y = three();                      // the same, assigned
}
