// a #nodiscard function's result can't be dropped without `_ =`
import "std/io";
enum SaveError: Error { Full }
fn save() -> SaveError #nodiscard { return .None; }
fn counts() -> (i64, bool) #nodiscard { return 1, true; }
fn twice(x: i64) -> i64 #nodiscard #expand { return x * 2; }
fn plain() -> i64 { return 1; }

fn main() {
    save();                              // dropped
    io.println("%", 1);
    counts();                            // both results
    twice(2);                            // a macro too
    defer save();                        // in a defer
    plain();                             // fine: not #nodiscard
    _ = save();                          // fine
    let f = save;
    f();                                 // through a value: not checked
}
