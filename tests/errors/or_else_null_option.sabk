// `x or_else null` into a ?T: the null is x's type's (an empty string, a
// null pointer), so a failure gives .Some of it, never .None
#import "std/io";
#import "std/map";

fn find(m: *Map(string, i64), key: string) -> *i64 { return map_find(m, key); }
fn take(s: ?string) {}
fn numbers(ok: bool) -> ([]i64, bool) { return .[], ok; }

fn main() {
    let a = read_file("x") or_else null;              // fine: a string, "" on a failure
    let b: ?string = read_file("x") or_else null;     // .Some("")
    let m: Map(string, i64);
    let p: ?*i64 = find(&m, "k") or_else null;        // .Some(null)
    take(read_file("x") or_else null);                // as an argument
    let n: ?[]i64 = numbers(true) or_else null;       // .Some(.[])
    let c: ?string = read_file("x") or_else "";       // fine: "" was asked for
}
