// Functions for growable arrays. The type, [..]T, is the language's: it
// indexes, slices and loops like a slice, and goes wherever a []T is
// expected as a view of its elements.
//
//   let names: [..]string;            ready to use: grows with context.allocator
//   array_add(&names, "ada");
//   let xs = array_of(.[3, 1, 2]);    a copy, in context.allocator
//   for (x in xs) { ... }             xs[i] is bounds-checked against xs.len
//   sort(xs);                         a []T view of the elements
//   let last = array_pop(&xs);
//   array_free(&xs);
//
//   array_add(xs, item), array_append(xs, items), array_pop(xs)
//   array_add_new(xs)                    a pointer to a new last element
//   array_insert(xs, index, item), array_remove(xs, index)
//   array_remove_unordered(xs, index)    O(1): moves the last element in
//   array_find(xs, item)                 its index, or -1 (any []T)
//   array_remove_value(xs, item)         the first equal one, if any
//   array_reserve(xs, capacity), array_clear(xs), array_free(xs)
//
// Its fields are {ptr, len, cap, allocator}, and they can be set: giving
// `allocator` a value before the first add picks where the elements live,
// and `xs.len = 0` empties it but keeps the memory.
//
// Growing may move the elements, so pointers and slices into them are only
// valid until the next add, insert, append or reserve. Copying the array
// copies only its fields: both copies then point at the same elements.

#import "std/mem";
#import "std/os";
#import "std/reflect";

// a new growable array holding copies of `items`
fn array_of(items: []$T, a: Allocator = context.allocator) -> [..]T {
    let xs: [..]T;
    xs.allocator = a;
    array_append(&xs, items);
    return xs;
}

// makes room for at least `capacity` elements
fn array_reserve(xs: *[..]$T, capacity: isize) {
    if (capacity <= xs.cap)
        return;
    if (xs.allocator.procedure == null)
        xs.allocator = context.allocator; // a zero array
    let memory = resize(xs.ptr, xs.cap * sizeof(T), capacity * sizeof(T), 16, xs.allocator);
    if (memory == null)
        panic("out of memory");
    xs.ptr = memory as *T;
    xs.cap = capacity;
}

fn array_add(xs: *[..]$T, item: T) {
    if (xs.len == xs.cap)
        grow(xs, xs.len + 1);
    xs.ptr[xs.len] = item;     // past len, within cap: the pointer's own index
    xs.len += 1;
}

// a new last element, made as `let item: T;` makes one (its fields'
// defaults), to fill in place; the pointer is valid until the array grows
fn array_add_new(xs: *[..]$T) -> *T {
    let item: T;
    array_add(xs, item);
    return &xs.ptr[xs.len - 1];
}

// adds copies of `items`, which must not point into the array itself
fn array_append(xs: *[..]$T, items: []T) {
    let count = xs.len;
    if (count + items.len > xs.cap)
        grow(xs, count + items.len);
    xs.len = count + items.len;
    copy_slice(xs.*[count..], items);
}

fn array_pop(xs: *[..]$T) -> T {
    if (xs.len == 0)
        panic("array_pop on an empty array");
    xs.len -= 1;
    return xs.ptr[xs.len];
}

// puts `item` at `index`, moving the ones after it up
fn array_insert(xs: *[..]$T, index: isize, item: T) {
    let count = xs.len;
    if (index < 0 || index > count)
        panic("array_insert outside the array");
    array_add(xs, item);
    copy_slice(xs.*[index + 1..], xs.*[index..count]);
    xs.*[index] = item;
}

// takes out the element at `index`, moving the ones after it down
fn array_remove(xs: *[..]$T, index: isize) -> T {
    let item = xs.*[index];
    copy_slice(xs.*[index..], xs.*[index + 1..]);
    xs.len -= 1;
    return item;
}

// takes out the element at `index` by moving the last one into its place
fn array_remove_unordered(xs: *[..]$T, index: isize) -> T {
    let item = xs.*[index];
    xs.*[index] = xs.*[xs.len - 1];
    xs.len -= 1;
    return item;
}

// where `item` first is in `xs`, or -1. Elements compare as std/reflect's
// values_equal does: strings by their text, structs field by field
fn array_find(xs: []$T, item: T) -> isize {
    for (i in 0..xs.len)
        if (values_equal(xs[i], item))
            return i;
    return -1;
}

// takes out the first element equal to `item`, keeping the order of the
// rest; false when there's none
fn array_remove_value(xs: *[..]$T, item: T) -> bool {
    let index = array_find(xs.*, item);
    if (index < 0)
        return false;
    array_remove(xs, index);
    return true;
}

// removes every element, keeping the memory for reuse
fn array_clear(xs: *[..]$T) {
    xs.len = 0;
}

fn array_free(xs: *[..]$T) {
    free(xs.ptr, xs.allocator);
    xs.ptr = null;
    xs.len = 0;
    xs.cap = 0;
}

#scope_file

fn grow(xs: *[..]$T, needed: isize) {
    let capacity = xs.cap * 2;
    if (capacity < 8)
        capacity = 8;
    if (capacity < needed)
        capacity = needed;
    array_reserve(xs, capacity);
}
