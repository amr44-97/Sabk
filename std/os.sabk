// The process: its arguments, exiting, panicking, assertions and
// environment variables.
//
//   args()                the program's path, then its arguments: views of
//                         C's argv. While compiling (#run, build scripts):
//                         the program's name, then what follows `--` on
//                         sabk's command line
//   exit(code)            ends the program; buffered output is flushed
//   abort()               ends it at once, like a crash
//   panic("message")      calls context.panic_handler, which by default
//                         prints "file:line:col: panic: message" and aborts
//   assert(x > 0)         panics with the condition's text when false
//   get_env("HOME")       an environment variable, and whether it's set:
//                         let home = get_env("HOME") or_else "/";

#import "std/c";
#import "std/mem";
#import "std/str";

fn exit(code: i32) #foreign libc;
fn abort() #foreign libc;

// the location printed is where the message is written
fn panic(message: Code) #expand {
    fail(#location(message), "panic", #insert message);
}

fn assert(condition: Code) #expand {
    if (!(#insert condition))
        fail(#location(condition), "assertion failed", #text(condition));
}

fn args() -> []string {
    if (saved_args.len == 0) {
        let count = sabk_arg_count();
        saved_args = new([]string, count);
        for (i in 0..count)
            saved_args[i] = from_cstring(sabk_arg(i));
    }
    return saved_args;
}

// a view of C's copy, which setting the variable may change
fn get_env(name: string) -> (string, bool) {
    let c_name = to_cstring(name);
    defer free(c_name);
    let value = getenv(c_name);
    return from_cstring(value), value != null;
}

#scope_file

fn getenv(name: *u8) -> *u8 #foreign libc;
fn fflush(file: *void) -> i32 #foreign libc;

fn fail(location: string, what: string, message: string) {
    let handler = context.panic_handler;
    handler.procedure(handler.data, what, message, location);
    fflush(null); // what the handler printed
    abort(); // a handler that returns can't let the code after it run
}

let saved_args: []string;

// the C runtime keeps argc and argv for these
fn sabk_arg_count() -> i32 #foreign;
fn sabk_arg(i: i32) -> *u8 #foreign;
