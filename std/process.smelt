// Running other programs, on POSIX systems (Linux, macOS). The program
// gets this one's stdin, stdout, stderr and environment, and the call
// waits for it to end.
//
//   let exit, err = run_command(.["cc", "-o", "prog", "prog.c"]);
//   if (err != .None) ...           it didn't start: .NotFound, .CantStart
//   if (exit.code != 0) ...         it ran, and failed
//   run_shell("cc *.c | tee log")   a command line, through /bin/sh
//
// run_command passes each argument as it is, with no shell to split or
// expand it; run_shell's command is read by the shell, so quote what goes
// into it with shell_quote.

import "std/io";
import "std/mem";
import "std/str";
import "std/array";

pub enum ProcessError {
    None,
    NotFound,   // no such program (run_command looks in $PATH)
    CantStart,  // out of processes or memory, or not allowed to run it
}

// how a program ended
pub struct Exit {
    code: i32;    // its exit status; 128 + the signal when one ended it,
                  // as a shell says it
    signal: i32;  // the signal that ended it (11 for SIGSEGV), or 0
}

extern fn posix_spawnp(pid: *i32, file: *u8, actions: *void, attributes: *void,
                       argv: **u8, envp: **u8) -> i32;
extern fn waitpid(pid: i32, status: *i32, options: i32) -> i32;
extern fn system(command: *u8) -> i32;
extern let environ: **u8;
extern fn smelt_errno() -> i32; // the runtime's

// `args[0]` is the program, found in $PATH unless it has a `/`
pub fn run_command(args: []string) -> (Exit, ProcessError) {
    if (args.len == 0)
        return .{}, .NotFound;
    // C's argv: the arguments as C strings, then null
    let argv = new([]*u8, args.len + 1);
    defer free(argv.ptr);
    for (i in 0..args.len)
        argv[i] = to_cstring(args[i]);
    defer for (i in 0..args.len) free(argv[i]);
    let pid: i32 = 0;
    let started = posix_spawnp(&pid, argv[0], null, null, argv.ptr, environ);
    if (started != 0) // an errno value
        return .{}, if (started == 2) .NotFound else .CantStart; // ENOENT
    let status: i32 = 0;
    while (waitpid(pid, &status, 0) < 0)
        if (smelt_errno() != 4) // EINTR: a signal came in; wait again
            return .{}, .CantStart;
    return decode(status), .None;
}

// a command line, run by /bin/sh -c; 127 when the shell can't find it
pub fn run_shell(command: string) -> (Exit, ProcessError) {
    let c_command = to_cstring(command);
    defer free(c_command);
    let status = system(c_command);
    if (status == -1)
        return .{}, .CantStart;
    return decode(status), .None;
}

// `s` as one word for a shell: in single quotes, so nothing in it is
// expanded
pub fn shell_quote(s: string, a: Allocator = context.allocator) -> string {
    let out: [..]u8;
    out.allocator = a;
    array_add(&out, '\'');
    for (c in s) {
        if (c == '\'')
            append_string(&out, "'\\''");
        else
            array_add(&out, c);
    }
    array_add(&out, '\'');
    return out as string;
}

// waitpid's status (the same bits on Linux and macOS)
fn decode(status: i32) -> Exit {
    let signal = status & 0x7f;
    if (signal == 0)
        return .{ .code = (status >> 8) & 0xff };
    return .{ .code = 128 + signal, .signal = signal };
}
