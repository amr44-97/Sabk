// Sorting and searching slices of any type.
//
//   sort(items)                   ascending, by `<`: numbers, enums, pointers
//   sort_by(items, less)          by `less(a, b)`: a sorts before b
//   is_sorted(items), is_sorted_by(items, less)
//   binary_search(items, value)   index of `value` in sorted items, or -1
//   reverse(items)
//
//   sort_by(names, string_less);  strings, with string_less from std/str
//
// The sort is introsort: quicksort, switching to heapsort when it's going
// badly, so it's O(n log n) on any input; short runs use insertion sort.
// It isn't stable: equal elements can change order.

fn less_than(a: $T, b: T) -> bool { return a < b; }

pub fn sort(items: []$T) { sort_by(items, less_than); }

pub fn sort_by(items: []$T, less: fn(T, T) -> bool) {
    // quicksort gets 2 * log2(n) levels before heapsort takes over
    let limit = 0;
    for (let n = items.len; n > 1; n /= 2)
        limit += 2;
    quicksort(items, less, limit);
}

pub fn is_sorted(items: []$T) -> bool { return is_sorted_by(items, less_than); }

pub fn is_sorted_by(items: []$T, less: fn(T, T) -> bool) -> bool {
    for (i in 1..items.len)
        if (less(items[i], items[i - 1]))
            return false;
    return true;
}

pub fn binary_search(items: []$T, value: T) -> isize {
    let lo = 0;
    let hi = items.len;
    while (lo < hi) {
        let mid = lo + (hi - lo) / 2;
        if (items[mid] < value)
            lo = mid + 1;
        else
            hi = mid;
    }
    if (lo < items.len && items[lo] == value)
        return lo;
    return -1;
}

pub fn reverse(items: []$T) {
    if (items.len < 2)
        return;
    let i = 0;
    let j = items.len - 1;
    while (i < j) {
        swap(&items[i], &items[j]);
        i++;
        j--;
    }
}

// ---- the algorithm

fn swap(a: *$T, b: *T) {
    let tmp = a.*;
    a.* = b.*;
    b.* = tmp;
}

fn quicksort(items: []$T, less: fn(T, T) -> bool, limit: isize) {
    while (items.len > 16) {
        if (limit == 0) {
            heapsort(items, less);
            return;
        }
        limit--;
        let p = partition(items, less);
        // recurse into the smaller side and loop on the bigger one, so the
        // stack stays O(log n)
        if (p < items.len - p) {
            quicksort(items[..p], less, limit);
            items = items[p + 1..];
        } else {
            quicksort(items[p + 1..], less, limit);
            items = items[..p];
        }
    }
    insertion_sort(items, less);
}

// puts a pivot in its final place, smaller elements before it, and returns
// its index
fn partition(items: []$T, less: fn(T, T) -> bool) -> isize {
    let last = items.len - 1;
    let mid = items.len / 2;
    // median of three ends up in items[last]
    if (less(items[mid], items[0]))
        swap(&items[mid], &items[0]);
    if (less(items[last], items[0]))
        swap(&items[last], &items[0]);
    if (less(items[mid], items[last]))
        swap(&items[mid], &items[last]);
    let pivot = items[last];
    let store = 0;
    for (i in 0..last)
        if (less(items[i], pivot)) {
            swap(&items[i], &items[store]);
            store++;
        }
    swap(&items[store], &items[last]);
    return store;
}

fn insertion_sort(items: []$T, less: fn(T, T) -> bool) {
    for (i in 1..items.len) {
        let value = items[i];
        let j = i;
        while (j > 0 && less(value, items[j - 1])) {
            items[j] = items[j - 1];
            j--;
        }
        items[j] = value;
    }
}

fn heapsort(items: []$T, less: fn(T, T) -> bool) {
    let n = items.len;
    for (let i = n / 2; i > 0; i--)
        sift_down(items, less, i - 1, n);
    for (let end = n; end > 1; end--) {
        swap(&items[0], &items[end - 1]);
        sift_down(items, less, 0, end - 1);
    }
}

fn sift_down(items: []$T, less: fn(T, T) -> bool, root: isize, end: isize) {
    while (true) {
        let child = root * 2 + 1;
        if (child >= end)
            return;
        if (child + 1 < end && less(items[child], items[child + 1]))
            child++;
        if (!less(items[root], items[child]))
            return;
        swap(&items[root], &items[child]);
        root = child;
    }
}
