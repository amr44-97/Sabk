// smelt: the Smelt compiler, written in Smelt.
//
//   smelt --tokens file.smelt     print the tokens of a file
//   smelt --ast file.smelt        print its syntax tree
//   smelt --resolve file.smelt    print every module's tree, with names
//                                 linked to their declarations
//   smelt --types file.smelt      print every module's tree with types and
//                                 constants, then every generic instance
//   --std <dir>                   the standard library (default: std next
//                                 to the compiler)
//
// The rest of the compiler is still the C++ one in ../the-compiler.

import "std/io";
import "std/os";
import "std/fmt";
import "std/path";
import "std/str";
import "std/array";
import "std/build";
import "source";
import "token";
import "lexer";
import "parser";
import "ast";
import "module";
import "resolve";
import "check";
import "generics";

// the VM's way to C, and libffi
#run configure();

fn configure() {
    add_c_file("vm_ffi.c");
    link_library("ffi");
}

extern fn snprintf(buffer: *u8, size: usize, format: *u8, ...) -> i32;

enum Mode { None, Tokens, Ast, Resolve, Types }

fn usage() -> i32 {
    eprintln("usage: smelt --tokens|--ast|--resolve|--types [--std <dir>] <file>");
    return 1;
}

fn main() -> i32 {
    let argv = args();
    let mode = Mode.None;
    let path = "";
    let std_dir = path_normalize(path_join(path_dir(argv[0]), "std"));
    let i: isize = 1;
    while (i < argv.len) {
        let arg = argv[i];
        i++;
        if (arg == "--tokens")
            mode = .Tokens;
        else if (arg == "--ast")
            mode = .Ast;
        else if (arg == "--resolve")
            mode = .Resolve;
        else if (arg == "--types")
            mode = .Types;
        else if (arg == "--std" && i < argv.len) {
            std_dir = argv[i];
            i++;
        } else if (arg.len > 0 && arg[0] == '-' || path.len > 0)
            return usage();
        else
            path = arg;
    }
    if (mode == .None || path.len == 0)
        return usage();

    if (mode == .Types) {
        let r = make_resolver(std_dir);
        let c = make_checker(&r);
        r.checker = &c;
        set_build_defaults(&c, path);
        if (!resolve_program(&r, path) || !check_program(&c))
            return 1;
        for (m in r.modules) {
            println("MODULE %", m.path);
            dump(m.root);
        }
        for (instance in c.instances) {
            println("INSTANCE %", describe_instance(&c, instance));
            dump(instance);
        }
        return 0;
    }

    if (mode == .Resolve) {
        let r = make_resolver(std_dir);
        // `#insert` and top-level `#if`s check code while resolving
        let c = make_checker(&r);
        r.checker = &c;
        set_build_defaults(&c, path);
        if (!resolve_program(&r, path))
            return 1;
        for (m in r.modules) {
            println("MODULE %", m.path);
            dump(m.root);
        }
        return 0;
    }

    let src, err = load_source(path);
    if (err != .None) {
        eprintln("%: %", path, system_error_text(err));
        return 1;
    }
    let tokens, ok = lex(&src);
    if (!ok)
        return 1;
    if (mode == .Tokens) {
        dump_tokens(tokens);
        return 0;
    }
    let root, errors = parse_file(&src, tokens);
    dump(root);
    return if (errors > 0) 1 else 0;
}

// what build scripts start from: relative paths are relative to the main
// file's directory, and args() while compiling is the program's name
fn set_build_defaults(c: *Checker, path: string) {
    c.build.base_dir = path_dir(path);
    array_add(&c.build.program_args, path_stem(path));
}

fn dump_tokens(tokens: []Token) {
    let out: [..]u8;
    for (t in tokens) {
        print_to(&out, "%{4}:%{<3} %{<22} `%`", t.line, t.column, token_name(t.kind), t.text);
        if (t.kind == .Number) {
            let value, _ = integer_value(t.text);
            print_to(&out, " = %", value);
        }
        if (t.kind == .Float) {
            let buffer: [64]u8 = ---;
            snprintf(buffer.ptr, buffer.len as usize, "%g", float_value(t.text));
            print_to(&out, " = %", from_cstring(buffer.ptr));
        }
        array_add(&out, '\n');
    }
    print(out as string);
}
