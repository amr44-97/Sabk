// The syntax tree the parser makes. Every node has a token (its name, its
// operator, or the token it starts at: errors point there) and a kind,
// which holds the node's own parts by name. A missing part is null.
//
// dump() prints a tree as the C++ compiler's --ast did, so the two parsers
// can be compared on the same files.

#import "std/array";
#import "std/c";
#import "std/fmt";
#import "std/io";
#import "std/map";
#import "std/str";
#import "token";
#import "module";
#import "types";
#import "const";

struct Node {
    tok: Token;
    span: string;      // its source text, where a message quotes it (call
                       // arguments, operands of operators); else empty
    kind: NodeKind;
    caller: bool;      // written with a backtick: the macro caller's
    color: i32;        // the macro expansion it was copied into; 0: none

    // set by the resolver
    decl: *Node;       // what a name, a `break label` or a `return` in a
                       // macro refers to
    owner: *Module;    // a top-level declaration's (or variant's) module
    untaken_if: *Node; // a declaration in a top-level #if branch not taken

    // set by the checker
    ty: *Type;         // an expression's type; a declaration's declared type
    conv: *Type;       // an expression implicitly converted to this type
    cval: Const;       // the value, when it's known at compile time
    check_state: u8;   // declarations: 0 unchecked, 1 in progress, 2 done
    convs: []*Type;    // `a, b = f()`: each target's conversion, or null
    generic: *Node;    // an instance: the template it was made from
    instance_args: []*Type; // an instance: the types its T... are bound to
    is_baked: bool;    // a literal made from a #run result: already checked
}

enum BinaryOp {
    Add, Sub, Mul, Div, Mod,
    Lt, Gt, LtEq, GtEq, EqEq, NotEq,
    And, Or,
    BitOr, BitAnd, BitXor, Shl, Shr,
}

enum UnaryOp {
    Not, Neg, BitNot,
    AddressOf,          // &x
    PointerType,        // *T written where an expression goes: make(*Node)
}

// who can name a top-level declaration: whoever imports its module, its
// module's files, or its own file
enum Visibility { Export, Module, File }

enum NodeKind {
    Root(decls: []*Node),

    // ---- declarations; tok is the name unless said otherwise
    Import(alias: *Node, module: *Module = null), // tok: the path, a string token
    // #scope_export, #scope_module, #scope_file: who sees the declarations
    // after it, up to the next one; tok: the directive
    ScopeRegion(visibility: Visibility),
    Load,                                    // #load "file"; tok: the path, a string token
    // several functions of one name, in a scope (never in a tree): a call
    // picks one by its arguments; tok: the first's name
    Overloads(fns: []*Node),
    // is_extern: C's calling convention, no context: `#foreign` (no body)
    // or `#c_call` (a body C calls)
    Fn(params: []*Node, result: *Node, body: *Node,
       is_extern: bool, is_macro: bool, variadic: bool, format: bool,
       nodiscard: bool, no_bounds_check: bool,
       type_params: []*Node = .[],           // the $Ts in params' types
       result_defaults: []*Node = .[],       // -> (i64, ParseError = .None): one per
                                             // written result, null where there's none
       symmetric: bool = false,              // #symmetric: two parameters, either order
       foreign: *Node = null,                // #foreign lib: the library's name, or null
       link_name: string = ""),              // #foreign lib "name": its C name ("": ours)
    Param(declared: *Node, value: *Node, is_type: bool, variadic: bool),
    Struct(fields: []*Node, type_params: []*Node, is_union: bool,
           packed: bool = false,             // #packed: no padding, alignment 1
           align: *Node = null),             // #align(n): the struct's alignment
    Field(declared: *Node, value: *Node),
    Enum(backing: *Node, variants: []*Node, type_params: []*Node),
    // Number(i64) has a payload type; Binary(op: Op, ...) fields, a Struct
    Variant(payload: *Node, fields: *Node, value: *Node),
    TypeAlias(aliased: *Node),
    Let(declared: *Node, value: *Node, is_extern: bool, uninit: bool, // is_extern: #foreign
        foreign: *Node = null, link_name: string = ""), // as Fn's
    // const raylib = #library "vendor/libraylib"; #system_library "libm":
    // a library foreign declarations name; `dir`: where `path` is relative
    // to (the resolver's)
    Library(path: Token, system: bool, link_always: bool, dir: string = ""),
    LetValues(names: []*Node, values: *Node), // let a, b = ...; names are Lets
    Const(declared: *Node, value: *Node),
    Run(value: *Node),                       // #run value; tok: `#run`
    // #assert(condition, "message"): checked while compiling, at the top
    // level and per instance in functions; message: a String, or null
    StaticAssert(cond: *Node, message: *Node), // tok: `#assert`
    InsertString(value: *Node),              // #insert value; tok: `#insert`

    // ---- statements; tok is their keyword unless said otherwise
    Block(stmts: []*Node, label: *Node, gives_value: bool), // tok: `{`
    ExprStmt(value: *Node, dropped: bool),   // tok: where it starts
    Assign(target: *Node, value: *Node),     // tok: `=`, `+=`, ...
    Inc(target: *Node),                      // tok: `++`
    Dec(target: *Node),
    Return(value: *Node),
    Break(label: *Node, value: *Node),
    Continue(label: *Node, value: *Node),
    Defer(stmt: *Node),
    If(cond: *Node, then: *Node, else_: *Node, gives_value: bool),
    StaticIf(cond: *Node, then: *Node, else_: *Node), // #if; tok: `if`
    While(cond: *Node, body: *Node, label: *Node),
    DoWhile(body: *Node, cond: *Node, label: *Node),
    For(init: *Node, cond: *Node, step: *Node, body: *Node, label: *Node),
    ForIn(iterable: *Node, range_end: *Node, body: *Node, label: *Node, // tok: the variable
          index: *Node = null),              // for (x, i in xs): a LoopIndex
    LoopIndex,                               // for (x, i in xs)'s i; tok: the name
    Switch(value: *Node, cases: []*Node, label: *Node, gives_value: bool,
           continued: bool = false,    // `continue label = v` runs it again
           complete: bool = false,     // handles every value of its enum
           in_order: bool = false),    // nested patterns or guards: cases tested in order
    Case(patterns: []*Node, guard: *Node, body: *Node),
    DefaultCase(body: *Node),
    Insert,                                  // #insert code; tok: the Code parameter

    // ---- expressions
    Identifier,
    Number, Float, Char, Bool, Null, Context,
    String(quoted: string),                  // the token, or text #text made
    Unary(op: UnaryOp, operand: *Node),      // tok: the operator
    Binary(op: BinaryOp, lhs: *Node, rhs: *Node),
    Deref(pointer: *Node),                   // p.*; tok: `*`
    Grouped(inner: *Node),                   // (inner); tok: `(`
    Call(callee: *Node, args: []*Node, trailing_block: bool), // tok: `(`
    Member(object: *Node),                   // object.name; tok: the name
    Index(object: *Node, index: *Node),      // tok: `[`
    Slice(object: *Node, lo: *Node, hi: *Node),
    Cast(value: *Node, to: *Node),
    SizeOf(of: *Node, is_type: bool = false), // a type or a value; the
    TypeInfo(of: *Node, is_type: bool = false), // resolver says which
    Spread(value: *Node),                    // ..xs as arguments; tok: `..`
    Values(items: []*Node),                  // a, b; tok: the first's
    OrReturn(value: *Node),
    OrElse(value: *Node, fallback: *Node),
    FirstValue(value: *Node),                // a call's first result where one value is
                                             // expected (the checker makes it); tok: the call's
    // new(T, ...), new([]T, n, ...), new(value, ...): the resolver tells
    // what `first` and `second` are
    New(declared: *Node, value: *Node, first: *Node, second: *Node),
    StructInit(declared: *Node, items: []*Node, // T.{...}; tok: `{`, or `.` in .{...}
               variant: bool = false),      // K.Let{...} or .Let{...}: a variant's fields
    FieldInit(value: *Node),                 // .name = value; tok: the name
    ArrayLiteral(elem: *Node, items: []*Node), // T.[...]; tok: the `.`
    EnumShorthand,                           // .Red; tok: `.Red`
    TextOf,                                  // #text(code)
    LocationOf,                              // #location(code)
    CallerLocation,                          // #caller_location: a parameter's default
    TypeExpr(declared: *Node),               // a type where an expression goes
    // made by the resolver: a macro call replaced by a copy of the macro's
    // body, `expansion` the copy's color; tok: the callee's
    MacroExpansion(callee: *Node, stmts: []*Node, result: *Node, expansion: i32),
    TypeCompare(lhs: *Node, rhs: *Node),     // T == U in an #if condition
    // made by the resolver: `T is []$E`, a type matched against a type
    // pattern, whose `$` names are bound where it's true
    TypeIs(subject: *Node, pattern: *Node),
    KindPattern,                             // `T is enum`: tok is struct, enum, union or fn
    // made by the checker: a tagged enum's value, `Expr.Number(1)`; decl:
    // the variant, payload: its value, or null
    VariantValue(payload: *Node),
    // made by the checker: x.Some, the value variant `decl` holds, checked
    // to be that variant unless the checker knows it is (narrowing)
    VariantAccess(object: *Node, checked: bool),

    // ---- patterns, in cases and after `is`
    Is(value: *Node, pattern: *Node),
    Range(lo: *Node, hi: *Node, inclusive: bool), // tok: `..`
    VariantPattern(variant: *Node, bindings: []*Node, by_fields: bool),
    FieldPattern(pattern: *Node, field: *Node),
    Binding(field: *Node, by_ref: bool),     // x or &x; tok: the name

    // ---- types
    TypeName(args: []*Node),                 // tok: the name, or `?` in ?T
    TypeMember(module: *Node, args: []*Node), // mem.Allocator; tok: the member
    TypePointer(to: *Node),
    TypeArray(elem: *Node, len: *Node),
    TypeSlice(elem: *Node),
    TypeDynArray(elem: *Node),
    TypeFn(params: []*Node, result: *Node,
           c_call: bool = false,           // fn(...) #c_call: a C function pointer
           variadic: bool = false),        // fn(*char, ...) -> int #c_call
    TypeTuple(items: []*Node),               // (i64, bool) after `->`
    TypeParam,                               // $T; tok: the name
    BuiltinType,                             // i32, bool, ...: the resolver's
}

fn new_node(tok: Token, kind: NodeKind) -> *Node {
    return new(Node.{ .tok = tok, .kind = kind });
}

// the name C knows a C function or variable by: its #foreign "name", or
// its own
fn c_symbol(d: *Node) -> string {
    switch (d.kind) {
    case .Fn{link_name}: if (link_name.len > 0) return link_name;
    case .Let{link_name}: if (link_name.len > 0) return link_name;
    default:
    }
    return d.tok.text;
}

// a C function or variable declared here and defined elsewhere: `#foreign`
fn is_foreign(d: *Node) -> bool {
    switch (d.kind) {
    case .Fn{is_extern, body}: return is_extern && body == null;
    case .Let{is_extern}: return is_extern;
    default: return false;
    }
}

// a foreign declaration's library, or null
fn foreign_library(d: *Node) -> *Node {
    let lib: *Node = null;
    switch (d.kind) {
    case .Fn{foreign}: lib = foreign;
    case .Let{foreign}: lib = foreign;
    default:
    }
    return if (lib != null) lib.decl else null;
}

// ---- the C++ compiler's dump

// a node as the C++ Node held it: its tag, and its parts in lhs, rhs,
// extra and list
struct OldShape {
    tag: string;
    declared: *Node;    // `type:`
    lhs: *Node;
    rhs: *Node;
    extra: *Node;
    list: []*Node;
    type_params: []*Node;
    is_extern: bool;
    foreign: *Node;     // #foreign's library
    link_name: string;
    library: string;    // a Library's directive and path
    uninit: bool;
    no_bounds_check: bool;
    nodiscard: bool;
    dropped: bool;
    variadic: bool;
    c_call: bool;       // a C function type
    packed: bool;       // a #packed struct
    type_param: bool;
    generic: bool;
}

fn old_shape(n: *Node) -> OldShape {
    let s: OldShape;
    switch (n.kind) {
    case .Root{decls}: s.tag = "ROOT"; s.list = decls;
    case .Import{alias}: s.tag = "IMPORT"; s.rhs = alias;
    case .ScopeRegion: s.tag = "SCOPE_REGION";
    case .Load: s.tag = "LOAD";
    case .Overloads{fns}: s.tag = "OVERLOADS"; s.list = fns;
    case .Fn(f):
        s.tag = if (f.is_macro) "MACRO_DECL" else "FUN_DECL";
        s.generic = f.type_params.len > 0 && n.generic == null;
        s.declared = f.result;
        s.rhs = f.body;
        s.list = f.params;
        s.is_extern = f.is_extern;
        s.foreign = f.foreign;
        s.link_name = f.link_name;
        s.variadic = f.variadic;
        s.nodiscard = f.nodiscard;
        s.no_bounds_check = f.no_bounds_check;
    case .Param(p):
        s.tag = "FUN_PARAM";
        s.declared = p.declared;
        s.lhs = p.value;
        s.type_param = p.is_type;
        s.variadic = p.variadic;
    case .Struct(st):
        s.tag = if (st.is_union) "UNION" else "STRUCT";
        s.list = st.fields;
        s.type_params = st.type_params;
        s.generic = st.type_params.len > 0 && n.generic == null;
        s.packed = st.packed;
        s.extra = st.align;
    case .Field{declared, value}:
        s.tag = "STRUCT_FIELD"; s.declared = declared; s.lhs = value;
    case .Enum(e):
        s.tag = "ENUM";
        s.declared = e.backing;
        s.list = e.variants;
        s.generic = e.type_params.len > 0 && n.generic == null;
    case .Variant{payload, fields, value}:
        s.tag = "ENUM_VARIANT"; s.declared = payload; s.lhs = value; s.rhs = fields;
    case .TypeAlias{aliased}:
        s.tag = "TYPE_ALIAS"; s.declared = aliased;
    case .Let(l):
        s.tag = "VAR_DECL";
        s.declared = l.declared;
        s.lhs = l.value;
        s.is_extern = l.is_extern;
        s.foreign = l.foreign;
        s.link_name = l.link_name;
        s.uninit = l.uninit;
    case .LetValues{names, values}: s.tag = "LET_VALUES"; s.lhs = values; s.list = names;
    case .Const(c):
        s.tag = "CONST_DECL"; s.declared = c.declared; s.lhs = c.value;
    case .Library(l):
        s.tag = "LIBRARY";
        s.library = tformat("%{}library%", if (l.system) "#system_" else "#",
                            if (l.link_always) ",link_always" else "");
    case .Run{value}: s.tag = "RUN"; s.lhs = value;
    case .StaticAssert{cond, message}: s.tag = "STATIC_ASSERT"; s.lhs = cond; s.rhs = message;
    case .InsertString{value}: s.tag = "INSERT_STRING"; s.lhs = value;

    case .Block{stmts, gives_value}:
        s.tag = if (gives_value) "BLOCK_EXPR" else "BLOCK"; s.list = stmts;
    case .ExprStmt{value, dropped}: s.tag = "EXPR_STMT"; s.lhs = value; s.dropped = dropped;
    case .Assign{target, value}: s.tag = "ASSIGN"; s.lhs = target; s.rhs = value;
    case .Inc{target}: s.tag = "INC"; s.lhs = target;
    case .Dec{target}: s.tag = "DEC"; s.lhs = target;
    case .Return{value}: s.tag = "RETURN"; s.lhs = value;
    case .Break{value}: s.tag = "BREAK"; s.rhs = value;
    case .Continue{value}: s.tag = "CONTINUE"; s.rhs = value;
    case .Defer{stmt}: s.tag = "DEFER"; s.lhs = stmt;
    case .If(i):
        s.tag = if (i.gives_value) "IF_EXPR" else "IF";
        s.lhs = i.cond; s.rhs = i.then; s.extra = i.else_;
    case .StaticIf{cond, then, else_}:
        s.tag = "STATIC_IF"; s.lhs = cond; s.rhs = then; s.extra = else_;
    case .While{cond, body}: s.tag = "WHILE"; s.lhs = cond; s.rhs = body;
    case .DoWhile{body, cond}: s.tag = "DO_WHILE"; s.lhs = cond; s.rhs = body;
    case .For(f):
        s.tag = "FOR";
        s.rhs = f.body;
        s.list = new([]*Node, 3);
        s.list[0] = f.init;
        s.list[1] = f.cond;
        s.list[2] = f.step;
    case .ForIn{iterable, range_end, body, index}:
        s.tag = "FOR_IN"; s.lhs = iterable; s.rhs = body; s.extra = range_end;
        if (index != null) {
            s.list = new([]*Node, 1);
            s.list[0] = index;
        }
    case .LoopIndex: s.tag = "LOOP_INDEX";
    case .Switch{value, cases, gives_value}:
        s.tag = if (gives_value) "SWITCH_EXPR" else "SWITCH"; s.lhs = value; s.list = cases;
    case .Case{patterns, guard, body}:
        s.tag = "CASE"; s.rhs = body; s.extra = guard; s.list = patterns;
    case .DefaultCase{body}: s.tag = "DEFAULT_CASE"; s.rhs = body;
    case .Insert: s.tag = "INSERT";

    case .Identifier: s.tag = "IDENTIFIER";
    case .Number: s.tag = "NUMBER_LITERAL";
    case .Float: s.tag = "FLOAT_LITERAL";
    case .String: s.tag = "STRING_LITERAL";
    case .Char: s.tag = "CHAR_LITERAL";
    case .Bool: s.tag = "BOOL_LITERAL";
    case .Null: s.tag = "NULL_LITERAL";
    case .Context: s.tag = "CONTEXT";
    case .Unary{op, operand}: s.tag = unary_tag(op); s.lhs = operand;
    case .Binary{op, lhs, rhs}: s.tag = binary_tag(op); s.lhs = lhs; s.rhs = rhs;
    case .Deref{pointer}: s.tag = "DEREF"; s.lhs = pointer;
    case .Grouped{inner}: s.tag = "GROUPED_EXPR"; s.lhs = inner;
    case .Call{callee, args}: s.tag = "CALL"; s.lhs = callee; s.list = args;
    case .Member{object}: s.tag = "MEMBER"; s.lhs = object;
    case .Index{object, index}: s.tag = "INDEX"; s.lhs = object; s.rhs = index;
    case .Slice{object, lo, hi}: s.tag = "SLICE"; s.lhs = object; s.rhs = lo; s.extra = hi;
    case .Cast{value, to}: s.tag = "CAST"; s.declared = to; s.lhs = value;
    case .SizeOf{of, is_type}:
        s.tag = "SIZE_OF";
        if (is_type) s.declared = of; else s.extra = of;
    case .TypeInfo{of, is_type}:
        s.tag = "TYPE_INFO";
        if (is_type) s.declared = of; else s.extra = of;
    case .Spread{value}: s.tag = "SPREAD"; s.lhs = value;
    case .Values{items}: s.tag = "VALUES"; s.list = items;
    case .OrReturn{value}: s.tag = "OR_RETURN"; s.lhs = value;
    case .OrElse{value, fallback}: s.tag = "OR_ELSE"; s.lhs = value; s.rhs = fallback;
    case .FirstValue{value}: s.tag = "FIRST_VALUE"; s.lhs = value;
    case .New(nw):
        s.tag = "NEW"; s.declared = nw.declared; s.lhs = nw.first; s.rhs = nw.second;
        s.extra = nw.value;
    case .StructInit{declared, items}: s.tag = "STRUCT_INIT"; s.declared = declared; s.list = items;
    case .FieldInit{value}: s.tag = "FIELD_INIT"; s.rhs = value;
    case .ArrayLiteral{elem, items}: s.tag = "ARRAY_LITERAL"; s.declared = elem; s.list = items;
    case .EnumShorthand: s.tag = "ENUM_SHORTHAND";
    case .TextOf: s.tag = "TEXT_OF";
    case .LocationOf: s.tag = "LOCATION_OF";
    case .CallerLocation: s.tag = "CALLER_LOCATION";
    case .TypeExpr{declared}: s.tag = "TYPE_EXPR"; s.lhs = declared;
    case .MacroExpansion{callee, stmts, result}:
        s.tag = "MACRO_EXPANSION"; s.declared = result; s.lhs = callee; s.list = stmts;
    case .TypeCompare{lhs, rhs}: s.tag = "TYPE_COMPARE"; s.lhs = lhs; s.rhs = rhs;
    case .TypeIs{subject, pattern}: s.tag = "TYPE_IS"; s.lhs = subject; s.rhs = pattern;
    case .KindPattern: s.tag = "KIND_PATTERN";
    case .VariantValue{payload}: s.tag = "VARIANT_VALUE"; s.lhs = payload;
    case .VariantAccess{object}: s.tag = "VARIANT_ACCESS"; s.lhs = object;

    case .Is{value, pattern}: s.tag = "IS"; s.lhs = value; s.rhs = pattern;
    case .Range{lo, hi}: s.tag = "RANGE"; s.lhs = lo; s.rhs = hi;
    case .VariantPattern{variant, bindings}:
        s.tag = "VARIANT_PATTERN"; s.lhs = variant; s.list = bindings;
    case .FieldPattern{pattern, field}: s.tag = "FIELD_PATTERN"; s.lhs = pattern; s.extra = field;
    case .Binding{field}: s.tag = "VAR_DECL"; s.extra = field;

    case .TypeName{args}: s.tag = "TYPE_NAME"; s.list = args;
    case .TypeMember{module, args}: s.tag = "TYPE_MEMBER"; s.lhs = module; s.list = args;
    case .TypePointer{to}: s.tag = "TYPE_PTR"; s.lhs = to;
    case .TypeArray{elem, len}: s.tag = "TYPE_ARRAY"; s.lhs = elem; s.rhs = len;
    case .TypeSlice{elem}: s.tag = "TYPE_SLICE"; s.lhs = elem;
    case .TypeDynArray{elem}: s.tag = "TYPE_DYN_ARRAY"; s.lhs = elem;
    case .TypeFn(f):
        s.tag = "TYPE_FN"; s.declared = f.result; s.list = f.params;
        s.variadic = f.variadic;
        s.c_call = f.c_call;
    case .TypeTuple{items}: s.tag = "TYPE_TUPLE"; s.list = items;
    case .TypeParam: s.tag = "TYPE_PARAM";
    case .BuiltinType: s.tag = "BUILTIN_TYPE";
    }
    return s;
}

// prints the tree to stdout
fn dump(n: *Node) {
    let out: [..]u8;
    dump_into(&out, n, 0, "");
    print(out as string);
    array_free(&out);
}

// ---- walking and copying trees
//
// A node's children are the *Node and []*Node parts of its kind, found
// through NodeKind's type information, so a new kind needs nothing here.

// a copy of `n` and everything under it, all given `color` (unless it's
// negative)
fn clone_node(n: *Node, color: i32) -> *Node {
    if (n == null)
        return null;
    let copy = new(n.*);
    if (color >= 0)
        copy.color = color;
    let info, at = parts(copy);
    if (info == null)
        return copy;
    let node_ptr, node_list = type_info(*Node), type_info([]*Node);
    for (f in info.fields) {
        if (f.info == node_ptr) {
            let slot = (at + f.offset) as **Node;
            slot.* = clone_node(slot.*, color);
        } else if (f.info == node_list) {
            let slot = (at + f.offset) as *[]*Node;
            let items = new([]*Node, slot.len);
            for (i in 0..items.len)
                items[i] = clone_node(slot.*[i], color);
            slot.* = items;
        }
    }
    return copy;
}

// `n`'s children in the order the C++ compiler kept them (type, lhs, rhs,
// extra, then the list): what walks over a tree go through
fn children(n: *Node) -> [..]*Node {
    let s = old_shape(n);
    let out: [..]*Node;
    out.allocator = context.temp_allocator;
    for (c in .[s.declared, s.lhs, s.rhs, s.extra])
        if (c != null)
            array_add(&out, c);
    for (c in s.list)
        if (c != null)
            array_add(&out, c);
    return out;
}

// `n`'s children without a declaration's written type (lhs, rhs, extra,
// then the list): what walks over code look at
fn code_children(n: *Node) -> [..]*Node {
    let s = old_shape(n);
    let out: [..]*Node;
    out.allocator = context.temp_allocator;
    for (c in .[s.lhs, s.rhs, s.extra])
        if (c != null)
            array_add(&out, c);
    for (c in s.list)
        if (c != null)
            array_add(&out, c);
    return out;
}

// a string's text as a literal, escaped: what #text and #location make
fn quote_string(bytes: string) -> string {
    let out: [..]u8;
    array_add(&out, '"');
    for (c in bytes) {
        if (c == '"' || c == '\\') {
            array_add(&out, '\\');
            array_add(&out, c);
        } else if (c == '\n') {
            append_string(&out, "\\n");
        } else if (c == '\t') {
            append_string(&out, "\\t");
        } else if (c < 32 || c >= 127) {
            print_to(&out, "\\x%{02x}", c);
        } else {
            array_add(&out, c);
        }
    }
    array_add(&out, '"');
    return out as string;
}

// C's %g: what the C++ compiler's dumps printed floats with
fn format_g(f: f64) -> string {
    let buffer: [64]u8 = ---;
    snprintf(buffer.ptr, buffer.len as usize, "%g", f);
    return copy_string(from_cstring(buffer.ptr));
}

// A copy of a resolved declaration for a generic instance: names that
// referred to nodes inside it now refer to the copies (each instance gets
// its own locals and its own type parameters). A node met twice is copied
// once: a function's type parameters are in its parameters' types and in
// its list of them.
fn clone_instance(n: *Node) -> *Node {
    let copies: Map(*Node, *Node);
    let copy = clone_tree(n, &copies);
    // a template naming itself (recursion, `next: *Node(T)`) still means
    // the template, which instantiates for whatever types that use has
    map_remove(&copies, n);
    remap(copy, &copies);
    map_free(&copies);
    return copy;
}

#scope_file

// ---- the C++ compiler's dump

fn binary_tag(op: BinaryOp) -> string {
    return switch (op) {
    case .Add: "ADD";       case .Sub: "SUB";       case .Mul: "MUL";
    case .Div: "DIV";       case .Mod: "MOD";
    case .Lt: "LT";         case .Gt: "GT";         case .LtEq: "LT_EQ";
    case .GtEq: "GT_EQ";    case .EqEq: "EQ_EQ";    case .NotEq: "NOT_EQ";
    case .And: "BOOL_AND";  case .Or: "BOOL_OR";
    case .BitOr: "BIT_OR";  case .BitAnd: "BIT_AND"; case .BitXor: "BIT_XOR";
    case .Shl: "SHL";       case .Shr: "SHR";
    };
}

fn unary_tag(op: UnaryOp) -> string {
    return switch (op) {
    case .Not: "BOOL_NOT";
    case .Neg: "NEG";
    case .BitNot: "BIT_NOT";
    case .AddressOf: "ADDRESS_OF";
    case .PointerType: "STAR";
    };
}

fn dump_into(out: *[..]u8, n: *Node, indent: isize, label: string) {
    for (i in 0..indent * 2)
        array_add(out, ' ');
    if (label.len > 0)
        print_to(out, "%: ", label);
    if (n == null) {
        append_string(out, "(none)\n");
        return;
    }
    let s = old_shape(n);
    append_string(out, s.tag);
    // keyword and `{` tokens repeat the tag, so only the others show;
    // `true` and `false` are the value, so they show
    let keyword = (n.tok.kind as u8) >= (TokenKind.Fn as u8) && n.kind.tag != .Bool;
    let quoted = "";
    if (n.kind is .String{quoted: q})
        quoted = q;
    if (quoted.len > 0)
        print_to(out, " %", quoted);
    else if (n.tok.text.len > 0 && !keyword && n.tok.kind != .LBrace)
        print_to(out, " `%`", n.tok.text);
    if (n.caller) append_string(out, " [caller]");
    if (n.color != 0) print_to(out, " [macro %]", n.color);
    if (n.kind is .MacroExpansion{expansion}) print_to(out, " [expansion %]", expansion);
    // C's calling convention: a C function or variable (`#foreign`, and
    // its library), or one of ours C calls (`#c_call`)
    if (s.is_extern && s.foreign != null) {
        let module = if (s.foreign.kind is .Member{object}) tformat("%.", object.tok.text) else "";
        print_to(out, " [foreign %{}%]", module, s.foreign.tok.text);
    } else if (s.is_extern) {
        append_string(out, if (n.kind.tag == .Fn && s.rhs != null) " [c_call]" else " [foreign]");
    }
    if (s.link_name.len > 0) print_to(out, " [C name %]", s.link_name);
    if (n.kind is .Library{path}) print_to(out, " [% %]", s.library, path.text);
    if (s.uninit) append_string(out, " [uninit]");
    if (s.no_bounds_check) append_string(out, " [no_bounds_check]");
    if (s.nodiscard) append_string(out, " [nodiscard]");
    if (s.dropped) append_string(out, " [dropped]");
    if (s.variadic) append_string(out, " [variadic]");
    if (s.c_call) append_string(out, " [c_call]");
    if (s.packed) append_string(out, " [packed]");
    if (s.type_param) append_string(out, " [type param]");
    if (s.generic) append_string(out, " [generic]");
    if (n.decl != null)
        print_ref(out, n.decl);
    if (n.kind is .Import{module} && module != null)
        print_to(out, " -> module %", module.path);
    if (n.ty != null)
        print_to(out, " : %", type_name(n.ty));
    switch (n.cval.kind) {
    case .Int:   print_to(out, " = %", i128_to_string(n.cval.i));
    case .Float: print_to(out, " = %", format_g(n.cval.f));
    case .Bool:  append_string(out, if (n.cval.i.lo != 0) " = true" else " = false");
    case .None:
    }
    array_add(out, '\n');

    if (s.declared != null) dump_into(out, s.declared, indent + 1, "type");
    if (s.lhs != null) dump_into(out, s.lhs, indent + 1, "lhs");
    if (s.rhs != null) dump_into(out, s.rhs, indent + 1, "rhs");
    if (s.extra != null) dump_into(out, s.extra, indent + 1, "extra");
    for (child in s.list)
        dump_into(out, child, indent + 1, "");
    for (param in s.type_params)
        dump_into(out, param, indent + 1, "type_param");
}

// " -> VAR_DECL `x` 3:9", with the file for a top-level declaration
fn print_ref(out: *[..]u8, d: *Node) {
    if (d.kind.tag == .BuiltinType) {
        append_string(out, " -> builtin");
        return;
    }
    print_to(out, " -> % `%` ", old_shape(d).tag, d.tok.text);
    if (d.owner != null) {
        // the module's own file, a file it #loads, or code it #inserted
        let file: *Module = if (holds(d.owner, d.tok)) d.owner else null;
        for (f in d.owner.files)
            if (holds(f, d.tok))
                file = f;
        append_string(out, if (file != null) file.path else d.owner.path);
        append_string(out, if (file != null) ":" else " #insert:");
    }
    print_to(out, "%:%", d.tok.line, d.tok.column);
}

// ---- walking and copying trees
//
// A node's children are the *Node and []*Node parts of its kind, found
// through NodeKind's type information, so a new kind needs nothing here.

// the type of `n`'s variant's parts, and where they are
fn parts(n: *Node) -> (*TypeInfo, *u8) {
    let info = type_info(NodeKind);
    let tag = n.kind.tag as i64;
    for (v in info.variants)
        if (v.value == tag)
            return v.payload, (&n.kind as *u8) + info.fields[1].offset;
    return null, null;
}

// is `t` in `f`'s text?
fn holds(f: *Module, t: Token) -> bool {
    let text = f.src.text;
    return t.text.ptr >= text.ptr && t.text.ptr <= text.ptr + text.len;
}

fn snprintf(buffer: *u8, size: usize, format: *u8, ...) -> i32 #foreign libc;

fn clone_tree(n: *Node, copies: *Map(*Node, *Node)) -> *Node {
    if (n == null)
        return null;
    let done = map_get(copies, n) or_else null;
    if (done != null)
        return done;
    let copy = new(n.*);
    map_put(copies, n, copy);
    let info, at = parts(copy);
    if (info == null)
        return copy;
    let node_ptr, node_list = type_info(*Node), type_info([]*Node);
    for (f in info.fields) {
        if (f.info == node_ptr) {
            let slot = (at + f.offset) as **Node;
            slot.* = clone_tree(slot.*, copies);
        } else if (f.info == node_list) {
            let slot = (at + f.offset) as *[]*Node;
            let items = new([]*Node, slot.len);
            for (i in 0..items.len)
                items[i] = clone_tree(slot.*[i], copies);
            slot.* = items;
        }
    }
    return copy;
}

fn remap(n: *Node, copies: *Map(*Node, *Node)) {
    if (n == null)
        return;
    if (n.decl != null) {
        let copy = map_get(copies, n.decl) or_else null;
        if (copy != null)
            n.decl = copy;
    }
    let info, at = parts(n);
    if (info == null)
        return;
    let node_ptr, node_list = type_info(*Node), type_info([]*Node);
    for (f in info.fields) {
        if (f.info == node_ptr) {
            remap(((at + f.offset) as **Node).*, copies);
        } else if (f.info == node_list) {
            for (item in ((at + f.offset) as *[]*Node).*)
                remap(item, copies);
        }
    }
}
