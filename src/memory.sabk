// Memory that escapes a function (errors), and the memory traps a
// function's own code shows (warnings); see "Memory traps" in
// docs/reference.md and Sabk-memory-traps.md.

import "std/array";
import "std/fmt";
import "std/map";
import "std/str";
import "ast";
import "resolve";
import "types";
import "check";
import "generics";

/* ---------------------------------------------------- memory that escapes */

// Finds values that point into a function's own memory (slice literals,
// &local, slices of local arrays, copies made for Any, and locals holding
// them) where they'd outlive it: returned, stored in a global, or stored
// through a pointer or slice parameter. Conservative: it doesn't follow
// every path, and passing such values to other functions is fine.
struct Escapes {
    c: *Checker;
    fun: *Node;
    held: Map(*Node, *Node); // a local -> what it points into
    changed: bool;
}

pub fn check_escapes(c: *Checker, fun: *Node) {
    let e = Escapes.{ .c = c, .fun = fun };
    let body = fn_body(fun);
    e.changed = true;
    while (e.changed) {
        e.changed = false;
        find_held(&e, body);
    }
    find_escapes(&e, body);
    map_free(&e.held);
}

fn is_local(d: *Node) -> bool {
    if (d == null)
        return false;
    switch (d.kind.tag) {
    case .Let, .Const, .Binding: return d.owner == null;
    case .Param, .ForIn, .LoopIndex: return true;
    default: return false;
    }
}

// the variable `n` is part of, through values but not pointers: x, x.f,
// x[i] of an array
fn root(n: *Node) -> *Node {
    switch (n.kind) {
    case .Grouped{inner}:
        return root(inner);
    case .Identifier:
        return n.decl;
    case .Member{object}:
        if (n.decl != null) // a module's global
            return n.decl;
        if (object.ty != null && object.ty.kind == .Ptr)
            return null;
        return root(object);
    case .Index{object}:
        if (object.ty != null && object.ty.kind == .Array)
            return root(object);
        return null;
    case .VariantAccess{object}:
        if (object.ty != null && object.ty.kind == .Ptr)
            return null;
        return root(object);
    default:
        return null;
    }
}

// the parameter whose memory a store through `n` lands in: p.x, *p,
// xs[i], with p and xs parameters
fn param_target(n: *Node) -> *Node {
    switch (n.kind) {
    case .Grouped{inner}:
        return param_target(inner);
    case .Deref{pointer}:
        return pointer_param(pointer);
    case .Member{object}:
        if (n.decl != null)
            return null;
        if (object.ty != null && object.ty.kind == .Ptr)
            return pointer_param(object);
        return param_target(object);
    case .Index{object}:
        if (object.ty != null && (object.ty.kind == .Slice || object.ty.kind == .Growable || object.ty.kind == .Ptr))
            return pointer_param(object);
        return param_target(object);
    case .VariantAccess{object}:
        if (object.ty != null && object.ty.kind == .Ptr)
            return pointer_param(object);
        return param_target(object);
    default:
        return null;
    }
}

fn pointer_param(n: *Node) -> *Node {
    let e = ungroup(n);
    if (e.kind.tag == .Identifier && e.decl != null && e.decl.kind.tag == .Param)
        return e.decl;
    return null;
}

// the one part of a node an escape is followed through: an operand, a
// variant's value
fn first_part(n: *Node) -> *Node { return old_shape(n).lhs; }

// does `e` point into this function's memory? what it points into
fn into_frame(x: *Escapes, e: *Node) -> *Node {
    if (e == null || e.ty == null)
        return null;
    if (e.conv != null && e.conv == x.c.any_type)
        return e; // a pointer to a copy made right here
    if (e.conv != null && e.conv.kind == .Slice && e.ty.kind == .Array)
        // an array used as a slice: a view of a local one, or of the copy
        // of a temporary made right here
        return if (!is_place(e) || is_local(root(e))) e else null;
    switch (e.kind) {
    case .Unary{op: .AddressOf, operand}:
        return if (is_local(root(operand))) e else null;
    case .Slice{object}:
        let t = object.ty;
        if (t != null && t.kind == .Array)
            return if (is_local(root(object))) e else null;
        return into_frame(x, object); // a part of a slice that's here
    case .ArrayLiteral, .StructInit, .Values: // return a, b;
        let items = items_of(e);
        if (e.ty.kind == .Slice && items.len > 0)
            return e;
        for (item in items) {
            let found = into_frame(x, item_value(item));
            if (found != null)
                return found;
        }
        return null;
    case .FieldInit{value}:
        return into_frame(x, value);
    case .VariantValue, .Grouped, .Cast:
        return into_frame(x, first_part(e));
    case .Binary{op, lhs, rhs}: // p + n points where p does
        if ((op != .Add && op != .Sub) || e.ty.kind != .Ptr)
            return null;
        return into_frame(x, if (lhs.ty != null && lhs.ty.kind == .Ptr) lhs else rhs);
    case .Identifier:
        return map_get(&x.held, e.decl) or_else null;
    case .Member{object}: // a field of a value that holds one
        if (e.decl != null || object.ty == null)
            return null;
        if (e.tok.text == "ptr" && object.ty.kind == .Array)
            return if (is_local(root(object))) e else null; // a.ptr is &a[0]
        if (e.tok.text == "ptr" && object.ty.kind == .Ptr && object.ty.elem.kind == .Array)
            return into_frame(x, object); // p.ptr: where p points
        if (object.ty.kind == .Ptr)
            return null;
        return into_frame(x, object);
    default:
        return null;
    }
}

fn hold(x: *Escapes, target: *Node, value: *Node) {
    let r = root(target);
    if (!is_local(r) || map_has(&x.held, r))
        return;
    let found = into_frame(x, value);
    if (found != null) {
        map_put(&x.held, r, found);
        x.changed = true;
    }
}

// the targets and values of `a, b = x, y` (but `_`), or of a plain `x = y`
fn each_assignment(n: *Node) -> ([..]*Node, [..]*Node) {
    let targets: [..]*Node;
    let values: [..]*Node;
    targets.allocator = context.temp_allocator;
    values.allocator = context.temp_allocator;
    if (n.kind is .Assign{target, value}) {
        if (target.kind is .Values{items: ts} && value.kind is .Values{items: vs}) {
            for (i in 0..ts.len) {
                if (is_discard(ts[i]))
                    continue;
                array_add(&targets, ts[i]);
                array_add(&values, vs[i]);
            }
        } else if (n.tok.text == "=" && target.kind.tag != .Values) {
            array_add(&targets, target);
            array_add(&values, value);
        }
    }
    return targets, values;
}

// which locals hold such values, until nothing changes
fn find_held(x: *Escapes, n: *Node) {
    if (n == null)
        return;
    switch (n.kind) {
    case .StaticIf:
        find_held(x, static_if_branch(n));
        return;
    case .Let{value}:
        held_by_decl(x, n, value);
    case .Const{value}:
        held_by_decl(x, n, value);
    case .Assign:
        let targets, values = each_assignment(n);
        for (i in 0..targets.len)
            hold(x, targets[i], values[i]);
    default:
    }
    for (child in code_children(n))
        find_held(x, child);
}

fn held_by_decl(x: *Escapes, d: *Node, value: *Node) {
    if (value == null || d.owner != null || map_has(&x.held, d))
        return;
    let found = into_frame(x, value);
    if (found != null) {
        map_put(&x.held, d, found);
        x.changed = true;
    }
}

// the local a node is about: `a` in a, a.f, a[i]
fn local_name(n: *Node) -> string {
    let r = root(n);
    return if (r != null) tformat("`%`", r.tok.text) else "this local";
}

// what `origin` is, how long it lives, and how to keep it
fn explain_escape(x: *Escapes, origin: *Node, name: string) -> string {
    let until = tformat(" until % returns", name);
    if (origin.conv != null && origin.conv == x.c.any_type)
        return tformat("the copy of this value made for an `Any` only lives%", until);
    if (origin.conv != null && origin.conv.kind == .Slice && origin.ty.kind == .Array) {
        if (!is_place(origin))
            return tformat("this array, used as a slice, is a copy that only lives%; to keep its elements, allocate a copy: `clone_slice(...)` (std/mem)",
                           until);
        let what = if (ungroup(origin).kind.tag == .Identifier)
                       tformat("% is a local array, used as a slice here, which", local_name(origin))
                   else tformat("this array is part of the local %, which", local_name(origin));
        return tformat("% only lives%; to keep its elements, copy them: `clone_slice(...)` (std/mem)", what, until);
    }
    switch (origin.kind) {
    case .Unary{operand}:
        return tformat("% is a local, which only lives%; to keep the value, allocate it: `new(T)` or `new(value)`",
                       local_name(operand), until);
    case .Slice{object}:
        return tformat("% is a local array, which only lives%; to keep its elements, copy them: `clone_slice(...)` (std/mem)",
                       local_name(object), until);
    case .Member{object}: // a.ptr
        return tformat("% is a local array, which only lives%; to keep its elements, copy them: `clone_slice(...)` (std/mem)",
                       local_name(object), until);
    default:
        return tformat("this slice literal's elements only live%; to keep them, allocate a copy: `clone_slice(...)` (std/mem)",
                       until);
    }
}

// "this returns memory that's gone once `f` returns", "... stores ...
// into the global `g`"
fn report_escape(x: *Escapes, at: *Node, origin: *Node, action: string, place: string) {
    let name = tformat("`%`", x.fun.tok.text);
    error(x.c, at.tok, tformat("this % memory that's gone once % returns%", action, name, place));
    note(x.c, origin.tok, explain_escape(x, origin, name));
}

// `value` is assigned to `target`: does it outlive this function?
fn stored_escape(x: *Escapes, target: *Node, value: *Node) {
    let origin = into_frame(x, value);
    if (origin == null)
        return;
    let r = root(target);
    if (r != null && r.owner != null) {
        report_escape(x, value, origin, "stores", tformat(" into the global `%`", r.tok.text));
        return;
    }
    let p = param_target(target);
    if (p != null)
        report_escape(x, value, origin, "stores",
                      tformat(" into what the parameter `%` points at, which outlives it", p.tok.text));
}

fn find_escapes(x: *Escapes, n: *Node) {
    if (n == null)
        return;
    switch (n.kind) {
    case .StaticIf:
        find_escapes(x, static_if_branch(n));
        return;
    case .Return{value}:
        if (n.decl == null && value != null) { // the function's own return, not a macro's
            let origin = into_frame(x, value);
            if (origin != null)
                report_escape(x, value, origin, "returns", "");
        }
    case .Assign:
        let targets, values = each_assignment(n);
        for (i in 0..targets.len)
            stored_escape(x, targets[i], values[i]);
    default:
    }
    for (child in code_children(n))
        find_escapes(x, child);
}

/* ------------------------------------------------------------ memory traps */

// Warnings for the memory traps (Sabk-memory-traps.md) that a function's
// own code shows:
//   1-5  memory that dies with a block, a loop's pass or the function,
//        kept where it outlives that: stored in an outer variable, or
//        given to a call along with a pointer to outer memory that can
//        hold it (array_add(&pairs, .[i, i]))
//   8    a [..]T copied, then one copy grown while the other is used
//   9    a write to a local that only ever holds a string literal
//   12   a [..]T handed to a call while a loop reads it
//   13   a by-value [..]T parameter handed to a call that can grow it
// Like Escapes it's conservative: what it can't see, it lets through.
// Stores that outlive the function are Escapes' errors, not warnings here.

const UNKNOWN: i32 = 0x7fffffff; // never outlives anything

// memory that's gone, or written again, once its scope ends
struct Short {
    origin: *Node; // a slice literal, &a, a[..], a copy for Any
    scope: i32;
}

struct Loop {
    key: string;
    loop: *Node;
}

// trap 8: `let ys = xs;`, and when each name is grown or used after
struct Copy {
    at: *Node;
    a: *Node;
    b: *Node;
    when: i32;
}

struct Grow {
    when: i32;
    arg: *Node; // `&x`
}

struct LiteralWrite {
    local: *Node;
    write: *Node;
}

struct Traps {
    c: *Checker;
    fun: *Node;
    // the blocks around the walk, the body first; a loop's body is one
    // even without braces, since each pass ends what it made
    loop_scopes: [..]bool;
    scope_of: Map(*Node, i32);       // a local -> the scope it's declared in
    held: Map(*Node, Short);         // a local -> the short-lived memory it holds
    looping: [..]Loop;               // the [..]Ts that `for` loops around here read
    order: i32;
    copies: [..]Copy;
    grown: Map(*Node, [..]Grow);     // a local -> &x calls
    used: Map(*Node, [..]i32);       // a local -> its mentions
    // trap 9: locals holding a string literal, and the writes to them
    literal_only: Map(*Node, bool);
    literal_writes: [..]LiteralWrite;
}

pub fn check_traps(c: *Checker, fun: *Node) {
    let t = Traps.{ .c = c, .fun = fun };
    push(&t, false);
    for (s in block_list(fn_body(fun)))
        visit(&t, s);
    report_copies(&t);
    report_literal_writes(&t);
}

fn current(t: *Traps) -> i32 { return (t.loop_scopes.len - 1) as i32; }

fn innermost_loop(t: *Traps) -> i32 {
    let i = current(t);
    while (i > 0) {
        if (t.loop_scopes[i])
            return i;
        i--;
    }
    return 0;
}

fn push(t: *Traps, loop: bool) { array_add(&t.loop_scopes, loop); }

fn pop(t: *Traps) {
    let gone = current(t);
    t.loop_scopes.len--;
    let ended: [..]*Node;
    ended.allocator = context.temp_allocator;
    for (e in t.held.entries)
        if (e.value.scope >= gone)
            array_add(&ended, e.key);
    for (k in ended)
        map_remove(&t.held, k);
}

fn bare(n: *Node) -> *Node {
    let e = n;
    while (e != null) {
        if (e.kind is .Grouped{inner})
            e = inner;
        else if (e.kind is .Cast{value})
            e = value;
        else
            break;
    }
    return e;
}

// where a variable lives: -1 for parameters and globals, which outlive
// the function
fn decl_scope(t: *Traps, d: *Node) -> i32 {
    if (d == null)
        return UNKNOWN;
    if (d.kind.tag == .Param || d.owner != null)
        return -1;
    return map_get(&t.scope_of, d) or_else UNKNOWN;
}

fn of_local(t: *Traps, e: *Node, r: *Node) -> Short {
    let none: Short;
    if (r == null || r.owner != null || !is_local(r))
        return none;
    if (r.kind.tag == .Param)
        return .{ .origin = e, .scope = 0 };
    let scope, found = map_get(&t.scope_of, r);
    if (!found)
        return none;
    return .{ .origin = e, .scope = scope };
}

// a constant or a literal: the same whenever it's read
fn is_fixed(n: *Node) -> bool {
    if (n.cval.kind != .None)
        return true;
    switch (n.kind.tag) {
    case .String, .Null, .TypeInfo, .SizeOf: return true;
    default: return false;
    }
}

fn short_of(t: *Traps, e: *Node) -> Short {
    let none: Short;
    if (e == null || e.ty == null)
        return none;
    if (e.conv != null && e.conv == t.c.any_type)
        return .{ .origin = e, .scope = current(t) }; // a copy made here, for this block
    if (e.conv != null && e.conv.kind == .Slice && e.ty.kind == .Array) {
        if (is_place(e))
            return of_local(t, e, root(e));
        return .{ .origin = e, .scope = current(t) };
    }
    switch (e.kind) {
    case .Unary{op: .AddressOf, operand}:
        return of_local(t, e, root(operand));
    case .Slice{object}:
        if (object.ty != null && object.ty.kind == .Array)
            return of_local(t, e, root(object));
        return short_of(t, object);
    case .ArrayLiteral{items}:
        if (e.ty.kind != .Slice || items.len == 0)
            return none;
        // one array per literal, filled each time it's reached: in a loop,
        // values that change each pass overwrite the last pass's
        let changes = false;
        for (item in items)
            changes = changes || !is_fixed(item);
        return .{ .origin = e, .scope = if (changes) innermost_loop(t) else 0 };
    case .StructInit{items}:
        for (item in items) {
            let s = short_of(t, item_value(item));
            if (s.origin != null)
                return s;
        }
        return none;
    case .Grouped, .Cast, .VariantValue:
        return short_of(t, first_part(e));
    case .Identifier:
        return map_get(&t.held, e.decl) or_else none;
    case .Member{object}:
        if (e.decl == null && e.tok.text == "ptr" && object.ty != null && object.ty.kind == .Array)
            return of_local(t, e, root(object)); // a.ptr is &a[0]
        return none;
    default:
        return none;
    }
}

// the variable a pointer or view in `n` is kept in: p in p.*, p.x, p[i]
fn pointer_base(n: *Node) -> *Node {
    let e = bare(n);
    switch (e.kind) {
    case .Identifier: return e.decl;
    case .Deref{pointer}: return pointer_base(pointer);
    case .Member{object}: return if (e.decl != null) null else pointer_base(object);
    case .Index{object}: return pointer_base(object);
    case .VariantAccess{object}: return pointer_base(object);
    default: return null;
    }
}

// how long the memory a store to `place` lands in lives
fn place_scope(t: *Traps, place: *Node) -> i32 {
    let r = root(place);
    if (r != null)
        return decl_scope(t, r);
    return decl_scope(t, pointer_base(place));
}

// can memory of type `t` keep a value of type `v`, without following
// pointers? (a [..][]i64 keeps a []i64; a [..]i64 copies its elements)
fn keeps(t: *Type, v: *Type, seen: *Map(*Type, bool)) -> bool {
    if (t == v)
        return true;
    if (map_has(seen, t))
        return false;
    map_put(seen, t, true);
    switch (t.kind) {
    case .Array, .Slice, .Growable:
        return !t.is_string && keeps(t.elem, v, seen);
    case .Struct, .Union:
        for (f in t.fields)
            if (keeps(f.ty, v, seen))
                return true;
        return false;
    default:
        return false;
    }
}

fn name_of(origin: *Node) -> string {
    let r: *Node = null;
    switch (origin.kind) {
    case .Unary{operand}: r = root(operand);
    case .Slice{object}: r = root(object);
    case .Member{object}: r = root(object);
    default: r = root(origin);
    }
    return if (r != null) tformat("`%`", r.tok.text) else "this array";
}

// what the short-lived memory is, and how to keep it instead
fn explain(t: *Traps, s: Short) -> string {
    let o = s.origin;
    let pass = s.scope > 0 && t.loop_scopes[s.scope];
    let until = if (s.scope == 0) tformat(" until `%` returns", t.fun.tok.text)
                else if (pass) " for one pass of the loop"
                else " until the end of its block";
    if (o.conv != null && o.conv == t.c.any_type)
        return tformat("the copy made for this `Any` only lives%", until);
    if (o.kind.tag == .ArrayLiteral) {
        if (s.scope > 0)
            return "this slice literal's elements are written again on every pass of the loop, so each slice kept from it shows the last pass's values; keep a copy: `clone_slice(...)` (std/mem)";
        return tformat("this slice literal's elements only live%; keep a copy: `clone_slice(...)` (std/mem)", until);
    }
    if (o.kind is .Unary{op: .AddressOf})
        return tformat("% only lives%; to keep the value, allocate it: `new(value)`", name_of(o), until);
    if (o.conv != null && !is_place(o))
        return tformat("this array, used as a slice, is a copy that only lives%; keep a copy: `clone_slice(...)` (std/mem)",
                       until);
    return tformat("% is a local array, which only lives%; keep a copy of its elements: `clone_slice(...)` (std/mem)",
                   name_of(o), until);
}

// `value` is assigned to `place`
fn stored(t: *Traps, place: *Node, value: *Node) {
    let s = short_of(t, value);
    if (s.origin == null)
        return;
    let target = place_scope(t, place);
    if (target == UNKNOWN || target >= s.scope) {
        let r = root(place);
        if (r != null && is_local(r) && r.owner == null)
            map_put(&t.held, r, s); // the local holds it now
        return;
    }
    if (s.scope == 0)
        return; // outlives the function: Escapes reports it
    let r = root(place);
    let b = if (r != null) r else pointer_base(place);
    let where = if (b != null) tformat("`%`", b.tok.text) else "memory";
    warning(t.c, value.tok, tformat("this is kept in %, which outlives it: %", where, explain(t, s)));
    made_here(t, value, s);
}

// a variable that holds the memory: where it was made
fn made_here(t: *Traps, value: *Node, s: Short) {
    if (bare(value) != s.origin)
        note(t.c, s.origin.tok, "it's made here");
}

fn traps_callee_name(call: *Node) -> string {
    let callee: *Node = null;
    if (call.kind is .Call{callee: e})
        callee = bare(e);
    if (callee != null && (callee.kind.tag == .Identifier || callee.kind.tag == .Member))
        return tformat("`%`", callee.tok.text);
    return "this call";
}

fn type_of(n: *Node) -> *Type { return if (n.conv != null) n.conv else n.ty; }

fn is_pack(t: *Traps, arg: *Node) -> bool { return map_has(&t.c.packs, arg); }

// how long what the pointer `p` points at lives
fn pointee_scope(t: *Traps, p: *Node) -> i32 {
    let e = bare(p);
    if (e.kind is .Unary{op: .AddressOf, operand})
        return place_scope(t, operand);
    return place_scope(t, e);
}

// traps 2, 4 and 5: a call that gets short-lived memory and a pointer to
// longer-lived memory that can hold it may keep it there
fn kept_by_call(t: *Traps, call: *Node) {
    let args = items_of(call);
    for (a in args) {
        if (is_pack(t, a))
            continue;
        let s = short_of(t, a);
        if (s.origin == null)
            continue;
        for (p in args) {
            if (p == a || is_pack(t, p) || p.ty == null || type_of(p).kind != .Ptr)
                continue;
            let seen: Map(*Type, bool);
            let can_keep = keeps(type_of(p).elem, type_of(a), &seen);
            map_free(&seen);
            if (!can_keep)
                continue;
            let target = pointee_scope(t, p);
            let lives_longer = if (s.scope > 0) target < s.scope else target < 0;
            if (target == UNKNOWN || !lives_longer)
                continue;
            let b = pointer_base(p);
            if (bare(p).kind is .Unary{op: .AddressOf, operand})
                b = pointer_base(operand);
            let where = if (b != null) tformat("`%`", b.tok.text) else "what it's given";
            warning(t.c, a.tok, tformat("% may keep this in %, which outlives it: %", traps_callee_name(call),
                                        where, explain(t, s)));
            made_here(t, a, s);
            break;
        }
    }
}

// a place as a string, to tell two mentions of it apart: `xs`, `s.items`,
// `p.*`
fn place_key(n: *Node) -> string {
    let e = bare(n);
    switch (e.kind) {
    case .Identifier:
        return if (e.decl != null) tformat("%", e.decl as usize) else "";
    case .Deref{pointer}:
        let k = place_key(pointer);
        return if (k.len == 0) "" else tformat("%.*", k);
    case .Member{object}:
        if (e.decl != null)
            return tformat("%", e.decl as usize);
        let k = place_key(object);
        if (k.len == 0)
            return "";
        if (object.ty != null && object.ty.kind == .Ptr)
            k = tformat("%.*", k);
        return tformat("%.%", k, e.tok.text);
    default:
        return "";
    }
}

// the [..]T a pointer argument points at, as a place_key
fn pointee_key(p: *Node) -> string {
    let e = bare(p);
    if (e.kind is .Unary{op: .AddressOf, operand})
        return place_key(operand);
    let k = place_key(e);
    return if (k.len == 0) "" else tformat("%.*", k);
}

// memory of its own, by value
fn owns(t: *Type) -> bool {
    if (t.kind == .Growable)
        return true;
    if (t.kind == .Array)
        return owns(t.elem);
    if (t.kind == .Struct && !t.is_tuple)
        for (f in t.fields)
            if (owns(f.ty))
                return true;
    return false;
}

fn grows(t: *Traps, call: *Node) {
    for (a in items_of(call)) {
        if (is_pack(t, a) || a.ty == null || type_of(a).kind != .Ptr)
            continue;
        let target = type_of(a).elem;
        if (target.kind != .Growable && !owns(target))
            continue;
        let arg = bare(a);
        // trap 12: the array a loop around here reads
        if (target.kind == .Growable) {
            let key = pointee_key(arg);
            for (l in t.looping) {
                if (key.len > 0 && l.key == key) {
                    warning(t.c, a.tok, tformat("% gets the array the loop around it reads: if it grows or frees it, the loop goes on reading the old elements; collect the changes, and make them after the loop",
                                                traps_callee_name(call)));
                    note(t.c, l.loop.tok, "the loop");
                    break;
                }
            }
        }
        let operand: *Node = null;
        if (arg.kind is .Unary{op: .AddressOf, operand: o})
            operand = o;
        if (operand == null)
            continue;
        let r = root(operand);
        // trap 13: a by-value parameter's copy of the caller's array
        if (r != null && r.kind.tag == .Param && target.kind == .Growable)
            warning(t.c, a.tok, tformat("`%` is a copy of the caller's %, sharing its elements: if % grows or frees it, the caller's points at freed memory; to change the caller's, take `%`",
                                        r.tok.text, if (r.ty == target) qt(target) else "value",
                                        traps_callee_name(call), type_name(ptr_to(&t.c.types, r.ty))));
        if (r != null && operand.kind.tag == .Identifier) {
            let list = map_find(&t.grown, r);
            if (list == null) {
                let none: [..]Grow;
                map_put(&t.grown, r, none);
                list = map_find(&t.grown, r);
            }
            array_add(list, Grow.{ .when = t.order, .arg = a });
        }
    }
}

fn mark_used(t: *Traps, d: *Node) {
    let list = map_find(&t.used, d);
    if (list == null) {
        let none: [..]i32;
        map_put(&t.used, d, none);
        list = map_find(&t.used, d);
    }
    array_add(list, t.order);
}

fn visit_children(t: *Traps, n: *Node) {
    for (child in code_children(n))
        visit(t, child);
}

fn visit(t: *Traps, n: *Node) {
    if (n == null)
        return;
    t.order++;
    switch (n.kind) {
    case .StaticIf:
        visit(t, static_if_branch(n));
    case .Fn:
    case .Block{stmts}:
        push(t, false);
        for (s in stmts)
            visit(t, s);
        pop(t);
    case .MacroExpansion{stmts}:
        push(t, false);
        for (s in stmts)
            visit(t, s);
        pop(t);
    case .While{cond, body}:
        visit(t, cond);
        push(t, true);
        visit(t, body);
        pop(t);
    case .DoWhile{body, cond}:
        visit(t, cond);
        push(t, true);
        visit(t, body);
        pop(t);
    case .For(f): // for (init; cond; step): init's names live past a pass
        push(t, false);
        visit(t, f.init);
        push(t, true);
        visit(t, f.cond);
        visit(t, f.step);
        visit(t, f.body);
        pop(t);
        pop(t);
    case .ForIn{iterable, range_end, body}:
        visit(t, iterable);
        visit(t, range_end);
        push(t, true);
        map_put(&t.scope_of, n, current(t));
        let subject = bare(iterable);
        if (subject != null && subject.kind is .Slice{object})
            subject = bare(object);
        let reads = subject != null && subject.ty != null && subject.ty.kind == .Growable &&
                    place_key(subject).len > 0;
        if (reads)
            array_add(&t.looping, Loop.{ .key = place_key(subject), .loop = n });
        visit(t, body);
        if (reads)
            t.looping.len--;
        pop(t);
    case .Let{value}:
        visit_decl(t, n, value);
    case .Binding:
        visit_decl(t, n, null);
    case .Assign{target, value}:
        visit_assign(t, n, target, value);
    case .Unary{op: .AddressOf, operand}:
        let target = bare(operand);
        if (target.kind.tag == .Identifier && map_has(&t.literal_only, target.decl))
            map_put(&t.literal_only, target.decl, false); // may be set through the pointer
        visit_children(t, n);
    case .Identifier:
        if (n.decl != null)
            mark_used(t, n.decl);
    case .Call{callee, args}:
        visit(t, callee);
        for (a in args)
            visit(t, a);
        kept_by_call(t, n);
        grows(t, n);
    default:
        visit_children(t, n);
    }
}

fn visit_decl(t: *Traps, n: *Node, value: *Node) {
    visit(t, value);
    if (n.owner != null)
        return;
    map_put(&t.scope_of, n, current(t));
    if (value == null)
        return;
    let s = short_of(t, value);
    if (s.origin != null)
        map_put(&t.held, n, s);
    let v = bare(value);
    if (v.kind.tag == .String && (n.ty.is_string || n.ty == slice_of(&t.c.types, t.c.types.u8)))
        map_put(&t.literal_only, n, true);
    if (v.kind.tag == .Identifier && v.decl != null && owns(n.ty) && is_local(v.decl))
        array_add(&t.copies, Copy.{ .at = n, .a = n, .b = v.decl, .when = t.order });
}

fn visit_assign(t: *Traps, n: *Node, lhs: *Node, rhs: *Node) {
    visit(t, rhs);
    visit(t, lhs);
    let plain = n.tok.text == "=";
    let target = bare(lhs);
    if (target.kind.tag == .Identifier && map_has(&t.literal_only, target.decl))
        map_put(&t.literal_only, target.decl, false); // it holds something else too
    if (target.kind is .Index{object}) {
        let base = bare(object);
        if (base.kind.tag == .Identifier && map_has(&t.literal_only, base.decl))
            array_add(&t.literal_writes, LiteralWrite.{ .local = base.decl, .write = n });
    }
    if (!plain)
        return;
    if (lhs.kind is .Values{items: targets} && rhs.kind is .Values{items: values}) {
        for (i in 0..targets.len)
            if (!is_discard(targets[i]))
                stored(t, targets[i], values[i]);
        return;
    }
    if (lhs.kind.tag == .Values)
        return;
    stored(t, lhs, rhs);
    let value = bare(rhs);
    if (target.kind.tag == .Identifier && value.kind.tag == .Identifier && target.decl != null &&
        value.decl != null && owns(target.ty) && is_local(target.decl) && is_local(value.decl))
        array_add(&t.copies, Copy.{ .at = n, .a = target.decl, .b = value.decl, .when = t.order });
}

// the first growing of `grown_one` after `when`, and when it is
fn grown_after(t: *Traps, grown_one: *Node, when: i32) -> (*Node, i32) {
    let list = map_find(&t.grown, grown_one);
    if (list != null)
        for (g in list.*)
            if (g.when > when)
                return g.arg, g.when;
    return null, 0;
}

fn used_after(t: *Traps, d: *Node, when: i32) -> bool {
    let list = map_find(&t.used, d);
    if (list != null)
        for (at in list.*)
            if (at > when)
                return true;
    return false;
}

// trap 8: after `let ys = xs;`, growing one while the other's used
fn report_copies(t: *Traps) {
    for (copy in t.copies) {
        for (pair in .[.[copy.a, copy.b], .[copy.b, copy.a]]) {
            let grown_one, other = pair[0], pair[1];
            let grow, when = grown_after(t, grown_one, copy.when);
            if (grow == null || !used_after(t, other, when))
                continue;
            warning(t.c, copy.at.tok, tformat("`%` and `%` now share their elements: growing or freeing one leaves the other pointing at freed memory; copy them (`array_of(...)`), or pass a pointer",
                                              copy.a.tok.text, copy.b.tok.text));
            note(t.c, grow.tok, tformat("`%` can grow here, and `%` is used after", grown_one.tok.text, other.tok.text));
            break;
        }
    }
}

// trap 9
fn report_literal_writes(t: *Traps) {
    for (w in t.literal_writes)
        if (map_get(&t.literal_only, w.local) or_else false)
            warning(t.c, w.write.tok, tformat("`%` holds a string literal, whose bytes are read-only: this write crashes the program; to change the text, copy it first: `copy_string(...)` (std/str)",
                                              w.local.tok.text));
}
