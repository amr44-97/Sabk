// sabk: the Sabk compiler, written in Sabk. See print_usage() for what
// it does; docs/reference.md describes the language.

#import "std/array";
#import "std/build";
#import "std/c";
#import "std/fmt";
#import "std/fs";
#import "std/io";
#import "std/logging";
#import "std/os";
#import "std/path";
#import "std/process";
#import "std/str";
#import "std/time";
#import "ast";
#import "check";
#import "codegen";
#import "generics";
#import "lexer";
#import "module";
#import "parser";
#import "resolve";
#import "source";
#import "strict";
#import "token";
#import "types";
#import "vm";
#import "ir";
#import "backend_c";
#import "backend_qbe";

// the VM's way to C, and libffi
#run configure();

fn configure() {
    add_c_file("vm_ffi.c");
    link_library("ffi");
}

fn snprintf(buffer: *u8, size: usize, format: *u8, ...) -> i32 #foreign libc;

enum Mode { Build, Run, Interp, Ir, EmitC, Check, Tokens, Ast, Resolve, Types }

/* ------------------------------------------------------------------ stats */

// how long each phase took, in milliseconds: printed after every compile
// (unless --quiet), with the generic instances under --stats
struct Phase {
    name: string;
    ms: f64;
}

let show_stats = false;
let quiet = false;
let phase_times: [..]Phase;
let phase_start: i64 = 0;
let functions_total: isize = 0;
let functions_emitted: isize = 0;

fn end_phase(name: string) {
    let now = now_ns();
    array_add(&phase_times, Phase.{ .name = name, .ms = ((now - phase_start) as f64) / 1000000.0 });
    phase_start = now;
}

struct InstanceGroup {
    templ: *Node;
    list: [..]*Node;
}

fn print_stats(c: *Checker) {
    if (!quiet || show_stats) {
        let total = 0.0;
        eprint("phases:\n");
        for (p in phase_times) {
            eprint(tformat("  %{<26} %{8.1f} ms\n", p.name, p.ms));
            total += p.ms;
        }
        eprint(tformat("  %{<26} %{8.1f} ms\n", "total", total));
    }
    if (!show_stats)
        return;
    if (functions_total > 0)
        eprint(tformat("functions: % of % written out, the rest unused\n", functions_emitted, functions_total));
    if (c == null)
        return;
    // instances per generic function or struct, most first
    let groups: [..]InstanceGroup;
    for (instance in c.instances) {
        let found: *InstanceGroup = null;
        for (k in 0..groups.len)
            if (groups[k].templ == instance.generic)
                found = &groups[k];
        if (found == null) {
            found = array_add_new(&groups);
            found.templ = instance.generic;
        }
        array_add(&found.list, instance);
    }
    // most first, keeping the order of those with as many
    for (k in 1..groups.len) {
        let j = k;
        while (j > 0 && groups[j - 1].list.len < groups[j].list.len) {
            let swap = groups[j - 1];
            groups[j - 1] = groups[j];
            groups[j] = swap;
            j--;
        }
    }
    eprint(tformat("generic instances: %\n", c.instances.len));
    for (group in groups) {
        let line: [..]u8;
        print_to(&line, "  %{<26} %{3}:", group.templ.tok.text, group.list.len);
        for (k in 0..group.list.len) {
            if (k >= 6)
                break;
            append_string(&line, " (");
            let instance_args = group.list[k].instance_args;
            for (a in 0..instance_args.len) {
                if (a > 0)
                    append_string(&line, ", ");
                append_string(&line, type_name(instance_args[a]));
            }
            append_string(&line, ")");
        }
        if (group.list.len > 6)
            print_to(&line, " and % more", group.list.len - 6);
        array_add(&line, '\n');
        eprint(line as string);
    }
}

/* --------------------------------------------------------------- building */

// --release: an optimized build without debug info, keeping only the code
// that's used
let release = false;

// --sanitize: built with AddressSanitizer, which reports a use of freed
// memory (and of what the temp allocator and arenas took back) where it
// happens, at the Sabk line
let sanitize = false;

// Compiles C source into an executable with $CC (default: cc). The C goes
// in a directory of its own, so no file of the user's is ever overwritten;
// it's kept there if the C compiler fails.
fn compile_c(c_source: string, exe_path: string, build: *BuildOptions) -> bool {
    let dir, ok = build_dir();
    if (!ok)
        return false;
    let c_path = tformat("%/program.c", dir);
    if (!write_to(c_path, c_source))
        return false;
    phase_start = now_ns();
    if (!run_cc(.[c_path], exe_path, build, false))
        return false;
    end_phase("C compiler");
    clean_up(dir, .[c_path]);
    return true;
}

// --qbe: QBE's IL into assembly with QBE (vendor/qbe, built in build/qbe
// next to the compiler; $QBE names another), then that and the runtime's
// C into an executable with $CC
fn compile_qbe(il: string, runtime_c: string, exe_path: string, build: *BuildOptions, qbe: string) -> bool {
    let dir, ok = build_dir();
    if (!ok)
        return false;
    let il_path = tformat("%/program.ssa", dir);
    let asm_path = tformat("%/program.s", dir);
    let rt_path = tformat("%/runtime.c", dir);
    if (!write_to(il_path, il) || !write_to(rt_path, runtime_c))
        return false;
    phase_start = now_ns();
    let exit, failed = run_shell(tformat("% -o % %", shell_quote(qbe), shell_quote(asm_path), shell_quote(il_path)));
    if (failed != .None || exit.code != 0) {
        eprintln("[error]: QBE failed on % (QBE is %)", il_path, qbe);
        return false;
    }
    end_phase("QBE");
    if (!run_cc(.[asm_path, rt_path], exe_path, build, true))
        return false;
    end_phase("assemble and link");
    clean_up(dir, .[il_path, asm_path, rt_path]);
    return true;
}

fn build_dir() -> (string, bool) {
    let dir, err = make_temp_dir("sabk-build");
    if (err != .None) {
        eprintln("mkdtemp: %", system_error_text(err));
        return "", false;
    }
    return dir, true;
}

fn write_to(path: string, text: string) -> bool {
    let written = write_file(path, text);
    if (written != .None) {
        eprintln("%: %", path, system_error_text(written));
        return false;
    }
    return true;
}

fn clean_up(dir: string, files: []string) {
    for (f in files)
        _ = delete_file(f); // cleaning up: a failure here changes nothing
    _ = remove_dir(dir);
}

// $CC on `inputs` (C, or assembly with `no_pie`: QBE's addresses are
// absolute), with the build's flags, C files and libraries
fn run_cc(inputs: []string, exe_path: string, build: *BuildOptions, no_pie: bool) -> bool {
    let cc = get_env("CC") or_else "";
    if (cc.len == 0)
        cc = "cc";
    // -fwrapv: signed overflow wraps; -w: the generated code isn't the
    // user's to fix (-Wno-psabi: nor GCC's note on passing an #align(64)
    // struct, which -w leaves). A release build is optimized, and the linker drops
    // every function and piece of data nothing uses.
    let flags: [..]u8;
    append_string(&flags, if (release) "-O2 -ffunction-sections -fdata-sections -Wl,--gc-sections" else "-g");
    // and what build scripts asked for (std/build): their flags as written,
    // C files to compile along, libraries after everything that uses them
    if (sanitize)
        append_string(&flags, " -fsanitize=address -fno-omit-frame-pointer");
    if (no_pie)
        append_string(&flags, " -no-pie");
    for (extra in build.c_flags)
        print_to(&flags, " %", extra);
    let command: [..]u8;
    print_to(&command, "% -std=c11 -fwrapv -fno-strict-aliasing -w -Wno-psabi % -o %", cc, flags as string,
             shell_quote(exe_path));
    for (file in inputs)
        print_to(&command, " %", shell_quote(file));
    for (file in build.c_files)
        print_to(&command, " %", shell_quote(file));
    // libraries after what uses them, and system ones last, since a static
    // archive can need them. A shared object is linked by its name, so the
    // program looks for it where the loader looks, not here (as in Jai).
    for (file in build.library_files)
        print_to(&command, " %", shell_quote(file));
    for (dir in build.library_dirs)
        print_to(&command, " %", shell_quote(tformat("-L%", dir)));
    for (file in build.shared_libraries) {
        if (OS == .MacOS) // ld64 has no -l:file; a .dylib names itself (its install name)
            print_to(&command, " %", shell_quote(file));
        else
            print_to(&command, " % %", shell_quote(tformat("-L%", path_dir(file))),
                     shell_quote(tformat("-l:%", path_base(file))));
    }
    for (library in build.libraries)
        print_to(&command, " %", shell_quote(tformat("-l%", library)));
    let exit, failed = run_shell(command as string);
    if (failed != .None || exit.code != 0) {
        eprintln("[error]: the C compiler failed on %", inputs[0]);
        return false;
    }
    return true;
}

// the directories `--run` adds to the loader's: add_library_dir's and
// those of the shared `#library` files, then what the environment had
fn run_library_path(build: *BuildOptions) -> string {
    let dirs: [..]string;
    for (dir in build.library_dirs)
        array_add(&dirs, dir);
    for (file in build.shared_libraries)
        array_add(&dirs, path_dir(file));
    if (dirs.len == 0)
        return "";
    let had = get_env(if (OS == .MacOS) "DYLD_LIBRARY_PATH" else "LD_LIBRARY_PATH") or_else "";
    if (had.len > 0)
        array_add(&dirs, had);
    return join(dirs, ":");
}

/* ---------------------------------------------------------------- the CLI */

fn print_usage(exe: string) -> i32 {
    eprint(tformat("usage: % [options] <file> [-- args...]\n", exe));
    eprint("  (default)    build an executable named after <file>\n");
    eprint("  -o <path>    name the executable\n");
    eprint("  --run        build and run it, exiting with its exit code\n");
    eprint("  --interp     run it in the compiler's interpreter (#run's), with\n");
    eprint("               no C compiler: slower to run, nothing to build\n");
    eprint("  --release    build optimized, without debug info\n");
    eprint("  --sanitize   build with AddressSanitizer: a use of freed or\n");
    eprint("               reused memory stops the program with a report\n");
    eprint("  --bounds-checks on|off|always\n");
    eprint("               index and slice checks: as written (where\n");
    eprint("               #no_bounds_check turns them off), none, or all\n");
    eprint("  --strict     also warn about failures dropped, and values used\n");
    eprint("               before the failure that came with them is checked\n");
    eprint("  --werror     warnings fail the build\n");
    eprint("  -- args...   the program's arguments (with --run), which\n");
    eprint("               args() also returns while compiling\n");
    eprint("  --emit-c     print the generated C (--lines: with #line\n");
    eprint("               directives mapping it to the Sabk lines)\n");
    eprint("  --check      only check the program for errors\n");
    eprint("  --ir         print the IR of main and what it calls (the VM's\n");
    eprint("               bytecode, what backends are written from)\n");
    eprint("  --verify-ir  check each function's IR as it's made (for tests)\n");
    eprint("  --c-from-ir  write the C from the IR (the backend to come), not\n");
    eprint("               from the syntax tree\n");
    eprint("  --qbe        compile with QBE (vendor/qbe) instead of a C\n");
    eprint("               compiler, from the IR (--emit-c prints the IL)\n");
    eprint("  --quiet      don't print how long each phase took (it's on stderr\n");
    eprint("               after every compile)\n");
    eprint("  --stats      also print the functions written and the generic\n");
    eprint("               instances\n");
    eprint("  --tokens     print the tokens of <file>\n");
    eprint("  --ast        print the syntax tree of <file> (no imports)\n");
    eprint("  --resolve    print the syntax tree of every module with names\n");
    eprint("               linked to their declarations\n");
    eprint("  --types      print the syntax tree of every module with types and\n");
    eprint("               constant values\n");
    eprint("  --std <dir>  standard library directory (default: std next to the compiler)\n");
    return 1;
}

fn main() -> i32 {
    // std logs its failures; the compiler reports its own, in its words
    context.logger = silent_logger();
    let argv = args();
    let exe = argv[0];
    let mode = Mode.Build;
    let out_path = "";
    let std_dir = path_normalize(path_join(path_dir(exe), "std"));
    let path = "";
    let program_args: [..]string; // after `--`: the program's (and args() in #run)
    let lines = false;            // --emit-c with #line directives
    let from_ir = false;          // --c-from-ir: the C from the IR (backend_c.sabk)
    let qbe = false;              // --qbe: QBE's IL from the IR (backend_qbe.sabk)
    let bounds_checks = vm.BoundsChecks.On;
    let bounds_given = false;     // --bounds-checks wins over a build script's
    let strict = false;           // --strict and --werror add to a build script's
    let werror = false;

    let i: isize = 1;
    while (i < argv.len) {
        let arg = argv[i];
        i++;
        if (arg == "--") {
            array_append(&program_args, argv[i..]);
            break;
        }
        if (arg == "--tokens") {
            mode = .Tokens;
        } else if (arg == "--ast") {
            mode = .Ast;
        } else if (arg == "--resolve") {
            mode = .Resolve;
        } else if (arg == "--types") {
            mode = .Types;
        } else if (arg == "--run") {
            mode = .Run;
        } else if (arg == "--interp") {
            mode = .Interp;
        } else if (arg == "--ir") {
            mode = .Ir;
        } else if (arg == "--verify-ir") {
            verify_ir = true;
        } else if (arg == "--c-from-ir") {
            from_ir = true;
        } else if (arg == "--qbe") {
            qbe = true;
        } else if (arg == "--emit-c") {
            mode = .EmitC;
        } else if (arg == "--check") {
            mode = .Check;
        } else if (arg == "--lines") {
            lines = true;
        } else if (arg == "--release") {
            release = true;
        } else if (arg == "--sanitize") {
            sanitize = true;
        } else if (arg == "--bounds-checks" && i < argv.len) {
            let which = argv[i];
            i++;
            if (which == "on")
                bounds_checks = .On;
            else if (which == "off")
                bounds_checks = .Off;
            else if (which == "always")
                bounds_checks = .Always;
            else
                return print_usage(exe);
            bounds_given = true;
        } else if (arg == "--strict") {
            strict = true;
        } else if (arg == "--werror") {
            werror = true;
        } else if (arg == "--stats") {
            show_stats = true;
        } else if (arg == "--quiet") {
            quiet = true;
        } else if (arg == "-o" && i < argv.len) {
            out_path = argv[i];
            i++;
        } else if (arg == "--std" && i < argv.len) {
            std_dir = argv[i];
            i++;
        } else if ((arg.len > 0 && arg[0] == '-') || path.len > 0) {
            return print_usage(exe);
        } else {
            path = arg;
        }
    }
    if (path.len == 0)
        return print_usage(exe);

    if (mode == .Tokens || mode == .Ast) {
        let src, err = load_source(path);
        if (err != .None) {
            eprintln("%: %", path, system_error_text(err));
            return 1;
        }
        let tokens, ok = lex(&src);
        if (!ok)
            return 1;
        if (mode == .Tokens) {
            dump_tokens(tokens);
            return 0;
        }
        let root, errors = parse_file(&src, tokens);
        dump(root);
        return if (errors > 0) 1 else 0;
    }

    phase_start = now_ns();
    let r = make_resolver(std_dir);
    // made first: `#insert #run f();` checks and runs code while resolving
    let c = make_checker(&r);
    r.checker = &c;
    c.build.base_dir = path_dir(path);
    c.build.release = release; // build scripts see it, and can't undo it
    // args() while compiling: the program's name, then its arguments
    array_add(&c.build.program_args, if (out_path.len == 0) path_stem(path) else out_path);
    array_append(&c.build.program_args, program_args);
    if (!resolve_program(&r, path))
        return 1;
    end_phase("parse and resolve");

    if (mode == .Resolve) {
        for (m in r.modules) {
            println("MODULE %", m.path);
            dump(m.root);
        }
        return 0;
    }

    if (!check_program(&c))
        return 1;
    end_phase("type check");

    // build scripts set the defaults; the command line wins
    let build = &c.build;
    if (release)
        build.release = true; // a script can't turn off --release
    release = build.release;
    if (out_path.len > 0)
        build.output = out_path;
    if (bounds_given)
        build.bounds_checks = bounds_checks;
    if (strict || build.strict)
        strict_warnings(&c);
    if ((werror || build.werror) && c.warning_count > 0) {
        let why = if (werror) "--werror" else "the build script's set_werror(true)";
        eprintln("[error]: % warning%{}, and % makes warnings errors", c.warning_count,
                 if (c.warning_count == 1) "" else "s", why);
        return 1;
    }

    if (mode == .Types) {
        for (m in r.modules) {
            println("MODULE %", m.path);
            dump(m.root);
        }
        for (instance in c.instances) {
            println("INSTANCE %", describe_instance(&c, instance));
            dump(instance);
        }
        return 0;
    }
    if (mode == .Check) {
        print_stats(&c);
        return 0;
    }

    if (mode == .Interp)
        return interpret(&r, &c);
    if (mode == .Ir)
        return print_ir(&r, &c);

    let c_source = "";
    let runtime_c = ""; // --qbe's
    if (qbe) {
        if (sanitize) {
            eprintln("[error]: --sanitize needs the C (AddressSanitizer instruments it), not --qbe");
            return 1;
        }
        let main_fn = program_main(&r, &c);
        if (main_fn == null)
            return 1;
        c_source, runtime_c = generate_qbe(&r, &c, main_fn);
        if (c_source.len == 0)
            return 1;
        end_phase("generate QBE's IL");
    } else if (from_ir) {
        let main_fn = program_main(&r, &c);
        if (main_fn == null)
            return 1;
        c_source = generate_from_ir(&r, &c, main_fn);
        if (c_source.len == 0)
            return 1;
        end_phase("generate C from the IR");
    } else {
        let g = make_codegen(&r, &c);
        g.line_directives = mode != .EmitC || lines;
        c_source = generate(&g);
        if (c_source.len == 0)
            return 1;
        functions_total = g.functions_total;
        functions_emitted = g.functions_emitted;
        end_phase("generate C");
    }
    if (mode == .EmitC) {
        print(c_source);
        print_stats(&c);
        return 0;
    }

    if (mode == .Run) {
        let dir, err = make_temp_dir("sabk-run");
        if (err != .None) {
            eprintln("mkdtemp: %", system_error_text(err));
            return 1;
        }
        let program = tformat("%/program", dir);
        let ok = if (qbe) compile_qbe(c_source, runtime_c, program, build, qbe_path(exe)) else compile_c(c_source, program, build);
        let command: [..]u8;
        // the shared libraries it links aren't where the loader looks, so
        // `--run` (the compiler running it) says where
        let search = run_library_path(build);
        if (search.len > 0)
            print_to(&command, "%=% ", if (OS == .MacOS) "DYLD_LIBRARY_PATH" else "LD_LIBRARY_PATH",
                     shell_quote(search));
        append_string(&command, shell_quote(program));
        for (arg in program_args)
            print_to(&command, " %", shell_quote(arg));
        let exit: Exit;
        if (ok) {
            print_stats(&c); // the compile's times, then the program's output
            let ran, failed = run_shell(command as string);
            if (failed != .None)
                exit.code = -1;
            else
                exit = ran;
        }
        _ = delete_file(program);
        _ = remove_dir(dir);
        if (!ok)
            return 1;
        return exit.code;
    }

    let exe_path = build.output;
    if (exe_path.len == 0)
        exe_path = path_stem(path);
    let built = if (qbe) compile_qbe(c_source, runtime_c, exe_path, build, qbe_path(exe)) else compile_c(c_source, exe_path, build);
    print_stats(&c);
    return if (built) 0 else 1;
}

// QBE: $QBE, else the one `make` builds (build/qbe beside ./sabk), or one
// beside the compiler (for a compiler in build/ itself), else `qbe` from
// the PATH
fn qbe_path(exe: string) -> string {
    let named = get_env("QBE") or_else "";
    if (named.len > 0)
        return named;
    for (beside in .["build/qbe", "qbe"]) {
        let path = path_normalize(path_join(path_dir(exe), beside));
        if (file_exists(path))
            return path;
    }
    return "qbe";
}

// --interp: main run in the VM that runs #run code, as its executable
// would run (see vm_run_program)
fn interpret(r: *Resolver, c: *Checker) -> i32 {
    let main_fn = program_main(r, c);
    if (main_fn == null)
        return 1;
    if (c.build.c_files.len > 0) {
        eprintln("[error]: --interp can't run C files a build script adds (%); build the program instead",
                 join(c.build.c_files, ", "));
        return 1;
    }
    if (c.vm == null)
        c.vm = make_vm(c);
    print_stats(c); // the compile's times, then the program's output
    return vm_run_program(c.vm, main_fn);
}

// --ir: the IR of main and of what it reaches (functions, then data), as
// the VM compiles them
fn print_ir(r: *Resolver, c: *Checker) -> i32 {
    let main_fn = program_main(r, c);
    if (main_fn == null)
        return 1;
    if (c.vm == null)
        c.vm = make_vm(c);
    let program = vm_program(c.vm, main_fn, false);
    if (program.functions.len == 0)
        return 1;
    for (f in program.functions) {
        if (f.native)
            println("fn % #foreign\n", f.name);
        else
            println(ir_dump(c.vm, f));
    }
    for (d in program.data)
        println(ir_dump_data(d));
    return 0;
}

fn dump_tokens(tokens: []Token) {
    let out: [..]u8;
    for (t in tokens) {
        print_to(&out, "%{4}:%{<3} %{<22} `%`", t.line, t.column, token_name(t.kind), t.text);
        if (t.kind == .Number) {
            let value, _ = integer_value(t.text);
            print_to(&out, " = %", value);
        }
        if (t.kind == .Float) {
            let buffer: [64]u8 = ---;
            snprintf(buffer.ptr, buffer.len as usize, "%g", float_value(t.text));
            print_to(&out, " = %", from_cstring(buffer.ptr));
        }
        array_add(&out, '\n');
    }
    print(out as string);
}
