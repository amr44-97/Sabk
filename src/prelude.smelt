
pub enum AllocatorMode { Alloc, Free, Resize, FreeAll }

// An allocator: (data, mode, size, alignment, old_memory, old_size) -> memory
//   Alloc    `size` bytes of zeroed memory, aligned to `alignment`
//   Free     frees `old_memory`, returns null
//   Resize   `size` bytes holding the first min(size, old_size) bytes of
//            `old_memory`, the rest zeroed; `old_memory` is freed
//   FreeAll  frees everything the allocator handed out, if it can
// Running out of memory returns null. `alignment` is a power of two.
pub type AllocatorProc = fn(*void, AllocatorMode, isize, isize, *void, isize) -> *void;

pub struct Allocator {
    procedure: AllocatorProc;
    data: *void;                // passed to `procedure`
}

pub struct Context {
    allocator: Allocator;        // the heap, unless a block changes it
    temp_allocator: Allocator;   // an arena: free it all with FreeAll
    logger: Logger;              // where std/log's log() goes: stderr
    panic_handler: PanicHandler; // what std's panic and assert call
}

pub enum LogLevel { Debug, Info, Warning, Error }

// A logger: (data, level, message). The message is only valid during the
// call, so a logger that keeps it copies it.
pub type LoggerProc = fn(*void, LogLevel, string);

pub struct Logger {
    procedure: LoggerProc;
    data: *void;                // passed to `procedure`
}

// What std's panic and assert call: (data, what, message, location), with
// `what` "panic" or "assertion failed" and the location "file:line:col".
// It shouldn't return: if it does, the program aborts there anyway, since
// the code after a panic can't go on.
pub type PanicProc = fn(*void, string, string, string);

pub struct PanicHandler {
    procedure: PanicProc;
    data: *void;                // passed to `procedure`
}

// ---- type information, for printing any value (std/fmt) and reflection
//
// type_info(T) is a *TypeInfo; the compiler makes one for every type that
// needs it, at run time and at compile time. A value of any type converts
// to Any implicitly: a pointer to (a copy of) it and its type.

pub enum TypeKind {
    Void, Bool, Int, Float, Rawptr, Pointer, Array, Slice, Growable, String,
    Function, Struct, Union, Enum, TaggedEnum,
}

pub struct TypeInfo {
    kind: TypeKind;
    name: string;             // as messages write it, like []u8 or List(i32)
    size: isize;
    align: isize;
    is_signed: bool;          // Int
    elem: *TypeInfo;          // Pointer, Array, Slice, Growable, String:
                              // what it holds; Enum, TaggedEnum: the tag's
                              // integer type
    count: isize;             // Array: its length
    fields: []TypeField;      // Struct, Union; TaggedEnum: tag and payload
    variants: []TypeVariant;  // Enum, TaggedEnum
}

pub struct TypeField {
    name: string;
    info: *TypeInfo;
    offset: isize;
}

pub struct TypeVariant {
    name: string;
    value: i64;
    payload: *TypeInfo;       // TaggedEnum: what it holds, or null
}

pub struct Any {
    value: *void;
    info: *TypeInfo;
}

extern fn calloc(count: usize, size: usize) -> *void;
extern fn realloc(memory: *void, size: usize) -> *void;
extern fn free(memory: *void);
extern fn memset(memory: *void, value: i32, size: usize) -> *void;
extern fn memcpy(dst: *void, src: *void, size: usize) -> *void;

fn default_context() -> Context {
    return Context.{
        .allocator = Allocator.{ .procedure = heap_proc },
        .temp_allocator = Allocator.{ .procedure = temp_proc },
        .logger = Logger.{ .procedure = stderr_logger },
        .panic_handler = PanicHandler.{ .procedure = print_and_abort },
    };
}

// ---- the default logger and panic handler, both on stderr

extern fn dprintf(fd: i32, format: *u8, ...) -> i32;
extern fn fflush(file: *void) -> i32;
extern fn abort();

// "warning: message"
fn stderr_logger(data: *void, level: LogLevel, message: string) {
    let name = "debug";
    switch (level) {
    case .Debug:   name = "debug";
    case .Info:    name = "info";
    case .Warning: name = "warning";
    case .Error:   name = "error";
    }
    fflush(null); // after what was printed before it
    dprintf(2, "%.*s: %.*s\n", name.len as i32, name.ptr, message.len as i32,
            message.ptr);
}

// "file:line:col: panic: message", then abort()
fn print_and_abort(data: *void, what: string, message: string, location: string) {
    fflush(null); // keep what was printed before
    dprintf(2, "%.*s: %.*s: %.*s\n", location.len as i32, location.ptr,
            what.len as i32, what.ptr, message.len as i32, message.ptr);
    abort();
}

// ---- the heap: C's allocator, which aligns everything to 16 bytes

fn heap_proc(data: *void, mode: AllocatorMode, size: isize, align: isize, old: *void, old_size: isize) -> *void {
    switch (mode) {
    case AllocatorMode.Alloc:
        return calloc(1, size as usize);
    case AllocatorMode.Free:
        free(old);
        return null;
    case AllocatorMode.Resize:
        let memory = realloc(old, size as usize);
        if (memory != null && size > old_size) {
            let added = (memory as *u8)[old_size..size];
            memset(added.ptr, 0, added.len as usize);
        }
        return memory;
    default:
        return null; // FreeAll: the heap can't
    }
}

// ---- the temp allocator: one arena per program, freed all at once

struct TempBlock {
    previous: *TempBlock;
    memory: []u8;
    used: isize;
}

let temp_blocks: *TempBlock = null;

fn align_forward(address: isize, align: isize) -> isize {
    return (address + align - 1) & ~(align - 1);
}

// --sanitize: memory taken back is poisoned, and unpoisoned when it's
// handed out again (the C runtime's; they do nothing in other builds)
extern fn smelt_poison(memory: *void, size: isize);
extern fn smelt_unpoison(memory: *void, size: isize);

// `size` bytes from `block`, or null if they don't fit
fn temp_carve(block: *TempBlock, size: isize, align: isize) -> *void {
    let base = block.memory.ptr as isize;
    let start = align_forward(base + block.used, align) - base;
    if (start + size > block.memory.len)
        return null;
    block.used = start + size;
    let memory = block.memory[start..start + size];
    smelt_unpoison(memory.ptr, size);
    memset(memory.ptr, 0, size as usize);
    return memory.ptr;
}

fn temp_alloc(size: isize, align: isize) -> *void {
    if (align == 0)
        align = 1;
    if (temp_blocks != null) {
        let memory = temp_carve(temp_blocks, size, align);
        if (memory != null)
            return memory;
    }
    let capacity = 64 * 1024;
    if (size + align > capacity)
        capacity = size + align;
    let block = calloc(1, sizeof(TempBlock) as usize) as *TempBlock;
    let memory = calloc(1, capacity as usize) as *u8;
    if (block == null || memory == null) {
        free(block);
        free(memory);
        return null;
    }
    block.previous = temp_blocks;
    block.memory = memory[0..capacity];
    temp_blocks = block;
    return temp_carve(block, size, align);
}

// keeps the newest block for reuse and frees the rest
fn temp_free_all() {
    if (temp_blocks == null)
        return;
    let block = temp_blocks.previous;
    while (block != null) {
        let previous = block.previous;
        smelt_unpoison(block.memory.ptr, block.memory.len); // the heap's again
        free(block.memory.ptr);
        free(block);
        block = previous;
    }
    temp_blocks.previous = null;
    temp_blocks.used = 0;
    smelt_poison(temp_blocks.memory.ptr, temp_blocks.memory.len);
}

fn temp_proc(data: *void, mode: AllocatorMode, size: isize, align: isize, old: *void, old_size: isize) -> *void {
    switch (mode) {
    case AllocatorMode.Alloc:
        return temp_alloc(size, align);
    case AllocatorMode.Resize:
        let memory = temp_alloc(size, align);
        if (memory != null && old != null) {
            let keep = old_size;
            if (size < keep)
                keep = size;
            memcpy(memory, old, keep as usize);
        }
        return memory;
    case AllocatorMode.FreeAll:
        temp_free_all();
        return null;
    default:
        return null; // Free: arena memory is only freed all at once
    }
}

// ---- the target: what the program is built for, for `#if`:
//   #if (OS == .Windows) { ... } else { ... }
pub enum OperatingSystem { Linux, MacOS, Windows, FreeBSD, Other }
pub enum Architecture { X64, Arm64, X86, Arm32, RiscV64, Other }
pub const OS = OperatingSystem.@OS@;
pub const ARCH = Architecture.@ARCH@;
pub const POINTER_SIZE = sizeof(*void);

// ---- Error: one type every error enum converts to
//
// An error enum, `enum IoError: Error { NotFound, ... }`, has Error's None
// at 0 and converts to Error implicitly, so `or_return` passes failures of
// any enum on from a function returning Error, and `fn main() -> Error`
// reports what failed. The value is which enum it came from (a number the
// compiler gives each one, in the high 32 bits) and the variant's value
// (the low 32); each enum's None is Error's None. Back is a checked match:
// `if (err is IoError(e))`, `case IoError(.NotFound):`.

pub enum Error: u64 { None }

// A value that may be missing: `?T` is short for Option(T). A new one is
// None, and `o or_else fallback` is its value, or the fallback for None.
pub enum Option($T) { None, Some(T) }

// the failure enum `e` came from, or null for None
pub fn error_enum(e: Error) -> *TypeInfo {
    return smelt_error_type(((e as u64) >> 32) as u32);
}

// the value of the variant `e` came from
pub fn error_value(e: Error) -> i64 {
    return ((e as u64) & 0xFFFFFFFF) as i64;
}

// the compiler's table of the enums that became Errors
extern fn smelt_error_type(id: u32) -> *TypeInfo;
