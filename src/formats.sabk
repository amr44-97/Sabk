// Calls of `#format` functions: a format known at compile time must match
// its values. A mistake is shown where it is in the format, with the call
// written the right way: C's `%d` and `%5.2f` are translated, and a letter
// meant as text (`%px`) gets `%{}px`.

#import "std/array";
#import "std/fmt";
#import "std/map";
#import "std/str";
#import "ast";
#import "token";
#import "types";
#import "check";

// A call of a `#format` function whose format is known at compile time
// and whose values are written out: the `%`s and the values must match,
// each directive must be one, and suit its value.
fn check_format_call(c: *Checker, n: *Node, fun: *Node) {
    let at = fn_params(fun).len - 1; // the ..Any parameter
    let args = items_of(n);
    if (at == 0 || args.len <= at || !map_has(&c.packs, args[at]))
        return; // no values (printed as it is), or `..args` passed on
    let values = items_of(args[at]);
    let arg = args[at - 1];
    let literal = ungroup(arg);
    if ((literal.kind.tag == .Identifier || literal.kind.tag == .Member) && literal.decl != null &&
        literal.decl.kind is .Const{value} && value != null)
        literal = value;
    let quoted = "";
    switch (literal.kind) {
    case .String{quoted: text}: quoted = text;
    default: return; // only known when the program runs
    }
    // written right here: errors can point inside it
    let in_source = literal == arg && quoted.len == 0;
    let raw = if (quoted.len > 0) quoted else literal.tok.text;
    let holes = holes_of(raw);

    if (values.len == 0)
        return; // printed as it is
    // the directives that aren't one; then the call written right, with
    // every one fixed, and the directives if one was unknown
    let bad: [..]Hole;
    for (hole in holes)
        if (hole.kind == .CHabit || hole.kind == .Text)
            array_add(&bad, hole);
    let table = false;
    for (hole in bad) {
        let written = raw[hole.pos..hole.pos + hole.len];
        let message = if (hole.kind == .CHabit) tformat("`%` isn't a directive: %", written, hole.why)
                      else tformat("`%{}%` isn't a directive; for a value followed by `%`, write `%%{}%`",
                                   written, hole.why[..1], hole.why, hole.why);
        error(c, inside(arg, in_source, hole.pos, hole.len), message);
        table = table || hole.table;
    }
    if (bad.len > 0) {
        let last = bad[bad.len - 1];
        let where = inside(arg, in_source, last.pos, last.len);
        if (in_source)
            note(c, where, tformat("write: %", rewritten(n, at, raw, bad)));
        if (table)
            note(c, where, DIRECTIVES);
        return;
    }

    if (values.len < holes.len) {
        let missing = holes[values.len];
        error(c, inside(arg, in_source, missing.pos, missing.len),
              tformat("this `%%` has no value: the format has %, but % given",
                      plural(holes.len, "`%`", "`%`s"), plural(values.len, "value is", "values are")));
    } else if (values.len > holes.len) {
        error(c, values[holes.len].tok, tformat("this value has no `%%` in the format: it has %, for %",
                                                plural(holes.len, "`%`", "`%`s"), plural(values.len, "value", "values")));
        note(c, arg.tok, "the format");
    }

    for (k in 0..holes.len) {
        let hole = holes[k];
        let kind: u8 = 0;
        let written = raw[hole.pos..hole.pos + hole.len];
        if (hole.kind == .Braces) {
            let parsed, why = parse_spec(hole.spec);
            if (why.len > 0) {
                error(c, inside(arg, in_source, hole.pos, hole.len), tformat("`%%{%}` isn't a format: %", hole.spec, why));
                continue;
            }
            kind = parsed;
        } else if (hole.kind == .Letter) {
            kind = hole.spec[0];
        }
        if (kind == 0 || k >= values.len)
            continue;
        // the kind must suit the value; inside a struct or array it applies
        // to what it holds, so those aren't checked
        let t = values[k].ty;
        if (t == null || t.kind == .Error)
            continue;
        let why = unsuited(c, kind, t, written, values[k]);
        if (why.len > 0)
            error(c, inside(arg, in_source, hole.pos, hole.len), why);
    }
}

#scope_file

// what the format shows next to a mistake in it
const DIRECTIVES = "the directives: `%` any value, `%s` text, `%q` quoted text, `%w` an error or enum value with its enum, `%x %X` hex, `%b %o` binary, octal, `%e %f` scientific, fixed, `%c` a character, `%{...}` options (`%{8}`, `%{<8}`, `%{.2}`, `%{08x}`), `%{}` a value before a letter, `%%` a percent sign";

// One `%{spec}` (the text between the braces), by the rules of std/fmt's
// parse_format_spec, which this must match: [<>^][+][0][width][.digits]
// [kind]. Its kind (0 if none), and why it isn't one, if it isn't.
fn parse_spec(spec: string) -> (u8, string) {
    let i: isize = 0;
    if (i < spec.len && (spec[i] == '<' || spec[i] == '>' || spec[i] == '^'))
        i++;
    if (i < spec.len && spec[i] == '+')
        i++;
    if (i < spec.len && spec[i] == '0')
        i++;
    while (i < spec.len && is_digit(spec[i]))
        i++;
    if (i < spec.len && spec[i] == '.') {
        i++;
        if (i == spec.len || !is_digit(spec[i]))
            return 0, "a `.` needs the precision's digits after it";
        while (i < spec.len && is_digit(spec[i]))
            i++;
    }
    let kind: u8 = 0;
    if (i < spec.len) {
        if (!is_format_kind(spec[i]))
            return 0, tformat("`%` isn't a kind; the kinds are s q (text), w (an error or enum), x X b o (integers), e f (floats) and c (a u8)",
                              spec[i..i + 1]);
        kind = spec[i];
        i++;
    }
    if (i != spec.len)
        return 0, tformat("`%` is left over; the order is [align][+][0][width][.precision][kind]", spec[i..]);
    return kind, "";
}

fn is_digit(c: u8) -> bool { return c >= '0' && c <= '9'; }
fn is_letter(c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }

enum HoleKind {
    Plain,      // %
    Letter,     // %x
    Braces,     // %{spec}
    CHabit,     // C's %d, %5.2f: an error, with Sabk's spelling
    Text,       // %px: a letter meant as text, an error
}

struct Hole {
    kind: HoleKind;
    pos: isize;
    len: isize;
    spec: string;   // Braces: the text inside; Letter: the letter
    fix: string;    // CHabit, Text: what to write instead
    why: string;    // CHabit: what's wrong
    table: bool;    // CHabit, Text: show the directives too
}

// C's printf spelling at raw[i] (a `%`): flags, width, precision, length,
// conversion, as people write them: `%d`, `%-10s`, `%5.2f`, `%lld`, `%zu`.
// Its length and Sabk's spelling of it, or 0. Not C's space flag, or
// conversions that look like words (`%ta`): `% to` is Sabk, a value then
// text.
fn c_spec(raw: string, i: isize) -> (isize, string, string) {
    let j = i + 1;
    let align = "";
    let plus = "";
    let zero = "";
    while (j < raw.len && index_of_char("-+#0", raw[j]) >= 0) {
        if (raw[j] == '-')
            align = "<";
        else if (raw[j] == '+')
            plus = "+";
        else if (raw[j] == '0')
            zero = "0";
        j++;
    }
    if (align.len > 0)
        zero = ""; // C ignores 0 with -
    let width_start = j;
    while (j < raw.len && is_digit(raw[j]))
        j++;
    let width = raw[width_start..j];
    let precision = "";
    if (j < raw.len && raw[j] == '.') {
        let start = j;
        j++;
        while (j < raw.len && is_digit(raw[j]))
            j++;
        precision = raw[start..j];
        if (precision == ".")
            precision = ".0";
    }
    let length_start = j;
    while (j < raw.len && index_of_char("hlzjtL", raw[j]) >= 0 && j - length_start < 2)
        j++;
    let length = raw[length_start..j];
    let has_length = length.len > 0;
    if (j >= raw.len || index_of_char("diouxXeEfFgGcsp", raw[j]) < 0)
        return 0, "", "";
    let conversion = raw[j];
    // a length goes with an integer (and `%lf`, `%Lf` with a double)
    let integer = index_of_char("diouxX", conversion) >= 0;
    let floating = (length == "l" || length == "L") && index_of_char("eEfFgG", conversion) >= 0;
    if (has_length && !integer && !floating)
        return 0, "", "";
    if (has_length && index_of_char("hlzjt", length[0]) < 0 && !floating)
        return 0, "", "";
    j++;
    let kind_text = switch (conversion) {
    case 'o', 'x', 'X', 'e', 'f', 'c', 's': raw[j - 1..j];
    case 'E': "e";
    case 'F': "f";
    default: "";
    };
    let kind: u8 = if (kind_text.len > 0) kind_text[0] else 0;
    let options = cat_strings(.[align, plus, zero, width, precision]);
    let fix = if (options.len == 0) cat_strings(.["%", kind_text]) else cat_strings(.["%{", options, kind_text, "}"]);
    let why = "";
    if (options.len > 0 || has_length && kind != 0)
        why = tformat("Sabk's options go in braces: `%`", fix);
    else if (conversion == 'p')
        why = "Sabk's `%` prints a pointer as its address";
    else if (conversion == 'E' || conversion == 'F')
        why = tformat("Sabk's is `%`", fix);
    else if (kind == 0)
        why = "Sabk's `%` prints a number as it is";
    else
        return 0, "", ""; // `%x` and the like are Sabk's own
    return j - i, fix, why;
}

fn cat_strings(parts: []string) -> string {
    let out: [..]u8;
    out.allocator = context.temp_allocator;
    for (p in parts)
        append_string(&out, p);
    return out as string;
}

// the holes of a format's text (its raw literal, with its quotes)
fn holes_of(raw: string) -> [..]Hole {
    let holes: [..]Hole;
    let i: isize = 1;
    while (i + 1 < raw.len) { // inside the quotes
        if (raw[i] == '\\') {
            i += 2; // an escape: not a `%`
            continue;
        }
        if (raw[i] != '%') {
            i++;
            continue;
        }
        let next = raw[i + 1];
        if (next == '%') {
            i += 2;
            continue;
        }
        if (next == '{') {
            let close = i + 2;
            while (close < raw.len && raw[close] != '}')
                close++;
            if (close >= raw.len - 1) {
                i++; // `%{` never closed: just text
                continue;
            }
            array_add(&holes, Hole.{ .kind = .Braces, .pos = i, .len = close - i + 1, .spec = raw[i + 2..close] });
            i = close + 1;
            continue;
        }
        if (is_letter(next) && is_format_kind(next)) {
            array_add(&holes, Hole.{ .kind = .Letter, .pos = i, .len = 2, .spec = raw[i + 1..i + 2] });
            i += 2;
            continue;
        }
        if (is_letter(next) || index_of_char("-+#0123456789.", next) >= 0) {
            // C's spelling, if it's one where a word ends
            let length, fix, why = c_spec(raw, i);
            let ends = length > 0 && (i + length >= raw.len || !is_letter(raw[i + length]));
            if (ends) {
                array_add(&holes, Hole.{ .kind = .CHabit, .pos = i, .len = length, .fix = fix, .why = why, .table = true });
                i += length;
                continue;
            }
        }
        if (is_letter(next)) {
            // a letter meant as text: %px
            let end = i + 1;
            while (end < raw.len && is_letter(raw[end]))
                end++;
            let word = raw[i + 1..end];
            array_add(&holes, Hole.{ .kind = .Text, .pos = i, .len = 1, .fix = "%{}",
                                     .why = word, .table = word.len == 1 });
            i += 2;
            continue;
        }
        array_add(&holes, Hole.{ .kind = .Plain, .pos = i, .len = 1 });
        i++;
    }
    return holes;
}

fn plural(n: isize, one: string, many: string) -> string {
    return tformat("% %", n, if (n == 1) one else many);
}

// "an `i64`", "a `string`"
fn a_type(t: *Type) -> string {
    let name = type_name(t);
    let vowel = name.len > 0 && (index_of_char("aeioAEIO", name[0]) >= 0 ||
                                 (name[0] == 'f' && name.len > 1 && is_digit(name[1])));
    return tformat("% `%`", if (vowel) "an" else "a", name);
}

// how a message names a value: its text when it's short
fn value_name(value: *Node) -> string {
    let text = text_of(value);
    return if (text.len > 0 && text.len <= 24 && index_of_char(text, '\n') < 0) tformat("`%`", text) else "the value";
}

fn is_text_type(c: *Checker, t: *Type) -> bool {
    if (t.is_string || t.kind == .UntypedString)
        return true;
    let byte = c.types.u8;
    return (t.kind == .Slice || t.kind == .Array || t.kind == .Growable || t.kind == .Ptr) && t.elem == byte;
}

fn is_aggregate(t: *Type) -> bool {
    return (t.kind == .Struct && !t.is_tagged) || t.kind == .Union || t.kind == .Array || t.kind == .Growable ||
           (t.kind == .Slice && !t.is_string);
}

// why value `t` doesn't suit directive `kind`, or ""
fn unsuited(c: *Checker, kind: u8, t: *Type, written: string, value: *Node) -> string {
    switch (kind) {
    case 's', 'q':
        if (is_text_type(c, t) || is_aggregate(t))
            return "";
        let hint = if (is_numeric(t)) "; for a number write `%`, or `%x` for hex" else "; write `%` to print it as it is";
        return tformat("`%` prints text, but % is %{}%", written, value_name(value), a_type(t), hint);
    case 'w':
        if (t.kind == .Enum || t.is_tagged || is_aggregate(t))
            return "";
        return tformat("`%` prints an error or an enum value with its enum, but % is %; write `%`",
                       written, value_name(value), a_type(t), "%");
    case 'x', 'X', 'b', 'o', 'c':
        if (t.kind == .Int || is_aggregate(t))
            return "";
        let hint = if (is_text_type(c, t)) "; for text write `%s`" else "";
        return tformat("`%` prints an integer, but % is %{}%", written, value_name(value), a_type(t), hint);
    default: // e, f
        if (t.kind == .Int || t.kind == .Float || is_aggregate(t))
            return "";
        return tformat("`%` prints a number, but % is %", written, value_name(value), a_type(t));
    }
}

// the call as it should be written: the format with its holes fixed
fn rewritten(n: *Node, at: isize, raw: string, bad: []Hole) -> string {
    let args = items_of(n);
    let callee: *Node = null;
    if (n.kind is .Call{callee: e})
        callee = e;
    let out: [..]u8;
    out.allocator = context.temp_allocator;
    append_string(&out, text_of(callee));
    array_add(&out, '(');
    let first = true;
    for (i in 0..at) {
        if (!first)
            append_string(&out, ", ");
        first = false;
        if (i == at - 1) {
            let done: isize = 0;
            for (hole in bad) {
                append_string(&out, raw[done..hole.pos]);
                append_string(&out, hole.fix);
                done = hole.pos + hole.len;
            }
            append_string(&out, raw[done..]);
        } else {
            append_string(&out, text_of(args[i]));
        }
    }
    for (value in items_of(args[at])) {
        append_string(&out, ", ");
        append_string(&out, text_of(value));
    }
    array_add(&out, ')');
    return out as string;
}

// a token for the literal's raw[pos..pos+len], or the whole argument
fn inside(arg: *Node, in_source: bool, pos: isize, len: isize) -> Token {
    let t = arg.tok;
    if (in_source)
        t.text = arg.tok.text[pos..pos + len];
    return t;
}
