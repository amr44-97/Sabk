// The parser: tokens to a syntax tree, by recursive descent, for the
// grammar in docs/reference.md.
//
//   let root, errors = parse_file(&src, tokens);
//
// A syntax error is reported, and the compiler stops there (`exit(1)`), as
// the C++ one did. Code that parses but is wrong anyway (mixed operators,
// C's spellings of literals) is reported and counted, and parsing goes on.

#import "std/array";
#import "std/fmt";
#import "std/io";
#import "std/mem";
#import "std/os";
#import "std/path";
#import "std/str";
#import "ast";
#import "source";
#import "token";

// the file's declarations, and how many errors were reported and gone past
fn parse_file(src: *Source, tokens: []Token) -> (*Node, isize) {
    let p = Parser.{ .src = src, .tokens = tokens };
    let start = peek(&p);
    let decls: [..]*Node;
    while (!at(&p, .Eof)) {
        // #scope_export, #scope_module, #scope_file: from here to the next
        if (at(&p, .Hash) && starts_with(peek(&p, 1).text, "scope_")) {
            let t = directive(&p);
            let v = Visibility.Export;
            switch (t.text) {
            case "#scope_export": v = .Export;
            case "#scope_module": v = .Module;
            case "#scope_file":   v = .File;
            default:
                fail(&p, t, tformat("unknown directive `%`; who sees a declaration is set by `#scope_export`, `#scope_module` or `#scope_file`",
                                   t.text));
            }
            array_add(&decls, new_node(t, .ScopeRegion(v)));
            continue;
        }
        array_add(&decls, top_decl(&p));
    }
    return new_node(start, .Root(decls)), p.error_count;
}

// code made by `#insert` where statements go: statements up to the end
fn parse_stmts(src: *Source, tokens: []Token) -> ([]*Node, isize) {
    let p = Parser.{ .src = src, .tokens = tokens };
    let stmts: [..]*Node;
    while (!at(&p, .Eof))
        array_add(&stmts, stmt(&p));
    return stmts, p.error_count;
}

// code made by `#insert` where an expression goes: one expression, all of it
fn parse_whole_expr(src: *Source, tokens: []Token) -> (*Node, isize) {
    let p = Parser.{ .src = src, .tokens = tokens };
    let e = expr(&p);
    if (!at(&p, .Eof))
        fail(&p, peek(&p), tformat("expected the end of the expression, found %", describe(peek(&p))));
    return e, p.error_count;
}

#scope_file

// binary operator precedences that other code refers to
const BIT_OR_PREC = 4; // `|`, the loosest bit operator
const CMP_PREC = 7;    // comparisons, and `is`

struct Parser {
    src: *Source;
    tokens: []Token;      // the last one is Eof
    idx: isize;
    error_count: isize;
    statement_head: bool; // parsing the first expression of a statement
    in_pattern: bool;     // a case's `X:` isn't a label there
    bare_condition: bool; // in `if x {`: a `{` after a name is the body
}

/* ---------------------------------------------------------------- tokens */

// looking past the end gives the Eof
fn peek(p: *Parser, k: isize = 0) -> Token {
    let i = p.idx + k;
    return if (i < p.tokens.len) p.tokens[i] else p.tokens[p.tokens.len - 1];
}

fn at(p: *Parser, kind: TokenKind, k: isize = 0) -> bool { return peek(p, k).kind == kind; }

fn next(p: *Parser) -> Token {
    let t = peek(p);
    if (p.idx < p.tokens.len - 1)
        p.idx++;
    return t;
}

fn eat(p: *Parser, kind: TokenKind) -> bool {
    if (!at(p, kind))
        return false;
    next(p);
    return true;
}

// `#name`; the name can be a keyword (`#if`)
fn at_directive(p: *Parser, name: string) -> bool {
    return at(p, .Hash) && peek(p, 1).text == name;
}

// a keyword can be a field's name: `type`, `else`, `default`
fn is_keyword_token(kind: TokenKind) -> bool { return (kind as u8) >= (TokenKind.Fn as u8); }

// is the token `k` ahead a name where a field's goes: an identifier, or a
// keyword
fn at_field_name(p: *Parser, k: isize = 0) -> bool {
    let kind = peek(p, k).kind;
    return kind == .Identifier || is_keyword_token(kind);
}

// a field's name, a keyword too: then it's a name like any other
fn field_name(p: *Parser, what: string) -> Token {
    if (!at_field_name(p))
        return expect(p, .Identifier, what);
    let t = next(p);
    t.kind = .Identifier;
    return t;
}

fn describe(t: Token) -> string {
    if (t.kind == .Eof)
        return "end of file";
    return tformat("`%`", t.text);
}

fn expect(p: *Parser, kind: TokenKind, what: string) -> Token {
    if (!at(p, kind))
        fail(p, peek(p), tformat("expected %, found %", what, describe(peek(p))));
    return next(p);
}

// a syntax error: reported, and the compiler stops
fn fail(p: *Parser, t: Token, message: string) -> *Node {
    report(p.src, .Error, t.text, message);
    fatal_error_notes();
    exit(1);
    return null;
}

// an error parsing can go past
fn report_error(p: *Parser, t: Token, message: string) {
    report(p.src, .Error, t.text, message);
    fatal_error_notes(); // its notes
    p.error_count++;
}

// `#name`: both tokens, as one token for errors to point at
fn directive(p: *Parser) -> Token {
    let hash = next(p);
    let name = next(p);
    return joined(hash, name);
}

// `a` and `b` as one token when nothing is between them: `#run`, `.Red`
fn joined(a: Token, b: Token) -> Token {
    if (b.text.ptr != a.text.ptr + a.text.len)
        return b;
    let t = b;
    t.text = a.text.ptr[0..a.text.len + b.text.len] as string;
    t.line = a.line;
    t.column = a.column;
    return t;
}

// the source text from `begin` to the end of the last token taken
fn span_from(p: *Parser, begin: *u8) -> string {
    let last = p.tokens[p.idx - 1];
    let end = last.text.ptr + last.text.len;
    return begin[0..(end as isize) - (begin as isize)] as string;
}

/* ---------------------------------------------------------- declarations */

// #if (condition) { declarations } [else #if (...) { ... }] [else { ... }]
// at the top level: the branch taken is part of the module
fn top_static_if(p: *Parser) -> *Node {
    next(p); // #
    let t = next(p);
    expect(p, .LParen, "`(` after `#if`");
    let cond = expr(p);
    expect(p, .RParen, "`)` after the condition");
    let then = top_block(p);
    let else_: *Node = null;
    if (eat(p, .Else))
        else_ = if (at_directive(p, "if")) top_static_if(p) else top_block(p);
    return new_node(t, .StaticIf(cond, then, else_));
}

// a top-level `#if`'s branch: `{` declarations `}`
fn top_block(p: *Parser) -> *Node {
    let open = expect(p, .LBrace, "`{` and the declarations for this branch of the `#if`");
    let decls: [..]*Node;
    while (!at(p, .RBrace)) {
        if (at(p, .Eof))
            fail(p, open, "this `{` of an `#if` branch is never closed");
        array_add(&decls, top_decl(p));
    }
    next(p);
    return new_node(open, .Block(decls, null, false));
}

fn top_decl(p: *Parser) -> *Node {
    if (at_directive(p, "import"))
        return import_decl(p);
    if (at_directive(p, "load")) {
        // `#load "file.sabk";`: the file's declarations join this module
        directive(p);
        let path = expect(p, .String, "a file path after `#load`");
        expect(p, .Semicolon, "`;` after `#load`");
        return new_node(path, .Load);
    }
    if (at_directive(p, "if"))
        return top_static_if(p);
    if (at_directive(p, "assert"))
        return static_assert(p);
    if (at_directive(p, "run")) {
        // `#run build();`: runs once the program is checked (a build script)
        let t = directive(p);
        let value = expr(p);
        expect(p, .Semicolon, "`;` after `#run`");
        return new_node(t, .Run(value));
    }
    if (at_directive(p, "insert")) {
        // `#insert #run f();`: declarations made from a string
        let t = directive(p);
        let value = expr(p);
        expect(p, .Semicolon, "`;` after `#insert`");
        return new_node(t, .InsertString(value));
    }

    let decl: *Node;
    switch (peek(p).kind) {
    case .Extern:
        // `extern` went with section 8 of the plan: what to write instead
        if (at(p, .Let, 1)) {
            let keyword = next(p);
            next(p); // let
            let name = if (at(p, .Identifier)) peek(p).text else "name";
            fail(p, keyword, tformat("`extern` is gone: a C variable names its library, `let %: T #foreign libc;` (`libc` comes from `#import \"std/c\";`)",
                                     name));
        }
        decl = fn_decl(p); // says what the function would be
    case .Fn:     decl = fn_decl(p);
    case .Struct: decl = aggregate(p, false);
    case .Union:  decl = aggregate(p, true);
    case .Enum:   decl = enum_decl(p);
    case .Type:
        let t = peek(p);
        return fail(p, t, tformat("a name for a type is a constant: `const % = ...;`",
                                  if (at(p, .Identifier, 1)) peek(p, 1).text else "Name"));
    case .Const:  decl = const_decl(p);
    case .Let:
        decl = let_decl(p);
        if (decl.kind is .LetValues{names})
            fail(p, names[1].tok, tformat("a global variable is declared one at a time: `let % = ...;`", decl.tok.text));
        if (at_directive(p, "foreign"))
            foreign_let(p, decl);
        expect(p, .Semicolon, "`;` after the declaration");
    default:
        let t = peek(p);
        if (t.kind == .Identifier && t.text == "pub")
            return fail(p, t, "Sabk has no `pub`: a declaration is exported unless a `#scope_module` or `#scope_file` above it says otherwise");
        if (t.kind == .Identifier && t.text == "import")
            return fail(p, t, tformat("an import is written `#import %;`",
                                      if (at(p, .String, 1)) peek(p, 1).text else "\"path\""));
        return fail(p, t, tformat("expected a declaration (fn, struct, union, enum, const, let or #import), found %", describe(t)));
    }
    return decl;
}

// `#assert(sizeof(Header) == 16, "the file format's");`, the message
// optional: checked while compiling
fn static_assert(p: *Parser) -> *Node {
    let t = directive(p);
    expect(p, .LParen, "`(` and a condition after `#assert`, like `#assert(sizeof(T) <= 8)`");
    let cond = expr(p);
    let message: *Node = null;
    if (eat(p, .Comma)) {
        let text = expect(p, .String, "the message after the condition, a string: `#assert(cond, \"why\")`");
        message = new_node(text, .String(text.text));
    }
    expect(p, .RParen, "`)` after `#assert`'s condition and message");
    expect(p, .Semicolon, "`;` after `#assert(...)`");
    return new_node(t, .StaticAssert(cond, message));
}

// `#embed("words.txt")`: the file's contents, as a string literal made
// here, so everything after sees a literal; the path is relative to the
// file the #embed is written in
fn embed(p: *Parser, t: Token) -> *Node {
    expect(p, .LParen, "`(` and a file's path after `#embed`, like `#embed(\"words.txt\")`");
    let spec_tok = expect(p, .String, "a file's path, a string: `#embed(\"words.txt\")`");
    expect(p, .RParen, "`)` after `#embed`'s path");
    let spec = spec_tok.text[1..spec_tok.text.len - 1];
    let path = if (path_is_absolute(spec)) spec else path_normalize(path_join(path_dir(p.src.path), spec));
    let text, err = read_file(path);
    if (err != .None) {
        report_error(p, spec_tok, tformat("`#embed` can't read `%` (looked for `%`): %", spec, path, io_error_message(err)));
        text = "";
    }
    return new_node(t, .String(quote_string(text)));
}

// `#import "std/io";`, `#import "std/io" as io;`
fn import_decl(p: *Parser) -> *Node {
    directive(p); // #import
    let path = expect(p, .String, "a module path after `#import`");
    let alias: *Node = null;
    if (eat(p, .As))
        alias = new_node(expect(p, .Identifier, "a module name after `as`"), .Identifier);
    expect(p, .Semicolon, "`;` after the import");
    return new_node(path, .Import(alias));
}

fn fn_decl(p: *Parser) -> *Node {
    let extern_token = peek(p);
    let is_extern = eat(p, .Extern);
    let extern_keyword = is_extern;
    expect(p, .Fn, "`fn` after `extern`");
    let name = if (at_operator_name(p)) operator_name(p) else expect(p, .Identifier, "a function name");
    let params: [..]*Node;
    let variadic = false;
    let dots: Token;

    expect(p, .LParen, "`(` to start the parameter list");
    while (!at(p, .RParen)) {
        if (at(p, .Ellipsis3)) {
            dots = next(p); // C's: checked once #foreign can have said so
            variadic = true;
            break;
        }
        if (at(p, .Dollar)) {
            // $T: type, a parameter that takes a type: make_list(i32)
            let declared = type_(p);
            expect(p, .Colon, "`: type` after the type parameter");
            let kind = next(p);
            if (kind.kind != .Type)
                fail(p, kind, tformat("a `$%` parameter takes a type, so it's written `$%: type`",
                                      declared.tok.text, declared.tok.text));
            array_add(&params, new_node(declared.tok, .Param(declared, null, true, false)));
            if (!eat(p, .Comma))
                break;
            continue;
        }
        let param_name = expect(p, .Identifier, "a parameter name");
        expect(p, .Colon, "`:` and a type after the parameter name");
        if (at(p, .Ellipsis2)) {
            // args: ..Any takes any number of arguments, as a []Any; none is
            // an empty slice
            let dots = next(p);
            let declared = new_node(dots, .TypeSlice(type_(p)));
            let empty = new_node(dots, .ArrayLiteral(null, .[]));
            array_add(&params, new_node(param_name, .Param(declared, empty, false, true)));
            if (eat(p, .Comma) && !at(p, .RParen))
                fail(p, peek(p), "the `..` parameter must be the last one");
            break;
        }
        let declared = type_(p);
        let value: *Node = null;
        if (eat(p, .Equal))
            value = expr(p);
        array_add(&params, new_node(param_name, .Param(declared, value, false, false)));
        if (!eat(p, .Comma))
            break;
    }
    expect(p, .RParen, "`)` to close the parameter list");

    let result: *Node = null;
    let defaults: [..]*Node;
    if (eat(p, .Arrow))
        result = declared_results(p, &defaults);

    // fn name(...) #expand { ... } is a macro
    // fn print(fmt: string, args: ..Any) #format: calls get their format
    // string checked against their values
    // fn write_file(...) -> IoError #nodiscard: a call can't drop its result
    // fn sum(xs: []i64) -> i64 #no_bounds_check { ... }: its indexing and
    // slicing aren't checked (unless the build says always)
    // These come in any order, before `#expand`.
    let format, nodiscard, no_bounds_check, symmetric = false, false, false, false;
    let no_checks: Token;
    // fn strlen(s: *u8) -> usize #foreign libc: C's, from a library
    // fn by_name(a: *void, b: *void) -> int #c_call { ... }: ours, for C to
    // call (C's calling convention, no context)
    let foreign, c_call: Token;
    let library: *Node = null;
    let link_name = "";
    while (true) {
        if (at_directive(p, "foreign") || at_directive(p, "c_call")) {
            let t = directive(p);
            let is_foreign = t.text == "#foreign";
            if (extern_keyword)
                fail(p, t, tformat("`extern` and `%` both say C's calling convention: leave out `extern`", t.text));
            if (foreign.text.len > 0 || c_call.text.len > 0)
                fail(p, t, "a function is either C's (`#foreign`, with no body) or ours for C to call (`#c_call`, with a body), not both");
            if (is_foreign) {
                foreign = t;
                library, link_name = foreign_spec(p);
            } else {
                c_call = t;
            }
            is_extern = true; // C's calling convention
        } else if (at_directive(p, "symmetric")) {
            // fn operator *(v: Vec2, k: f64) #symmetric: also k * v
            let hash = next(p);
            next(p);
            symmetric = true;
            if (params.len != 2)
                fail(p, hash, tformat("`#symmetric` takes a function's two parameters either way round; `%` has %",
                                      name.text, params.len));
        } else if (at_directive(p, "format")) {
            next(p);
            next(p);
            format = true;
        } else if (at_directive(p, "nodiscard")) {
            let hash = next(p);
            next(p);
            nodiscard = true;
            if (result == null)
                fail(p, hash, "`#nodiscard` is for a function that returns a value; this one returns nothing");
        } else if (at_directive(p, "no_bounds_check")) {
            no_checks = next(p);
            next(p);
            no_bounds_check = true;
        } else {
            break;
        }
    }

    if (variadic && !is_extern)
        fail(p, dots, tformat("only C functions can be variadic: `fn %(...) #foreign lib;`", name.text));

    let is_macro = false;
    if (at_directive(p, "expand")) {
        let hash = next(p);
        next(p);
        if (no_bounds_check)
            fail(p, no_checks, "a macro's code runs in its caller, so it's checked as its caller is; `#no_bounds_check` goes on the caller");
        if (is_extern)
            fail(p, hash, "a C function (`#foreign` or `#c_call`) can't be `#expand`: C calls it, and a macro is only expanded");
        let last_variadic = params.len > 0 && params[params.len - 1].kind is .Param{variadic: true};
        if (variadic || last_variadic)
            fail(p, hash, "an `#expand` function can't be variadic");
        is_macro = true;
        if (!at(p, .LBrace))
            fail(p, peek(p), tformat("expected the body of the `#expand` function, found %", describe(peek(p))));
    }

    let body: *Node = null;
    if (at(p, .LBrace) && foreign.text.len > 0) {
        fail(p, peek(p), "a `#foreign` function is C's, defined in its library, so it has no body: end it with `;`");
    } else if (at(p, .LBrace)) {
        body = block(p);
    } else if (c_call.text.len > 0) {
        fail(p, peek(p), tformat("a `#c_call` function is ours, for C to call, so it needs a body `{`, found %; a C function from a library is `#foreign lib;`",
                                 describe(peek(p))));
    } else if (is_extern) {
        if (no_bounds_check)
            fail(p, no_checks, "`#no_bounds_check` is for a function with a body; C's own code isn't checked");
        expect(p, .Semicolon, "a function body or `;`");
    } else {
        fail(p, peek(p), tformat("expected a function body `{`, found % (only C's functions, `#foreign`, have none)", describe(peek(p))));
    }
    if (extern_keyword && body != null)
        fail(p, extern_token, tformat("`extern` is gone: a function C calls is `fn %(...) #c_call { ... }`", name.text));
    if (extern_keyword)
        fail(p, extern_token, tformat("`extern` is gone: a C function names its library, `fn %(...) #foreign libc;` (`libc` comes from `#import \"std/c\";`)",
                                      name.text));
    if (variadic && body != null)
        fail(p, dots, "Sabk code can't read C's `...`, so a function with a body can't take it: take `args: ..Any`, or declare C's function `#foreign`");
    let fun = new_node(name, .Fn(params, result, body, is_extern, is_macro,
                                 variadic, format, nodiscard, no_bounds_check));
    if (fun.kind is .Fn{symmetric: &s, foreign: &lib, link_name: &c_name}) {
        s.* = symmetric;
        lib.* = library;
        c_name.* = link_name;
    }
    for (d in defaults) {
        if (d == null)
            continue;
        if (is_extern || is_macro)
            fail(p, d.tok, tformat("a result's default is for a function with a body that returns; % can't have one",
                                   if (is_extern) "a C function" else "an `#expand` function"));
        if (fun.kind is .Fn{result_defaults: &list})
            list.* = defaults;
        break;
    }
    return fun;
}

// what follows a declaration's `->`: one type or several, each with an
// optional default, `-> (i64, ParseError = .None)`. The parentheses are
// optional (`-> i64, bool {`): the body or `;` ends the list.
fn declared_results(p: *Parser, defaults: *[..]*Node) -> *Node {
    let open = peek(p);
    let grouped = eat(p, .LParen);
    let items: [..]*Node;
    while (true) {
        array_add(&items, type_(p));
        // `.None {` is the default and then the body, not a variant's fields
        array_add(defaults, if (eat(p, .Equal)) bare_expr(p) else null);
        if (!eat(p, .Comma))
            break;
    }
    if (grouped)
        expect(p, .RParen, "`,` or `)` after the result types");
    if (items.len == 1)
        return items[0];
    return new_node(if (grouped) open else items[0].tok, .TypeTuple(items));
}

// `operator +`: a function named by an operator it gives a meaning to
fn at_operator_name(p: *Parser) -> bool {
    return at(p, .Identifier) && peek(p).text == "operator" && !at(p, .LParen, 1);
}

// the operator after `operator`, as the function's name: `+`, `==`,
// `[]`, `[]=` (one token, written without spaces)
fn operator_name(p: *Parser) -> Token {
    next(p); // operator
    let t = next(p);
    switch (t.kind) {
    case .Plus, .Minus, .Star, .Slash, .Percent, .Amp, .Pipe, .Caret, .Shl, .Shr, .EqualEq, .BangEq:
        return t;
    case .LBracket:
        let close = expect(p, .RBracket, "`]` in `operator []`");
        let name = joined(t, close);
        if (at(p, .Equal) && peek(p).text.ptr == close.text.ptr + 1)
            name = joined(name, next(p)); // []=
        if (name.text.len != 2 && name.text.len != 3)
            fail(p, t, "write `operator []` or `operator []=` without spaces");
        return name;
    default:
        fail(p, t, tformat("`operator %` can't be given a meaning; the ones that can are + - * / %% & | ^ << >> == != [] []=",
                           t.text));
        return t;
    }
}

// a generic declaration's ($A, $B)
fn type_params(p: *Parser) -> [..]*Node {
    let params: [..]*Node;
    if (eat(p, .LParen)) {
        while (!at(p, .RParen)) {
            expect(p, .Dollar, "`$` and a type parameter name");
            array_add(&params, new_node(expect(p, .Identifier, "a type parameter name"), .TypeParam));
            if (!eat(p, .Comma))
                break;
        }
        expect(p, .RParen, "`,` or `)` after the type parameters");
    }
    return params;
}

fn aggregate(p: *Parser, is_union: bool) -> *Node {
    let keyword = next(p); // struct / union
    let name = expect(p, .Identifier, "a name");
    let params = type_params(p); // a generic struct: struct List($T) { ... }
    // struct EpollEvent #packed { ... }, struct Vec4 #align(16) { ... }:
    // the struct's own layout, in either order
    let packed = false;
    let align: *Node = null;
    while (at(p, .Hash)) {
        let t = directive(p);
        if (t.text == "#packed") {
            if (packed)
                fail(p, t, "`#packed` is here twice");
            packed = true;
        } else if (t.text == "#align") {
            if (align != null)
                fail(p, t, "`#align` is here twice");
            expect(p, .LParen, "`(` and the alignment after `#align`, like `#align(16)`");
            align = expr(p);
            expect(p, .RParen, "`)` after the alignment");
        } else {
            fail(p, t, tformat("unknown directive `%` on a %; its layout takes `#packed` and `#align(n)`", t.text, keyword.text));
        }
    }
    expect(p, .LBrace, "`{` to start the fields");
    let fields: [..]*Node;
    while (!at(p, .RBrace)) {
        let field = field_name(p, "a field name");
        expect(p, .Colon, "`:` and a type after the field name");
        let declared = type_(p);
        let value: *Node = null;
        if (eat(p, .Equal))
            value = expr(p);
        if (at_directive(p, "align") || at_directive(p, "packed"))
            fail(p, peek(p), tformat("`%` goes on the %, after its name: `% % %{} { ... }`; a field takes its type's alignment (to align one, give it a struct type with `#align`)",
                                     directive_text(p), keyword.text, keyword.text, name.text,
                                     if (at_directive(p, "align")) "#align(16)" else "#packed"));
        expect(p, .Semicolon, "`;` after the field");
        array_add(&fields, new_node(field, .Field(declared, value)));
    }
    next(p); // }
    let n = new_node(name, .Struct(fields, params, is_union));
    if (n.kind is .Struct{packed: &pk, align: &al}) {
        pk.* = packed;
        al.* = align;
    }
    return n;
}

// `#align` at the parser's position, as written, without taking it
fn directive_text(p: *Parser) -> string { return tformat("#%", peek(p, 1).text); }

fn enum_decl(p: *Parser) -> *Node {
    next(p); // enum
    let name = expect(p, .Identifier, "an enum name");
    let params = type_params(p); // a generic tagged enum: enum Option($T) { ... }
    let backing: *Node = null;
    if (eat(p, .Colon))
        backing = type_(p);
    expect(p, .LBrace, "`{` to start the variants");
    let variants: [..]*Node;
    // enum IoError: Error { ... }: an error enum, whose None (no failure)
    // comes from Error, at 0
    let error_enum = backing != null && backing.kind.tag == .TypeName && backing.tok.text == "Error" &&
                     type_args_count(backing) == 0;
    if (error_enum) {
        let none = backing.tok;
        none.text = "None";
        array_add(&variants, new_node(none, .Variant(null, null, null)));
    }
    while (!at(p, .RBrace)) {
        let variant = expect(p, .Identifier, "a variant name");
        if (error_enum && variant.text == "None")
            fail(p, variant, "an error enum's `None` (no failure) comes from `Error`, at 0: leave it out");
        let payload: *Node = null;
        let fields: *Node = null;
        let value: *Node = null;
        if (eat(p, .LParen)) {
            // a payload: Number(i64), or fields: Binary(op: Op, lhs: *Expr)
            if (at_field_name(p) && at(p, .Colon, 1)) {
                let list: [..]*Node;
                while (!at(p, .RParen)) {
                    let field = field_name(p, "a field name");
                    expect(p, .Colon, "`:` and a type after the field name");
                    let declared = type_(p);
                    let field_value: *Node = null;
                    if (eat(p, .Equal))
                        field_value = expr(p);
                    array_add(&list, new_node(field, .Field(declared, field_value)));
                    if (!eat(p, .Comma))
                        break;
                }
                fields = new_node(variant, .Struct(list, .[], false));
            } else {
                payload = type_(p);
            }
            expect(p, .RParen, "`)` after the variant's payload");
        }
        if (eat(p, .Equal))
            value = expr(p);
        array_add(&variants, new_node(variant, .Variant(payload, fields, value)));
        if (!eat(p, .Comma))
            break;
    }
    expect(p, .RBrace, "`,` or `}` after the variant");
    return new_node(name, .Enum(backing, variants, params));
}

fn type_args_count(n: *Node) -> isize {
    if (n.kind is .TypeName{args})
        return args.len;
    return 0;
}

fn const_decl(p: *Parser) -> *Node {
    next(p); // const
    let name = expect(p, .Identifier, "a constant name");
    let declared: *Node = null;
    if (at(p, .Colon) && at(p, .Type, 1)) {
        // const Names: type = Map(string, i64); its value is a type, so
        // it's another name for that type
        next(p);
        next(p);
        expect(p, .Equal, "`=` and a type (a constant needs a value)");
        let aliased = type_(p);
        expect(p, .Semicolon, "`;` after the constant");
        return new_node(name, .TypeAlias(aliased));
    }
    if (eat(p, .Colon))
        declared = type_(p);
    expect(p, .Equal, "`=` and a value (a constant needs a value)");
    if (at_directive(p, "library") || at_directive(p, "system_library")) {
        let t = directive(p);
        if (declared != null)
            fail(p, declared.tok, tformat("a library has no type: `const % = %{} \"...\";`", name.text, t.text));
        let lib = library_decl(p, name, t);
        expect(p, .Semicolon, "`;` after the library");
        return lib;
    }
    let value = expr(p);
    expect(p, .Semicolon, "`;` after the constant");
    return new_node(name, .Const(declared, value));
}

// what follows `#library` or `#system_library`: options after commas
// (`,link_always`), then the file's name without its extension
fn library_decl(p: *Parser, name: Token, directive: Token) -> *Node {
    let link_always = false;
    while (eat(p, .Comma)) {
        let option = expect(p, .Identifier, tformat("an option after `%{},`", directive.text));
        if (option.text != "link_always")
            fail(p, option, tformat("`%{}` has no option `%`; the only one is `link_always` (linked even when nothing uses the library)",
                                    directive.text, option.text));
        link_always = true;
    }
    let example = if (directive.text == "#library") "\"vendor/libraylib\"" else "\"libm\"";
    let path = expect(p, .String, tformat("the library's file after `%`, without its extension: `% %`",
                                          directive.text, directive.text, example));
    if (path.text.len <= 2)
        fail(p, path, tformat("a library needs its file's name: `% %`", directive.text, example));
    return new_node(name, .Library(path, directive.text == "#system_library", link_always));
}

// after `#foreign`: the library's name and the C name, both optional
// (`#foreign`, `#foreign libc`, `#foreign libm "sinf"`); the library can
// be another module's (`#foreign rl.raylib`)
fn foreign_spec(p: *Parser) -> (*Node, string) {
    let library: *Node = null;
    if (at(p, .Identifier)) {
        library = new_node(next(p), .Identifier);
        if (at(p, .Period) && at(p, .Identifier, 1)) {
            next(p);
            library = new_node(next(p), .Member(library));
        }
    }
    let link_name = "";
    if (at(p, .String)) {
        let t = next(p);
        link_name = t.text[1..t.text.len - 1];
        if (link_name.len == 0)
            fail(p, t, "the C name is empty: leave it out to use the Sabk name");
    }
    return library, link_name;
}

// `let environ: **char #foreign libc;`: a variable C defines
fn foreign_let(p: *Parser, decl: *Node) {
    let t = directive(p);
    let library, link_name = foreign_spec(p);
    if (decl.kind is .Let{declared, value, is_extern: &e, foreign: &lib, link_name: &c_name, uninit}) {
        if (declared == null)
            fail(p, t, tformat("a `#foreign` variable needs its type: `let %: T #foreign lib;`", decl.tok.text));
        if (value != null || uninit)
            fail(p, if (value != null) value.tok else t, "a `#foreign` variable has no value here: C defines it");
        e.* = true;
        lib.* = library;
        c_name.* = link_name;
    }
}

// `let ...` without its `;`
fn let_decl(p: *Parser) -> *Node {
    next(p); // let
    let name = expect(p, .Identifier, "a variable name after `let`");
    if (at(p, .Comma)) {
        // let q, r = divide(a, b); several names, from several values
        let names: [..]*Node;
        array_add(&names, new_node(name, .Let(null, null, false, false)));
        while (eat(p, .Comma))
            array_add(&names, new_node(expect(p, .Identifier, "a variable name"),
                                       .Let(null, null, false, false)));
        if (eat(p, .Colon)) {
            // let a, b: T; several names of one type, each starting as
            // its zero (or defaults)
            let declared = type_(p);
            for (i in 0..names.len) {
                let d = names[i];
                if (d.tok.text == "_")
                    fail(p, d.tok, "`_` declares nothing, so it has no place in a list of names with a type");
                d.kind = .Let(if (i == 0) declared else clone_node(declared, -1), null, false, false);
            }
            if (at(p, .Equal))
                fail(p, peek(p), "names declared with a type start as its zero; to give them values, leave out the type (`let a, b = x, y;`) or declare them one at a time");
            return new_node(name, .LetValues(names, null));
        }
        expect(p, .Equal, "`=` and the values");
        return new_node(name, .LetValues(names, values(p)));
    }
    let declared: *Node = null;
    let value: *Node = null;
    let uninit = false;
    if (eat(p, .Colon))
        declared = type_(p);
    if (eat(p, .Equal)) {
        if (at(p, .TripleDash)) { // let buf: [4096]u8 = ---; left as it is
            let dashes = next(p);
            uninit = true;
            if (declared == null)
                fail(p, dashes, tformat("`---` gives `%` no value to take a type from; give it one: `let %: T = ---;`",
                                        name.text, name.text));
        } else {
            value = values(p);
        }
    }
    if (declared == null && value == null && !uninit && at_directive(p, "foreign"))
        fail(p, name, tformat("a `#foreign` variable needs its type: `let %: T #foreign lib;`", name.text));
    if (declared == null && value == null && !uninit)
        fail(p, name, "`let` needs a type, an initializer, or both");
    return new_node(name, .Let(declared, value, false, uninit));
}

// one expression, or several separated by commas: `a, b`
fn values(p: *Parser) -> *Node {
    let first = expr(p);
    if (!at(p, .Comma))
        return first;
    let items: [..]*Node;
    array_add(&items, first);
    while (eat(p, .Comma))
        array_add(&items, expr(p));
    return new_node(first.tok, .Values(items));
}

/* ------------------------------------------------------------ statements */

fn block(p: *Parser) -> *Node {
    let open = expect(p, .LBrace, "`{`");
    let saved = p.bare_condition; // a `for` header's ends here
    p.bare_condition = false;
    defer p.bare_condition = saved;
    let stmts: [..]*Node;
    while (!at(p, .RBrace)) {
        if (at(p, .Eof))
            fail(p, open, "this `{` is never closed");
        array_add(&stmts, stmt(p));
    }
    next(p); // }
    return new_node(open, .Block(stmts, null, false));
}

fn stmt(p: *Parser) -> *Node {
    let t = peek(p);
    // `outer: for (...)`: a label on a loop, a switch or a block
    if (t.kind == .Identifier && at(p, .Colon, 1) &&
        (at(p, .For, 2) || at(p, .While, 2) || at(p, .Do, 2) ||
         at(p, .Switch, 2) || at(p, .LBrace, 2))) {
        let label = new_node(next(p), .Identifier);
        next(p); // :
        let n = stmt(p);
        switch (n.kind) {
        case .Block{label: &l}: l.* = label;
        case .While{label: &l}: l.* = label;
        case .DoWhile{label: &l}: l.* = label;
        case .For{label: &l}: l.* = label;
        case .ForIn{label: &l}: l.* = label;
        case .Switch{label: &l}: l.* = label;
        default:
        }
        return n;
    }
    switch (t.kind) {
    case .LBrace:
        return block(p);

    case .Let:
        let n = let_decl(p);
        expect(p, .Semicolon, "`;` after the declaration");
        return n;

    case .Const:
        let c = const_decl(p);
        if (c.kind.tag == .Library)
            fail(p, c.tok, tformat("a library is declared at the top level, where C functions can name it: move `const % = ...;` out of the function",
                                   c.tok.text));
        return c;

    case .If:
        next(p);
        let cond, then = condition_and_body(p, "if");
        let else_: *Node = null;
        if (eat(p, .Else))
            else_ = stmt(p);
        return new_node(t, .If(cond, then, else_, false));

    case .While:
        next(p);
        let cond, body = condition_and_body(p, "while");
        return new_node(t, .While(cond, body, null));

    case .Do:
        next(p);
        let body = stmt(p);
        expect(p, .While, "`while` after the `do` body");
        let cond = condition(p, "while");
        expect(p, .Semicolon, "`;` after `do ... while (...)`");
        return new_node(t, .DoWhile(body, cond, null));

    case .For:
        return for_stmt(p);

    case .Switch:
        next(p);
        return switch_body(p, t, false, null);

    case .Return:
        next(p);
        let value: *Node = null;
        if (!at(p, .Semicolon))
            value = values(p); // return q, r;
        expect(p, .Semicolon, "`;` after `return`");
        return new_node(t, .Return(value));

    case .Break, .Continue:
        // break; break outer; continue outer; continue state = .Next;
        // break value = 1; (a labeled block's or switch expression's value)
        next(p);
        let label: *Node = null;
        let value: *Node = null;
        if (at(p, .Identifier)) {
            label = new_node(next(p), .Identifier);
            if (eat(p, .Equal))
                value = expr(p);
        }
        expect(p, .Semicolon, "`;`");
        if (t.kind == .Break)
            return new_node(t, .Break(label, value));
        return new_node(t, .Continue(label, value));

    case .Defer:
        next(p);
        return new_node(t, .Defer(stmt(p)));

    case .Hash:
        if (at_directive(p, "assert"))
            return static_assert(p);
        // #if (condition known at compile time) stmt [else stmt]
        if (at_directive(p, "if")) {
            next(p);
            let if_tok = next(p);
            expect(p, .LParen, "`(` after `#if`");
            let cond = expr(p);
            expect(p, .RParen, "`)` after the condition");
            let then = stmt(p);
            let else_: *Node = null;
            if (eat(p, .Else))
                else_ = stmt(p);
            return new_node(if_tok, .StaticIf(cond, then, else_));
        }
        // `#insert #run f();`: statements made from a string, in place
        if (at_directive(p, "insert") && !at(p, .Identifier, 2)) {
            let d = directive(p);
            let value = expr(p);
            expect(p, .Semicolon, "`;` after `#insert`");
            return new_node(d, .InsertString(value));
        }
        // `#insert body;` on its own; `#insert a = ...;` is an expression
        if (at_directive(p, "insert") && at(p, .Identifier, 2) && at(p, .Semicolon, 3)) {
            next(p);
            next(p);
            let code = expect(p, .Identifier, "a Code parameter after `#insert`");
            expect(p, .Semicolon, "`;` after `#insert`");
            return new_node(code, .Insert);
        }

    case .Backtick:
        // `let, `const, `defer and `return act on the macro's caller
        if (at(p, .Let, 1) || at(p, .Const, 1) || at(p, .Defer, 1) || at(p, .Return, 1)) {
            next(p);
            let n = stmt(p);
            n.caller = true;
            return n;
        }

    default:
    }

    let n = simple_stmt(p);
    // m(args) { ... }: a block after a call is its last argument
    if (n.kind is .ExprStmt{value} && value.kind.tag == .Call && at(p, .LBrace)) {
        let body = block(p);
        body.span = span_from(p, body.tok.text.ptr);
        switch (value.kind) {
        case .Call{&args, &trailing_block}:
            let more: [..]*Node;
            array_append(&more, args.*);
            array_add(&more, body);
            args.* = more;
            trailing_block.* = true;
        default:
        }
        return n;
    }
    expect(p, .Semicolon, "`;` after the statement");
    return n;
}

// the condition after `if`, `while` or `switch`: `(x)` as in C, or `x`
// alone. A `(` is the whole condition unless the condition goes on after
// its `)`: `if (a + b) * 2 > c { ... }`.
fn condition(p: *Parser, what: string) -> *Node {
    if (!parenthesized(p))
        return bare_expr(p);
    expect(p, .LParen, tformat("`(` after `%`", what));
    let cond = expr(p);
    expect(p, .RParen, "`)` after the condition");
    return cond;
}

// `if (x) stmt` takes any statement; `if x { ... }` takes a block, so the
// condition can't run into it (`if done -count;`); `if x then stmt` takes
// any statement after the `then`
fn condition_and_body(p: *Parser, what: string) -> (*Node, *Node) {
    let parens = parenthesized(p);
    let begin = peek(p).text.ptr;
    let cond = condition(p, what);
    if (what == "if" && at_then(p)) {
        let then_tok = next(p);
        if (!then_ends_well(p, then_tok))
            return cond, null;
        return cond, stmt(p);
    }
    if (at_then(p))
        return cond, fail(p, peek(p), tformat("`then` only goes with `if`; `%`'s body is a block, or put the condition in parentheses", what));
    if (!parens && !at(p, .LBrace)) {
        let or_then = if (what == "if") ", or a statement after `then`" else "";
        return cond, fail(p, peek(p), tformat("`{` after the condition `%`: without parentheses, `%`'s body is a block%",
                                              span_from(p, begin), what, or_then));
    }
    return cond, stmt(p);
}

// `then` right after an `if`'s condition ends it (Jai's): `if done then
// return;`. Anywhere else it's an ordinary name.
fn at_then(p: *Parser, k: isize = 0) -> bool {
    let t = peek(p, k);
    return t.kind == .Identifier && t.text == "then";
}

// after `if c then`: a value or a statement. `then` right there is always
// the separator, so `if (c) then else x` with a variable named `then`
// is a mistake to point out.
fn then_ends_well(p: *Parser, then_tok: Token) -> bool {
    let after = peek(p).kind;
    if (after != .Else && after != .Semicolon && !is_assign_op(after))
        return true;
    fail(p, then_tok, "`then` after a condition separates it from what follows; for a variable named `then` here, write `(then)`");
    return false;
}

// in a value `if` starting with `(`: does a `then` end the condition, as
// in `if (a + b) > 2 then x else y`? Looked for up to its `else` (or an
// inner `if`, which has its own).
fn then_before_else(p: *Parser) -> bool {
    let depth = 0;
    let i: isize = 0;
    while (true) {
        let kind = peek(p, i).kind;
        if (depth == 0) {
            if (at_then(p, i))
                return true;
            if (kind == .Else || kind == .If || kind == .Semicolon || kind == .Comma || kind == .Eof)
                return false;
        }
        if (kind == .LBrace || kind == .LParen || kind == .LBracket)
            depth += 1;
        if (kind == .RBrace || kind == .RParen || kind == .RBracket) {
            depth -= 1;
            if (depth < 0)
                return false;
        }
        i += 1;
    }
}

// the `{` at `k` after a name, in a condition without parentheses: are the
// braces the name's (a variant literal's fields, `K.Let{ .declared = 1 }`,
// or a pattern's bindings, `is .Circle{r}`) rather than the body? They are
// when what follows them can't follow a body (another `{`, `then`, an
// operator) and they hold no statements. `if x {} { ... }`, a body then a
// block, is the one way to get it wrong, and the checker reports it.
fn braces_are_names(p: *Parser, k: isize) -> bool {
    let first = peek(p, k + 1).kind;
    switch (first) {
    case .LBrace, .While, .For, .Do, .Return, .Let, .Const, .Defer, .Break, .Continue, .Case, .Default:
        return false; // a statement
    default:
    }
    let depth = 0;
    let i = k;
    while (true) {
        let kind = peek(p, i).kind;
        if (kind == .Eof)
            return false;
        if (kind == .LBrace || kind == .LParen || kind == .LBracket)
            depth += 1;
        if (kind == .RBrace || kind == .RParen || kind == .RBracket) {
            depth -= 1;
            if (depth == 0)
                break;
        }
        if (kind == .Semicolon && depth == 1)
            return false; // a statement
        i += 1;
    }
    let after = peek(p, i + 1).kind;
    return after == .LBrace || at_then(p, i + 1) || binary_prec(after) > 0;
}

// an expression a block follows: `x {` ends at the `{`, which isn't a
// literal's (`Vec2{`, `K.Let{`)
fn bare_expr(p: *Parser) -> *Node {
    let saved = p.bare_condition;
    p.bare_condition = true;
    let e = expr(p);
    p.bare_condition = saved;
    return e;
}

// is there a `(` here that holds the whole condition?
fn parenthesized(p: *Parser) -> bool {
    if (!at(p, .LParen))
        return false;
    let depth = 0;
    let k: isize = 0;
    while (true) {
        let kind = peek(p, k).kind;
        if (kind == .Eof)
            return true; // unclosed: the `)` is reported missing
        if (kind == .LParen)
            depth += 1;
        if (kind == .RParen) {
            depth -= 1;
            if (depth == 0)
                break;
        }
        k += 1;
    }
    let after = peek(p, k + 1).kind;
    if (after == .LParen)
        return !reaches_block(p, k + 1);
    let goes_on = binary_prec(after) > 0 || (after == .Bang && at(p, .Is, k + 2)) ||
                  after == .Period || after == .LBracket || after == .As ||
                  after == .OrReturn;
    return !goes_on;
}

// a `(` after the condition's `)`: the body, `if (k == .F32) (p as *f32).*
// = v;`, when a `;` or an assignment comes first; the condition going on,
// `if (get())(n) > 4 {`, when a block or `then` does. (A block after a
// call in parentheses can't be a macro's trailing one: those are called by
// name.)
fn reaches_block(p: *Parser, k: isize) -> bool {
    let depth = 0;
    let i = k;
    while (true) {
        let t = peek(p, i);
        let kind = t.kind;
        if (kind == .Eof)
            return false;
        if (depth == 0) {
            if (kind == .Semicolon || is_assign_op(kind) || kind == .RBrace)
                return false;
            if (at_then(p, i) || (kind == .LBrace && peek(p, i - 1).kind != .Period))
                return true;
        }
        if (kind == .LBrace || kind == .LParen || kind == .LBracket)
            depth += 1;
        if (kind == .RBrace || kind == .RParen || kind == .RBracket)
            depth -= 1;
        i += 1;
    }
}

fn is_assign_op(kind: TokenKind) -> bool {
    switch (kind) {
    case .Equal, .PlusEq, .MinusEq, .StarEq, .SlashEq, .PercentEq, .AmpEq,
         .PipeEq, .CaretEq, .ShlEq, .ShrEq:
        return true;
    default:
        return false;
    }
}

fn simple_stmt(p: *Parser) -> *Node {
    let start = peek(p);
    p.statement_head = true;
    let e = expr(p);

    if (at(p, .Comma)) {
        // a, b = b, a; or several results: q, r = divide(a, b)
        let targets: [..]*Node;
        array_add(&targets, e);
        while (eat(p, .Comma))
            array_add(&targets, expr(p));
        if (is_assign_op(peek(p).kind) && !at(p, .Equal))
            fail(p, peek(p), "only `=` assigns to several targets at once");
        let op = expect(p, .Equal, "`=` after the targets");
        return new_node(op, .Assign(new_node(e.tok, .Values(targets)), values(p)));
    }
    // `_ = f();` drops a value on purpose, even a #nodiscard one
    if (at(p, .Equal) && e.kind.tag == .Identifier && e.tok.text == "_") {
        next(p);
        let value = expr(p);
        if (at(p, .Comma))
            fail(p, peek(p), "`_ =` drops one value, or all of one call's results; for several values, give each a target: `_, _ = a, b;`");
        return new_node(start, .ExprStmt(value, true));
    }
    if (is_assign_op(peek(p).kind)) {
        let op = next(p);
        return new_node(op, .Assign(e, values(p)));
    }
    if (at(p, .PlusPlus))
        return new_node(next(p), .Inc(e));
    if (at(p, .MinusMinus))
        return new_node(next(p), .Dec(e));
    return new_node(start, .ExprStmt(e, false));
}

fn for_stmt(p: *Parser) -> *Node {
    let t = next(p); // for
    // `for (x in xs) stmt`, or `for x in xs { ... }` without parentheses
    let parens = eat(p, .LParen);
    let saved = p.bare_condition;
    p.bare_condition = !parens;
    defer p.bare_condition = saved;

    // for (x in xs) / for (x, i in xs), with its index / for (i in a..b)
    let indexed = at(p, .Identifier) && at(p, .Comma, 1) && at(p, .Identifier, 2) && at(p, .In, 3);
    if ((at(p, .Identifier) && at(p, .In, 1)) || indexed) {
        let name = next(p);
        let index: *Node = null;
        if (indexed) {
            next(p); // ,
            index = new_node(next(p), .LoopIndex);
        }
        next(p); // in
        let iterable = expr(p);
        let range_end: *Node = null;
        if (eat(p, .Ellipsis2)) {
            range_end = expr(p);
            if (index != null)
                fail(p, index.tok, tformat("a loop over a range takes one name: `%` would only count what `%` counts",
                                           index.tok.text, name.text));
        }
        let body = loop_body(p, parens);
        return new_node(name, .ForIn(iterable, range_end, body, null, index));
    }

    // for (init; cond; step)
    let init: *Node = null;
    let cond: *Node = null;
    let step: *Node = null;
    if (at(p, .Let))
        init = let_decl(p);
    else if (!at(p, .Semicolon))
        init = simple_stmt(p);
    expect(p, .Semicolon, "`;` after the loop initializer");
    if (!at(p, .Semicolon))
        cond = expr(p);
    expect(p, .Semicolon, "`;` after the loop condition");
    if (!at(p, if (parens) TokenKind.RParen else TokenKind.LBrace))
        step = simple_stmt(p);
    let body = loop_body(p, parens);
    return new_node(t, .For(init, cond, step, body, null));
}

// after a loop header: `)` and any statement, or a block
fn loop_body(p: *Parser, parens: bool) -> *Node {
    if (parens) {
        expect(p, .RParen, "`)` after the loop header");
        return stmt(p);
    }
    if (!at(p, .LBrace))
        return fail(p, peek(p), "`{` after the loop header: without parentheses, `for`'s body is a block");
    return stmt(p);
}

// does a pattern bind names? (`_` doesn't)
fn binds_names(pattern: *Node) -> bool {
    switch (pattern.kind) {
    case .Binding: return pattern.tok.text != "_";
    case .FieldPattern{pattern: inner}: return binds_names(inner);
    case .VariantPattern{bindings}:
        for (b in bindings)
            if (binds_names(b))
                return true;
        return false;
    default:
        return false;
    }
}

// `(value) { case ...: ... }`, after `switch`; as an expression each case
// gives a value
fn switch_body(p: *Parser, t: Token, gives_value: bool, label: *Node) -> *Node {
    let value = condition(p, "switch");
    expect(p, .LBrace, "`{` to start the cases");

    let cases: [..]*Node;
    while (!at(p, .RBrace)) {
        let head = peek(p);
        let patterns: [..]*Node;
        let guard: *Node = null;
        let is_default = false;
        if (eat(p, .Case)) {
            // a constant can use any operator but `&&` and `||`: case A | B:
            array_add(&patterns, pattern(p, BIT_OR_PREC));
            while (eat(p, .Comma))
                array_add(&patterns, pattern(p, BIT_OR_PREC));
            if (patterns.len > 1)
                for (q in patterns)
                    if (binds_names(q))
                        fail(p, q.tok, "a case that binds a variant's value can only have that one pattern");
            if (eat(p, .If)) { // case .Number(n) if (n < 0): a guard
                expect(p, .LParen, "`(` after `if`");
                guard = expr(p);
                expect(p, .RParen, "`)` after the guard");
            }
        } else if (eat(p, .Default)) {
            is_default = true;
        } else {
            fail(p, head, tformat("expected `case` or `default`, found %", describe(head)));
        }
        expect(p, .Colon, "`:` after the case");

        let body: *Node;
        if (gives_value && label != null) {
            // a labeled switch expression's case is its value, or statements
            // that give it with `break label = value;`
            let stmts = case_stmts(p);
            if (stmts.len == 1 && stmts[0].kind is .ExprStmt{value: only})
                body = only;
            else
                body = new_node(head, .Block(stmts, null, false));
        } else if (gives_value) {
            // a case of a switch expression is its value
            body = expr(p);
            expect(p, .Semicolon, "`;` after the case's value");
            if (!at(p, .Case) && !at(p, .Default) && !at(p, .RBrace))
                fail(p, peek(p), "a switch expression's case is one value; to run statements first, label the switch (`s: switch (...)`) and give the value with `break s = value;`");
        } else {
            // a case runs until the next case, default or the closing `}`
            body = new_node(head, .Block(case_stmts(p), null, false));
        }
        if (is_default)
            array_add(&cases, new_node(head, .DefaultCase(body)));
        else
            array_add(&cases, new_node(head, .Case(patterns, guard, body)));
    }
    next(p); // }
    return new_node(t, .Switch(value, cases, label, gives_value));
}

// a case's statements: up to the next case, default or the closing `}`
fn case_stmts(p: *Parser) -> [..]*Node {
    let stmts: [..]*Node;
    while (!at(p, .Case) && !at(p, .Default) && !at(p, .RBrace))
        array_add(&stmts, stmt(p));
    return stmts;
}

// A pattern, in a case or after `is`: a value; a range, a..b or a..=b; or
// a variant, with what it holds: .V, .V(x), .V(&x), .V{a, &b, field: c}
// (also written Type.V). Its value takes operators of `min_prec` and up.
// after `is`: a value's pattern (`.Number(n)`, `IoError(e)`) or a type's
// (`[]$E`, `*$P`, `Map($K, $V)`, `enum`), told apart by how it starts; a
// name alone (`T is Map`) is either, and the resolver decides
fn is_pattern(p: *Parser) -> *Node {
    let t = peek(p);
    switch (t.kind) {
    case .Struct, .Enum, .Union:
        next(p);
        return new_node(t, .KindPattern);
    case .Fn:
        if (!at(p, .LParen, 1)) { // `T is fn`: any function type
            next(p);
            return new_node(t, .KindPattern);
        }
        return new_node(t, .TypeExpr(type_(p)));
    case .LBracket, .Dollar, .Question, .Star:
        return new_node(t, .TypeExpr(type_(p)));
    case .Identifier:
        if (type_param_ahead(p))
            return new_node(t, .TypeExpr(type_(p)));
    default:
    }
    return pattern(p, CMP_PREC + 1);
}

// `Map($K, $V)`, `lib.List($T)`: a name, then parentheses holding a `$`
fn type_param_ahead(p: *Parser) -> bool {
    let k: isize = 1;
    while (at(p, .Period, k) && at(p, .Identifier, k + 1))
        k += 2;
    if (!at(p, .LParen, k))
        return false;
    let depth = 0;
    let i = k;
    while (true) {
        let kind = peek(p, i).kind;
        if (kind == .Eof)
            return false;
        if (kind == .Dollar)
            return true;
        if (kind == .LParen)
            depth++;
        if (kind == .RParen) {
            depth--;
            if (depth == 0)
                return false;
        }
        i++;
    }
    return false;
}

fn pattern(p: *Parser, min_prec: isize) -> *Node {
    let saved = p.in_pattern;
    p.in_pattern = true;
    let n = pattern_inner(p, min_prec);
    p.in_pattern = saved;
    return n;
}

fn pattern_inner(p: *Parser, min_prec: isize) -> *Node {
    // a variant with what it holds: .V(...), .V{...}, Type.V(...)
    let k: isize = 0;
    if (at(p, .Period) && at(p, .Identifier, 1)) {
        k = 2;
    } else if (at(p, .Identifier)) {
        k = 1;
        while (at(p, .Period, k) && at(p, .Identifier, k + 1))
            k += 2;
        // IoError(e): an error enum's value out of an Error
        if (k < 3 && !(k == 1 && at(p, .LParen, 1)))
            k = 0;
    }
    // (in `if x is .V {`, the `{` is the body's; in `if x is .V{a} {`, the
    // first braces are the pattern's)
    if (k > 0 && ((at(p, .LBrace, k) && (!p.bare_condition || braces_are_names(p, k))) || at(p, .LParen, k))) {
        let variant: *Node;
        if (at(p, .Period)) {
            let dot = next(p);
            variant = new_node(joined(dot, next(p)), .EnumShorthand); // `.Binary` as one token
        } else {
            variant = new_node(next(p), .Identifier);
            while (eat(p, .Period))
                variant = new_node(next(p), .Member(variant));
        }
        if (at(p, .LBrace))
            return variant_fields(p, variant);
        expect(p, .LParen, "`(`");
        let bindings: [..]*Node;
        array_add(&bindings, subpattern(p, null));
        expect(p, .RParen, "`)` after what the variant holds");
        return new_node(variant.tok, .VariantPattern(variant, bindings, false));
    }

    let value = expr(p, min_prec);
    if (at(p, .Ellipsis2)) { // a range: a..b leaves b out, a..=b has it
        let dots = next(p);
        let inclusive = eat(p, .Equal);
        return new_node(dots, .Range(value, expr(p, min_prec), inclusive));
    }
    return value;
}

// what goes where a variant's value or field is: a name that binds it (`x`,
// `&x`, or `_` for none), or a pattern it must match. `field` is the field's
// name in .V{field: ...}
fn subpattern(p: *Parser, field: *Node) -> *Node {
    let by_ref = at(p, .Amp);
    if ((by_ref && at(p, .Identifier, 1)) ||
        (at(p, .Identifier) && !at(p, .Period, 1) && !at(p, .LParen, 1) && !at(p, .Ellipsis2, 1))) {
        if (by_ref)
            next(p);
        return new_node(next(p), .Binding(field, by_ref));
    }
    let t = if (field != null) field.tok else peek(p);
    return new_node(t, .FieldPattern(pattern_inner(p, BIT_OR_PREC), field));
}

// {a, &b, field: c, field: &d}: names for a variant's fields
fn variant_fields(p: *Parser, variant: *Node) -> *Node {
    expect(p, .LBrace, "`{`");
    let bindings: [..]*Node;
    while (!at(p, .RBrace)) {
        if (at_field_name(p) && at(p, .Colon, 1)) { // field: name or pattern
            let field = new_node(field_name(p, "a field name"), .Identifier);
            next(p);
            array_add(&bindings, subpattern(p, field));
        } else { // field, or &field: bound to its own name
            let by_ref = eat(p, .Amp);
            if (is_keyword_token(peek(p).kind))
                fail(p, peek(p), tformat("`%` is a keyword, so it can't name a variable; write `%: name`",
                                         peek(p).text, peek(p).text));
            let name = expect(p, .Identifier, "a name for the field");
            let field = new_node(name, .Identifier);
            array_add(&bindings, new_node(name, .Binding(field, by_ref)));
        }
        if (!eat(p, .Comma))
            break;
    }
    expect(p, .RBrace, "`,` or `}` after the field");
    return new_node(variant.tok, .VariantPattern(variant, bindings, true));
}

/* ----------------------------------------------------------- expressions */

// C's order. A bit operator or shift next to a different operator is an
// error without parentheses (check_mixing), so the order between them only
// decides what that error shows. 0: not a binary operator.
fn binary_prec(kind: TokenKind) -> isize {
    switch (kind) {
    case .OrElse: return 1;
    case .PipePipe: return 2;
    case .AmpAmp: return 3;
    case .Pipe: return BIT_OR_PREC;
    case .Caret: return 5;
    case .Amp: return 6;
    case .EqualEq, .BangEq, .Less, .Greater, .LessEq, .GreaterEq, .Is: return CMP_PREC;
    case .Shl, .Shr: return 8;
    case .Plus, .Minus: return 9;
    case .Star, .Slash, .Percent: return 10;
    default: return 0;
    }
}

fn binary_op(kind: TokenKind) -> BinaryOp {
    return switch (kind) {
    case .PipePipe: .Or;
    case .AmpAmp: .And;
    case .EqualEq: .EqEq;
    case .BangEq: .NotEq;
    case .Less: .Lt;
    case .Greater: .Gt;
    case .LessEq: .LtEq;
    case .GreaterEq: .GtEq;
    case .Plus: .Add;
    case .Minus: .Sub;
    case .Pipe: .BitOr;
    case .Caret: .BitXor;
    case .Star: .Mul;
    case .Slash: .Div;
    case .Percent: .Mod;
    case .Shl: .Shl;
    case .Shr: .Shr;
    default: .BitAnd; // `&`: only called when binary_prec isn't 0
    };
}

// an expression with operators of precedence `min_prec` and up
fn expr(p: *Parser, min_prec: isize = 1) -> *Node {
    let e = binary(p, min_prec);
    check_mixing(p, e);
    return e;
}

// gives `n` its source text, from `begin`, unless it has one
fn end_here(p: *Parser, n: *Node, begin: *u8) {
    if (n.span.len == 0)
        n.span = span_from(p, begin);
}

// precedence climbing; each operand and operator gets its source text, for
// check_mixing's message
fn binary(p: *Parser, min_prec: isize) -> *Node {
    let begin = peek(p).text.ptr;
    let lhs = cast(p);
    end_here(p, lhs, begin);
    while (true) {
        let prec = binary_prec(peek(p).kind);
        // `e !is .V`: not a match, as `!(e is .V)`
        let negated = at(p, .Bang) && at(p, .Is, 1);
        if (negated)
            prec = CMP_PREC;
        if (prec == 0 || prec < min_prec)
            return lhs;

        let bang = if (negated) next(p) else peek(p);
        let op = next(p);
        let n: *Node;
        if (negated) {
            let test = new_node(op, .Is(lhs, is_pattern(p)));
            end_here(p, test, begin);
            n = new_node(bang, .Unary(.Not, test));
        } else if (op.kind == .OrElse) {
            // right to left: `a() or_else b() or_else c` tries a, then b
            n = new_node(op, .OrElse(lhs, binary(p, prec)));
        } else if (op.kind == .Is) {
            // e is .Number(n): the right side is a pattern, which binds
            // tighter than comparisons, so `e is .V(x) && x > 0` ends it
            // before the `&&`
            n = new_node(op, .Is(lhs, is_pattern(p)));
        } else {
            // +1 makes operators left-associative
            n = new_node(op, .Binary(binary_op(op.kind), lhs, binary(p, prec + 1)));
        }
        end_here(p, n, begin);
        lhs = n;
        if (op.kind == .OrElse || op.kind == .Is)
            continue;
        if (prec == CMP_PREC && binary_prec(peek(p).kind) == CMP_PREC)
            fail(p, peek(p), "comparisons can't be chained, join them with `&&`");
    }
}

// ---- mixed operators

// the operators check_mixing looks at: every binary one but `&&`, `||` and
// `or_else`, whose operands are bools or several values
fn is_operator(n: *Node) -> bool {
    switch (n.kind) {
    case .Binary{op}: return op != .And && op != .Or;
    case .Is: return true;
    default: return false;
    }
}

fn is_bit_operator(n: *Node) -> bool {
    switch (n.kind) {
    case .Binary{op}:
        return op == .BitAnd || op == .BitOr || op == .BitXor || op == .Shl || op == .Shr;
    default:
        return false;
    }
}

// are they the same operator?
fn same_operator(a: *Node, b: *Node) -> bool {
    if (a.kind is .Binary{op: x} && b.kind is .Binary{op: y})
        return x == y;
    return a.kind.tag == b.kind.tag;
}

// `child`, an operand of `n`, needs parentheses: one of them is a bit
// operator or shift, and they're different operators
fn mixes(n: *Node, child: *Node) -> bool {
    return is_operator(child) && !same_operator(n, child) &&
           (is_bit_operator(n) || is_bit_operator(child));
}

// a binary operator's two sides
fn operands(n: *Node) -> (*Node, *Node) {
    switch (n.kind) {
    case .Binary{lhs, rhs}: return lhs, rhs;
    case .OrElse{value, fallback}: return value, fallback;
    case .Is{value, pattern}: return value, pattern;
    default: return null, null;
    }
}

// `n` with parentheses where it mixes operators: how it's grouped
fn grouped(n: *Node) -> string {
    if (!is_operator(n) || n.kind.tag == .Is)
        return n.span;
    let lhs, rhs = operands(n);
    return tformat("% % %", side(n, lhs), n.tok.text, side(n, rhs));
}

fn side(n: *Node, child: *Node) -> string {
    return if (mixes(n, child)) tformat("(%)", grouped(child)) else grouped(child);
}

// the first pair of operators in `n` that mix, or false
fn find_mixing(n: *Node, parent: **Node, child: **Node) -> bool {
    let joins = n.kind is .Binary{op: .And} || n.kind is .Binary{op: .Or} || n.kind.tag == .OrElse;
    if (!joins && !is_operator(n))
        return false; // a parenthesized or other expression: checked on its own
    let lhs, rhs = operands(n);
    for (c in .[lhs, rhs]) {
        if (n.kind.tag == .Is && c == rhs)
            break; // a pattern: parsed, and checked, on its own
        if (is_operator(n) && mixes(n, c)) {
            parent.* = n;
            child.* = c;
            return true;
        }
        if (find_mixing(c, parent, child))
            return true;
    }
    return false;
}

// is `inner`'s text inside `outer`'s?
fn contains_span(outer: string, inner: string) -> bool {
    return outer.ptr <= inner.ptr && inner.ptr + inner.len <= outer.ptr + outer.len;
}

// `x >> 8 * k` is an error: C reads it as `x >> (8 * k)`, which is easy to
// get wrong, so a bit operator or shift next to a different operator needs
// parentheses. One error per expression, for the part where they mix.
fn check_mixing(p: *Parser, e: *Node) {
    let parent: *Node = null;
    let child: *Node = null;
    if (!find_mixing(e, &parent, &child))
        return;
    // the whole run of operators around the pair: up to `&&`, `||`,
    // `or_else` or parentheses
    let top = e;
    while (!is_operator(top)) {
        let lhs, rhs = operands(top);
        top = if (contains_span(rhs.span, parent.span)) rhs else lhs;
    }
    // in the order they're written; the second is where the reading goes
    // wrong
    let first, second = parent.tok, child.tok;
    if (first.text.ptr > second.text.ptr)
        first, second = second, first;
    let text, as_grouped = top.span, grouped(top);
    let how = if (parent.kind.tag == .Is || child.kind.tag == .Is)
                  tformat("`%` would mean `%`", text, as_grouped)
              else
                  tformat("C reads `%` as `%`", text, as_grouped);
    report_error(p, second, tformat("`%` next to `%` needs parentheses: %", first.text, second.text, how));
}

// ---- operands

fn cast(p: *Parser) -> *Node {
    let e = unary(p);
    while (at(p, .As)) {
        let t = next(p);
        e = new_node(t, .Cast(e, type_(p)));
    }
    return e;
}

fn unary(p: *Parser) -> *Node {
    let op: UnaryOp;
    switch (peek(p).kind) {
    case .Minus: op = .Neg;
    case .Bang: op = .Not;
    case .Tilde: op = .BitNot;
    case .Star: op = .PointerType; // a type: make(*Node)
    case .Amp: op = .AddressOf;
    default: return postfix(p);
    }
    let t = next(p);
    let begin = peek(p).text.ptr;
    let operand = unary(p);
    if (op == .PointerType && operand.span.len == 0) // quoted by the resolver
        operand.span = span_from(p, begin);
    return new_node(t, .Unary(op, operand));
}

fn postfix(p: *Parser) -> *Node {
    // only the first expression of a statement is its head; anything parsed
    // inside it (arguments, operands) isn't
    let head = p.statement_head;
    p.statement_head = false;
    let begin = peek(p).text.ptr;
    let e = primary(p);
    while (true) {
        switch (peek(p).kind) {
        case .LParen:
            let open = next(p);
            let args: [..]*Node;
            let saved = p.bare_condition;
            p.bare_condition = false; // f(Vec2{...}) inside `if f(...) {`
            while (!at(p, .RParen)) {
                let arg_begin = peek(p).text.ptr;
                let arg: *Node;
                if (at(p, .Ellipsis2)) { // ..xs: a slice for a `..T` parameter
                    let dots = next(p);
                    arg = new_node(dots, .Spread(expr(p)));
                } else {
                    arg = expr(p);
                }
                arg.span = span_from(p, arg_begin);
                array_add(&args, arg);
                if (!eat(p, .Comma))
                    break;
            }
            expect(p, .RParen, "`,` or `)` in the argument list");
            p.bare_condition = saved;
            e = new_node(open, .Call(e, args, false));
        case .LBracket:
            // x[i], or a slice: x[lo..hi], where both bounds are optional
            let open = next(p);
            let lo: *Node = if (at(p, .Ellipsis2)) null else expr(p);
            if (eat(p, .Ellipsis2)) {
                let hi: *Node = if (at(p, .RBracket)) null else expr(p);
                expect(p, .RBracket, "`]` after the slice bounds");
                e = new_node(open, .Slice(e, lo, hi));
            } else {
                expect(p, .RBracket, "`]` after the index");
                e = new_node(open, .Index(e, lo));
            }
        case .OrReturn:
            // f() or_return: returns f's last value from here if it says f
            // failed
            e = new_node(next(p), .OrReturn(e));
        case .Period:
            let dot = next(p);
            if (at(p, .LBracket)) { // i64.[1, 2, 3]: e is the element type
                e = array_items(p, dot, e);
            } else if (at(p, .LBrace)) { // Point.{ .x = 1 }: e is the type
                e = init_list(p, e, false);
            } else if (at(p, .Star)) { // p.*: what p points at
                e = new_node(next(p), .Deref(e));
            } else {
                e = new_node(field_name(p, "a member name after `.`"), .Member(e));
            }
        case .LBrace:
            // `{` after a name ends the expression (`if (x) {`, and
            // `if x {` always), except C's way of writing a struct
            // literal, `Vec2{...}`, which is an error. At the head of a
            // statement, `m(x) {` is a macro call with a trailing block.
            if (p.bare_condition && !braces_are_names(p, 0))
                return e;
            let named = e.kind.tag == .Identifier || e.kind.tag == .Member;
            let generic_type = false;
            if (!head && e.kind is .Call{callee})
                generic_type = callee.kind.tag == .Identifier || callee.kind.tag == .Member;
            if (!named && !generic_type)
                return e;
            if (e.kind.tag == .Member && !head) {
                // K.Let{ .declared = t }: a variant, its fields by name (the
                // resolver says so when it's a struct written C's way)
                let lit = init_list(p, e, false);
                if (lit.kind is .StructInit{variant: &v})
                    v.* = true;
                e = lit;
                continue;
            }
            report_error(p, peek(p), tformat("a struct literal is written with a dot before the `{`: `%.{ ... }`",
                                             span_from(p, begin)));
            e = init_list(p, e, false);
        default:
            return e;
        }
    }
}

// `{ .x = 1, 2 }` after `T.` or `.`; in C's `[2]i64{1, 2}`, an array's
fn init_list(p: *Parser, declared: *Node, array: bool) -> *Node {
    let open = expect(p, .LBrace, "`{`");
    let items: [..]*Node;
    while (!at(p, .RBrace)) {
        if (at(p, .Period) && at_field_name(p, 1) && at(p, .Equal, 2)) {
            next(p); // .
            let name = field_name(p, "a field name");
            next(p); // =
            array_add(&items, new_node(name, .FieldInit(expr(p))));
        } else {
            array_add(&items, expr(p));
        }
        if (!eat(p, .Comma))
            break;
    }
    expect(p, .RBrace, "`,` or `}` in the initializer");
    if (array)
        return new_node(open, .ArrayLiteral(null, items));
    return new_node(open, .StructInit(declared, items));
}

// `[a, b, c]` after `.` or `T.`; `t` is the `.`
fn array_items(p: *Parser, t: Token, elem: *Node) -> *Node {
    expect(p, .LBracket, "`[`");
    let items: [..]*Node;
    while (!at(p, .RBracket)) {
        array_add(&items, expr(p));
        if (!eat(p, .Comma))
            break;
    }
    expect(p, .RBracket, "`,` or `]` after the element");
    return new_node(t, .ArrayLiteral(elem, items));
}

// can a type start with this token? (type_'s cases)
fn can_start_type(kind: TokenKind) -> bool {
    return kind == .Identifier || kind == .Star || kind == .LBracket ||
           kind == .Fn || kind == .Dollar || kind == .Question;
}

// with the `[` after `[x]` k tokens ahead: is it `[x][i]` with no type
// after, C's way of indexing a one-element literal, rather than an array
// type `[x][N]T`?
fn indexes_a_literal(p: *Parser, k: isize) -> bool {
    let depth = 0;
    for (i in p.idx + k..p.tokens.len) {
        if (p.tokens[i].kind == .LBracket) {
            depth++;
        } else if (p.tokens[i].kind == .RBracket) {
            depth--;
            if (depth == 0)
                return i + 1 < p.tokens.len && !can_start_type(p.tokens[i + 1].kind);
        }
    }
    return false;
}

// a [T], []T or [..]T type's element type
fn element_of(t: *Node) -> *Node {
    switch (t.kind) {
    case .TypeArray{elem}: return elem;
    case .TypeSlice{elem}: return elem;
    case .TypeDynArray{elem}: return elem;
    default: return t;
    }
}

fn primary(p: *Parser) -> *Node {
    let t = peek(p);
    switch (t.kind) {
    case .Number: return new_node(next(p), .Number);
    case .Float: return new_node(next(p), .Float);
    case .String: return new_node(next(p), .String(""));
    case .Char: return new_node(next(p), .Char);
    case .True, .False: return new_node(next(p), .Bool);
    case .Null: return new_node(next(p), .Null);
    case .Identifier:
        // `name: { ... }` and `name: switch (...) { ... }`: labeled, they
        // give a value with `break name = value;`
        if (!p.in_pattern && at(p, .Colon, 1) && (at(p, .LBrace, 2) || at(p, .Switch, 2))) {
            let label = new_node(next(p), .Identifier);
            next(p); // :
            if (at(p, .Switch))
                return switch_body(p, next(p), true, label);
            let n = block(p);
            switch (n.kind) {
            case .Block(&b):
                b.label = label;
                b.gives_value = true;
            default:
            }
            return n;
        }
        return new_node(next(p), .Identifier);
    case .If: // if (c) a else b, or if c then a else b: one of two values
        next(p);
        let cond: *Node = null;
        if (at(p, .LParen) && !then_before_else(p)) {
            // the `(` holds the whole condition: what follows is the value,
            // which may well start with `-` or `.` (`if (x < 0) -1 else 1`)
            next(p);
            cond = expr(p);
            expect(p, .RParen, "`)` after the condition");
        } else {
            let begin = peek(p).text.ptr;
            cond = bare_expr(p);
            if (!at_then(p))
                return fail(p, peek(p), tformat("`then` after the condition `%`: an `if` that gives a value is `if (c) a else b` or `if c then a else b`",
                                                span_from(p, begin)));
            let then_tok = next(p);
            if (!then_ends_well(p, then_tok))
                return new_node(then_tok, .Identifier);
        }
        let then = expr(p);
        expect(p, .Else, "`else` and a second value: an `if` that gives a value needs both");
        return new_node(t, .If(cond, then, expr(p), true));
    case .Context:
        return new_node(next(p), .Context);

    case .Period:
        // `.{ ... }`, `.[ ... ]` and `.Red`: the type comes from where
        // they're used; errors point at the `.`
        let dot = next(p);
        if (at(p, .LBrace)) {
            let n = init_list(p, null, false);
            n.tok = dot;
            return n;
        }
        if (at(p, .LBracket)) // .[1, 2, 3]
            return array_items(p, dot, null);
        let name = expect(p, .Identifier, "`{`, `[` or an enum variant after `.`");
        let shorthand = new_node(joined(dot, name), .EnumShorthand); // `.Red`: one token
        if (at(p, .LBrace) && (!p.bare_condition || braces_are_names(p, 0))) { // .Let{ .declared = t }: a variant, by its fields
            let lit = init_list(p, shorthand, false);
            if (lit.kind is .StructInit{variant: &v})
                v.* = true;
            return lit;
        }
        return shorthand;

    case .Backtick:
        // `name: the macro caller's `name`
        next(p);
        let n = new_node(expect(p, .Identifier, "a name after the backtick"), .Identifier);
        n.caller = true;
        return n;

    case .Hash:
        if (!at(p, .Identifier, 1))
            fail(p, peek(p, 1), tformat("expected a directive name after `#`, found %", describe(peek(p, 1))));
        let name = directive(p);
        let d = if (starts_with(name.text, "#")) name.text[1..] else name.text;
        if (d == "insert" && !at(p, .Identifier)) // `#insert #run f()`: code from a string
            return new_node(name, .InsertString(unary(p)));
        if (d == "insert")
            return new_node(expect(p, .Identifier, "a Code parameter after `#insert`"), .Insert);
        if (d == "run")
            return new_node(name, .Run(unary(p)));
        if (d == "caller_location") // `at: Location = #caller_location`
            return new_node(name, .CallerLocation);
        if (d == "embed")
            return embed(p, name);
        if (d == "text" || d == "location") {
            expect(p, .LParen, tformat("`(` after `#%`", d));
            let code = expect(p, .Identifier, "a Code parameter");
            expect(p, .RParen, "`)`");
            return new_node(code, if (d == "text") NodeKind.TextOf else NodeKind.LocationOf);
        }
        return fail(p, name, tformat("unknown directive `#%`", d));

    case .Switch: // a switch expression: each case gives a value
        return switch_body(p, next(p), true, null);

    case .LParen:
        let open = next(p);
        let saved = p.bare_condition;
        p.bare_condition = false;
        let inner = expr(p);
        p.bare_condition = saved;
        expect(p, .RParen, "`)` to close the parenthesis");
        return new_node(open, .Grouped(inner));

    case .TypeInfo, .Sizeof:
        // sizeof(T) or sizeof(value), as in C, and type_info the same way:
        // every type can be written as an expression, and the resolver
        // tells which it is
        next(p);
        let what = if (t.kind == .Sizeof) "sizeof" else "type_info";
        expect(p, .LParen, tformat("`(` after `%`", what));
        let of = expr(p);
        expect(p, .RParen, tformat("`)` after `%(...`", what));
        if (t.kind == .Sizeof)
            return new_node(t, .SizeOf(of));
        return new_node(t, .TypeInfo(of));

    case .New:
        // new(T [, allocator]) or new([]T, length [, allocator])
        next(p);
        expect(p, .LParen, "`(` after `new`");
        // new(Point.{ ... }), new(.{ ... }) or new(i64.[1, 2]): a value to
        // copy in
        let start = p.idx;
        let declared: *Node = null;
        let value: *Node = null;
        let first: *Node = null;
        let second: *Node = null;
        if (literal_ahead(p) || at(p, .Identifier)) {
            // a name: a type (new(Point), new(List(i32))) or a value
            // (new(Expr.Number(1)), new(make_point())); the resolver knows
            value = expr(p);
        } else {
            declared = type_(p);
            if (literal_ahead(p)) { // new([2]i64.[ ... ])
                p.idx = start;
                declared = null;
                value = expr(p);
            }
        }
        if (eat(p, .Comma))
            first = expr(p);
        if (first != null && eat(p, .Comma))
            second = expr(p);
        expect(p, .RParen, "`)` after `new(...`");
        return new_node(t, .New(declared, value, first, second));

    case .LBracket:
        return bracket(p);

    case .Fn, .Question:
        // a function type used as a type argument: make_list(fn(i32) -> bool),
        // or an option: type_info(?i64)
        return new_node(t, .TypeExpr(type_(p)));

    case .TripleDash:
        return fail(p, t, "`---` leaves a variable uninitialized, so it only goes in a local's declaration: `let buf: [4096]u8 = ---;`");

    default:
        return fail(p, t, tformat("expected an expression, found %", describe(t)));
    }
}

fn literal_ahead(p: *Parser) -> bool {
    return at(p, .Period) && (at(p, .LBrace, 1) || at(p, .LBracket, 1));
}

// `[` in an expression: a type, as a type argument: make_list([]u8). Array
// literals are `.[1, 2]` and `i64.[1, 2]`; the forms from before (`[1, 2]`,
// `[2]i64{1, 2}`) are errors that show the new spelling, and parse on as
// literals.
fn bracket(p: *Parser) -> *Node {
    let open = next(p);
    let declared: *Node;
    if (at(p, .RBracket) && !can_start_type(peek(p, 1).kind)) {
        next(p); // []
        return old_literal(p, open, new_node(open, .ArrayLiteral(null, .[])));
    }
    if (at(p, .RBracket)) {
        next(p);
        declared = new_node(open, .TypeSlice(type_(p)));
    } else if (at(p, .Ellipsis2) && at(p, .RBracket, 1)) { // [..]T
        next(p);
        next(p);
        declared = new_node(open, .TypeDynArray(type_(p)));
    } else {
        let first = expr(p);
        if (at(p, .Comma) || (at(p, .RBracket) && !can_start_type(peek(p, 1).kind)) ||
            (at(p, .RBracket) && at(p, .LBracket, 1) && indexes_a_literal(p, 1))) {
            let items: [..]*Node; // [1, 2] or [x][0]
            array_add(&items, first);
            while (eat(p, .Comma) && !at(p, .RBracket))
                array_add(&items, expr(p));
            expect(p, .RBracket, "`,` or `]` after the element");
            return old_literal(p, open, new_node(open, .ArrayLiteral(null, items)));
        }
        expect(p, .RBracket, "`]` after the array length");
        declared = new_node(open, .TypeArray(type_(p), first));
    }
    if (at(p, .LBrace)) { // [2]i64{1, 2}
        report_error(p, peek(p), tformat("an array literal is written with its element type before `.[`: `%.[ ... ]`, or `.[ ... ]` where the type is known",
                                         element_of(declared).tok.text));
        return init_list(p, null, true);
    }
    return new_node(open, .TypeExpr(declared));
}

fn old_literal(p: *Parser, open: Token, n: *Node) -> *Node {
    report_error(p, open, tformat("`[` in an expression starts a type; an array literal is written with a dot before the `[`: `.%`",
                                  span_from(p, open.text.ptr)));
    return n;
}

/* ----------------------------------------------------------------- types */

// what follows a function's `->`: a type, or several in parentheses,
// `(i64, bool)`
fn result_type(p: *Parser) -> *Node {
    if (!at(p, .LParen))
        return type_(p);
    let open = next(p);
    let items: [..]*Node;
    array_add(&items, type_(p));
    while (eat(p, .Comma))
        array_add(&items, type_(p));
    expect(p, .RParen, "`,` or `)` after the result types");
    if (items.len == 1)
        return items[0];
    return new_node(open, .TypeTuple(items));
}

fn type_(p: *Parser) -> *Node {
    let t = peek(p);
    switch (t.kind) {
    case .Star:
        next(p);
        return new_node(t, .TypePointer(type_(p)));

    case .LBracket:
        next(p);
        if (eat(p, .RBracket))
            return new_node(t, .TypeSlice(type_(p)));
        if (at(p, .Ellipsis2) && at(p, .RBracket, 1)) { // [..]T
            next(p);
            next(p);
            return new_node(t, .TypeDynArray(type_(p)));
        }
        let len = expr(p);
        expect(p, .RBracket, "`]` after the array length");
        return new_node(t, .TypeArray(type_(p), len));

    case .Fn:
        next(p);
        expect(p, .LParen, "`(` after `fn`");
        let params: [..]*Node;
        let dots: Token;
        while (!at(p, .RParen)) {
            if (at(p, .Ellipsis3)) {
                dots = next(p); // C's: only with #c_call
                break;
            }
            array_add(&params, type_(p));
            if (!eat(p, .Comma))
                break;
        }
        expect(p, .RParen, "`,` or `)` in the parameter types");
        let result: *Node = null;
        if (eat(p, .Arrow))
            result = result_type(p);
        // fn(*void, *void) -> int #c_call: a C function pointer, called
        // without a context
        let c_call = false;
        if (at_directive(p, "c_call")) {
            directive(p);
            c_call = true;
        }
        if (dots.text.len > 0 && !c_call)
            fail(p, dots, "only a C function type can be variadic: `fn(*char, ...) -> int #c_call`");
        return new_node(t, .TypeFn(params, result, c_call, dots.text.len > 0));

    case .Question: // ?T: the prelude's Option(T), whatever `Option` names here
        next(p);
        let args: [..]*Node;
        array_add(&args, type_(p));
        return new_node(t, .TypeName(args));

    case .Identifier:
        let name = new_node(next(p), .TypeName(.[]));
        let member: *Node = null; // mem.Allocator
        if (at(p, .Period) && at(p, .Identifier, 1)) {
            next(p);
            member = new_node(next(p), .TypeMember(name, .[]));
        }
        // type arguments of a generic struct: List(i32)
        if (eat(p, .LParen)) {
            let args: [..]*Node;
            while (!at(p, .RParen)) {
                array_add(&args, type_(p));
                if (!eat(p, .Comma))
                    break;
            }
            expect(p, .RParen, "`,` or `)` after the type arguments");
            let n = if (member != null) member else name;
            switch (n.kind) {
            case .TypeName{args: &a}: a.* = args;
            case .TypeMember{args: &a}: a.* = args;
            default:
            }
        }
        return if (member != null) member else name;

    case .Dollar:
        // $T: declares a type parameter, bound to whatever type is here
        next(p);
        return new_node(expect(p, .Identifier, "a type parameter name after `$`"), .TypeParam);

    case .Type:
        return fail(p, t, "`type`, the type of types, is only known while compiling: a `$T: type` parameter takes one, and `const X: type = ...` names one");

    default:
        return fail(p, t, tformat("expected a type, found %", describe(t)));
    }
}
