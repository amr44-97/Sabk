// Function overloading, Jai's way: several functions can share a name when
// their parameters differ, and a call picks the one its arguments fit best.
//
//   fn area(c: Circle) -> f64 { ... }
//   fn area(r: Rect) -> f64 { ... }
//   area(c);                       the Circle one
//
// Each argument is ranked against its parameter:
//   1  the same type
//   2  a constant or literal that takes the parameter's type, at its
//      default type (`5` for an isize, `1.5` for an f64, "x" for a string,
//      `.Red` for an enum that has it)
//   3  an integer constant for an i64
//   4  a constant for another type it fits (`5` for an i32 or an f64)
//   5  a conversion (`i32` to `i64`, `[N]T` to `[]T`, to `?T`, to `Any`)
//   6  a generic function's parameter that takes it by its shape
//      (`[]$T` a slice or array, `*$T` a pointer, `List($T)` a List)
//   7  ... a bare `$T`, which takes anything
// The generic call then works out the types as usual.
//
// Operators are functions named by the operator, `fn operator +(a: Vec2,
// b: Vec2) -> Vec2`: where an operand is a struct, union or enum and one
// fits, `a + b` becomes a call of it (`a[i]` of `operator []`, `a[i] = v`
// of `operator []=`; `a += b` is `a = a + b`, and `a != b` is
// `!(a == b)` when there's no `operator !=`). Otherwise it's the built-in
// operator, as before.
// The pick is better or equal on every argument and better on one. None
// fitting, or several fitting equally, is an error listing them.
//
// The resolver keeps the functions of one name in an `Overloads` node; the
// call's callee gets the one picked. A function used as a value picks the
// one whose type is expected: `let f: fn(Circle) -> f64 = area;`.

#import "std/array";
#import "std/fmt";
#import "std/map";
#import "std/path";
#import "std/str";
#import "ast";
#import "module";
#import "resolve";
#import "token";
#import "types";
#import "check";
#import "expressions";
#import "generics";

// the function of `fns` a call to them picks, or null (reported)
fn pick_overload(c: *Checker, n: *Node, callee: *Node, fns: []*Node) -> *Node {
    let args = call_args_of(n);
    // the arguments' own types, which rank the candidates; `.{...}`, `.Red`
    // and `.[...]` wait for the parameter's type
    let broken = false;
    for (a in args) {
        if (is_contextual(a) || is_open_literal(a) || a.kind.tag == .TypeExpr)
            continue;
        if (a.ty != null) { // checked already (an operator's operands)
            broken = broken || a.ty.kind == .Error;
            continue;
        }
        let e = if (a.kind is .Spread{value}) value else a; // ..xs: the slice
        if (check_expr(c, e, null).kind == .Error)
            broken = true;
    }
    if (broken)
        return null; // reported: ranking would only add noise

    let candidates = visible_candidates(c, n.tok, fns);
    let fitting: [..]*Node;
    let ranks: [..][]i32;
    for (f in candidates) {
        let r, fits = rank_call(c, f, args);
        if (fits) {
            array_add(&fitting, f);
            array_add(&ranks, r);
        }
    }
    let name = shown_name(fns[0]);
    if (fitting.len == 0) {
        report_no_fit(c, callee.tok, candidates, args);
        return null;
    }
    // the one better or equal on every argument than each other one, and
    // better on at least one
    for (i in 0..fitting.len) {
        let best = true;
        for (j in 0..fitting.len)
            if (j != i && !better(ranks[i], ranks[j]))
                best = false;
        if (best)
            return fitting[i];
    }
    // one declaration and its `#symmetric` copy, both taking (V, V):
    // reported where it's declared
    let one_declaration = true;
    for (f in fitting)
        one_declaration = one_declaration && f.tok.text.ptr == fitting[0].tok.text.ptr;
    if (one_declaration)
        return fitting[0];
    // two of one module with the same parameters: reported where they're
    // declared (two imports' are ambiguous only here, at the call)
    // (generic ones aren't: their parameters aren't types until a call)
    for (i in 1..fitting.len) {
        if (is_template(fitting[0]) || is_template(fitting[i]))
            continue;
        let a, b = decl_type(c, fitting[0]), decl_type(c, fitting[i]);
        if (fitting[i].owner == fitting[0].owner && a.kind == .Fn && b.kind == .Fn && same_params(a, b))
            return fitting[0];
    }
    let these = if (args.len == 0) "a call with no arguments" else tformat("these arguments, (%),", arg_types(c, args));
    error(c, callee.tok, tformat("`%` is ambiguous here: % of them fit % equally well%",
                                 name, fitting.len, these, ambiguity_hint(c, fitting, args)));
    for (f in fitting)
        note(c, f.tok, tformat("`%` fits", describe_fn(c, f)));
    return null;
}

// a function value of one of `fns`: the one whose type is expected (a
// generic one can't be picked this way)
fn overload_value(c: *Checker, n: *Node, fns: []*Node, expected: *Type) -> *Node {
    let candidates: [..]*Node;
    let generic = false;
    for (f in visible_candidates(c, n.tok, fns)) {
        if (is_template(f))
            generic = true;
        else
            array_add(&candidates, f);
    }

    if (expected != null && expected.kind == .Fn) {
        for (f in candidates)
            if (decl_type(c, f) == expected)
                return f;
        error(c, n.tok, tformat("no `%` has the type %", n.tok.text, qt(expected)));
    } else {
        error(c, n.tok, tformat("there are % functions named `%`: a function value needs a type to pick one, like `let f: fn(...) -> ... = %;`",
                                candidates.len, n.tok.text, n.tok.text));
    }
    for (f in candidates)
        note(c, f.tok, tformat("`%` is one", describe_fn(c, f)));
    if (generic)
        note(c, n.tok, tformat("a generic `%` isn't one to pick as a value: its types come from a call", n.tok.text));
    return null;
}

// two functions of one name with the same parameters (the result type
// doesn't tell calls apart): an error at the second
fn check_overload_sets(c: *Checker) {
    for (set in c.res.overload_sets) {
        let fns: []*Node;
        if (set.kind is .Overloads{fns: list})
            fns = list;
        for (i in 1..fns.len) {
            if (is_template(fns[i]))
                continue; // its parameters are known per call
            let a = decl_type(c, fns[i]);
            if (a.kind != .Fn)
                continue;
            for (j in 0..i) {
                if (is_template(fns[j]))
                    continue;
                let b = decl_type(c, fns[j]);
                if (b.kind != .Fn || !same_params(a, b))
                    continue;
                if (fns[i].tok.text.ptr == fns[j].tok.text.ptr)
                    break; // `#symmetric`'s copy of the same declaration: reported there
                let what = if (a.ret == b.ret) "the same parameters" else "the same parameters (a result type doesn't tell calls apart)";
                // the one written out, and `#symmetric`'s copy if one is
                let copy, written = fns[j], fns[i];
                if (is_swapped_copy(fns[i], fns))
                    copy, written = fns[i], fns[j];
                error(c, written.tok, tformat("`%` is declared twice with %: %", shown_name(written), what,
                                              describe_fn(c, written)));
                if (is_swapped_copy(copy, fns))
                    note(c, copy.tok, tformat("`#symmetric` here already takes them this way round: %", describe_fn(c, copy)));
                else
                    note(c, copy.tok, tformat("the first is here: %", describe_fn(c, copy)));
                break;
            }
        }
    }
}

// a + b where an operand is a struct, union or enum and an `operator +`
// fits: a call of it. False: the built-in operator, as before.
fn operator_binary(c: *Checker, n: *Node, expected: *Type) -> (*Type, bool) {
    let op: BinaryOp;
    let lhs: *Node = null;
    let rhs: *Node = null;
    if (n.kind is .Binary{op: o, lhs: l, rhs: r})
        op, lhs, rhs = o, l, r;
    let set = n.decl;
    // a literal operand (`.Red`, `.{...}`) takes the other one's type
    let lt: *Type = null;
    let rt: *Type = null;
    if (is_contextual(lhs) || is_open_literal(lhs)) {
        rt = check_expr(c, rhs, null);
        lt = check_expr(c, lhs, rt);
    } else {
        lt = check_expr(c, lhs, null);
        rt = check_expr(c, rhs, lt);
    }
    if (!(user_type(lt) || user_type(rt)) || lt.kind == .Error || rt.kind == .Error)
        return left_to_built_in(c, lhs, rhs, null);
    let args = new([]*Node, 2);
    args[0], args[1] = lhs, rhs;
    // none fits: an enum's `==` and `!=` are built in; for the rest the
    // call reports why none takes them
    let built_in = (op == .EqEq || op == .NotEq) && !(struct_or_union(lt) || struct_or_union(rt));
    if (!fits_any(c, n.tok, set, args)) {
        if (built_in)
            return left_to_built_in(c, lhs, rhs, null);
        report_no_fit(c, n.tok, visible_candidates(c, n.tok, members(set)), args);
        return c.types.error, true;
    }
    let callee = operator_callee(n.tok, set, n.color);
    n.decl = null;
    // `!=` from `==`: not equal
    if (op == .NotEq && n.tok.text != members(set)[0].tok.text) {
        for (f in members(set)) {
            let ft = if (is_template(f)) null else decl_type(c, f);
            if (ft != null && ft.kind == .Fn && ft.ret != c.types.bool_)
                return c.types.error, true; // an `operator ==` not giving a bool: reported where it's declared
        }
        let call = new_node(n.tok, .Call(callee, args, false));
        call.color = n.color;
        n.kind = .Unary(.Not, call);
        return check_expr(c, n, expected), true;
    }
    n.kind = .Call(callee, args, false);
    return check_call(c, n, expected), true;
}

// m[i] where m is a struct, union or enum and an `operator []` fits: a
// call of it, with `&m` when its first parameter takes a pointer
fn operator_index(c: *Checker, n: *Node, expected: *Type) -> (*Type, bool) {
    let object: *Node = null;
    let index: *Node = null;
    if (n.kind is .Index{object: o, index: i})
        object, index = o, i;
    let args, ok = index_args(c, n.decl, n.tok, object, index, null);
    if (!ok)
        return null, false;
    let callee = operator_callee(n.tok, n.decl, n.color);
    n.decl = null;
    n.kind = .Call(callee, args, false);
    return check_call(c, n, expected), true;
}

// `m[i] = v` where an `operator []=` fits: the statement becomes its call
fn operator_index_assign(c: *Checker, n: *Node) -> bool {
    let target: *Node = null;
    let value: *Node = null;
    if (n.kind is .Assign{target: t, value: v})
        target, value = t, v;
    let object: *Node = null;
    let index: *Node = null;
    if (target.kind is .Index{object: o, index: i})
        object, index = o, i;
    let args, ok = index_args(c, n.decl, n.tok, object, index, value);
    if (!ok)
        return false;
    let callee = operator_callee(target.tok, n.decl, n.color);
    let call = new_node(target.tok, .Call(callee, args, false));
    call.color = n.color;
    n.decl = null;
    n.kind = .ExprStmt(call, false);
    return true;
}

// `a += b` where `a` is a struct, union or enum and an `operator +`
// fits: `a = a + b`, when reading `a` again can't do anything twice
fn operator_compound(c: *Checker, n: *Node, target_type: *Type) -> bool {
    if (!user_type(target_type))
        return false;
    let target: *Node = null;
    let value: *Node = null;
    if (n.kind is .Assign{target: t, value: v})
        target, value = t, v;
    let set = n.decl;
    n.decl = null;
    if (!without_effects(target)) {
        error(c, n.tok, tformat("`%` with an `operator %` reads its target again, which runs code twice here: write it out, `x = x % y`",
                                n.tok.text, op_of(n.tok.text), op_of(n.tok.text)));
        return true;
    }
    let again = clone_node(target, -1); // resolved: the same names
    let sum = new_node(n.tok, .Binary(compound_op(n.tok.text), again, value));
    sum.decl = set;
    sum.color = n.color;
    // the `=` of `+=` (a token of the source, for messages)
    let eq = n.tok;
    eq.text = n.tok.text[n.tok.text.len - 1..];
    n.tok = eq;
    n.kind = .Assign(target, sum);
    return false; // checked as an `=` from here
}

// a function whose name is an operator: its parameters say what it's for
fn check_operators(c: *Checker) {
    for (m in c.res.modules) {
        for (d in root_list(m)) {
            if (!is_operator_fn(d))
                continue;
            let name = d.tok.text;
            let want: isize = if (name == "[]=") 3 else 2;
            let given = fn_params(d).len;
            if (given != want) {
                error(c, d.tok, tformat("`operator %` takes % parameters, found %", name, want, given));
                continue;
            }
            if (is_template(d))
                continue; // its types are known per call
            let t = decl_type(c, d);
            if (t.kind != .Fn)
                continue;
            // `[]` and `[]=` take their object by pointer too (`&m` is
            // passed); a binary operator's pointer operands keep the
            // built-in meaning (`p - q`), so it needs one by value
            let indexing = name == "[]" || name == "[]=";
            let any_own = false;
            let by_pointer = false;
            for (pt in t.params) {
                any_own = any_own || user_type(pt) || (indexing && pt.kind == .Ptr && user_type(pt.elem));
                by_pointer = by_pointer || (pt.kind == .Ptr && user_type(pt.elem));
            }
            if (!any_own && by_pointer)
                error(c, d.tok, tformat("`operator %` needs a struct, union or enum among its parameters, by value: on pointers, `%` keeps its built-in meaning",
                                        name, name));
            else if (!any_own)
                error(c, d.tok, tformat("`operator %` needs a struct, union or enum among its parameters: `%` on built-in types keeps its meaning",
                                        name, name));
            if ((name == "==" || name == "!=") && t.ret != c.types.bool_ && t.ret.kind != .Error)
                error(c, d.tok, tformat("`operator %` gives a `bool`, found %", name, qt(t.ret)));
            if (d.kind is .Fn{symmetric: true} && t.params[0] == t.params[1])
                error(c, d.tok, tformat("`#symmetric` swaps the two parameters, but both are %: `operator %` takes them either way already; leave `#symmetric` out",
                                        qt(t.params[0]), name));
        }
    }
}

// `area(r: Rect) -> f64`
fn describe_fn(c: *Checker, f: *Node) -> string {
    if (is_template(f)) // as written: show(x: $T)
        return describe_template(f);
    let t = decl_type(c, f);
    let out: [..]u8;
    out.allocator = context.temp_allocator;
    print_to(&out, "%{}%(", if (is_operator_fn(f)) "operator " else "", f.tok.text);
    let params = fn_params(f);
    let k = 0;
    for (i in 0..params.len) {
        if (i > 0)
            append_string(&out, ", ");
        let pt = if (t.kind == .Fn && i < t.params.len) type_name(t.params[i]) else "?";
        print_to(&out, "%: %{}%", params[i].tok.text, if (is_variadic_param(params[i])) ".." else "", pt);
        k++;
    }
    append_string(&out, ")");
    if (t.kind == .Fn && t.ret.kind != .Void)
        print_to(&out, " -> %", type_name(t.ret));
    return out as string;
}

#scope_file

// `#symmetric`'s copy of a declaration in `fns`: the one sharing its
// token with the declaration that has `#symmetric`
fn is_swapped_copy(f: *Node, fns: []*Node) -> bool {
    if (f.kind is .Fn{symmetric: true})
        return false;
    for (g in fns)
        if (g != f && g.tok.text.ptr == f.tok.text.ptr && g.kind is .Fn{symmetric: true})
            return true;
    return false;
}

// `area`, or `operator +`
fn shown_name(f: *Node) -> string {
    return if (is_operator_fn(f)) tformat("operator %", f.tok.text) else f.tok.text;
}

// none of `candidates` takes `args`: an error, and a note on each saying why
fn report_no_fit(c: *Checker, at: Token, candidates: []*Node, args: []*Node) {
    error(c, at, tformat("no `%` takes these arguments: (%)", shown_name(candidates[0]), arg_types(c, args)));
    for (f in candidates)
        note(c, f.tok, tformat("`%`: %", describe_fn(c, f), why_not(c, f, args)));
}

// a struct, union or enum: what an operator can be given a meaning for
fn user_type(t: *Type) -> bool {
    return (t.kind == .Struct && !t.is_tuple) || t.kind == .Union || t.kind == .Enum;
}

// the callee of an operator's call: always a set, even of one, so the
// call takes its operands as they were checked to pick it (checking
// `K.Wrap(3)` again, already a variant's value, would break it)
fn operator_callee(at: Token, set: *Node, color: i32) -> *Node {
    let callee = new_node(at, .Identifier);
    callee.decl = if (set.kind.tag == .Overloads) set else new_node(set.tok, .Overloads(members(set)));
    callee.color = color;
    return callee;
}

fn struct_or_union(t: *Type) -> bool { return (t.kind == .Struct && !t.is_tuple) || t.kind == .Union; }

fn members(set: *Node) -> []*Node {
    if (set.kind is .Overloads{fns})
        return fns;
    let one = new([]*Node, 1, context.temp_allocator);
    one[0] = set;
    return one;
}

// does one of the functions in `set` take `args`?
fn fits_any(c: *Checker, at: Token, set: *Node, args: []*Node) -> bool {
    for (f in visible_candidates(c, at, members(set))) {
        let _, fits = rank_call(c, f, args);
        if (fits)
            return true;
    }
    return false;
}

// the arguments of an `operator []` or `[]=` call: the object, or `&`
// it when the function takes a pointer, the index, and the value; false
// when the object isn't a struct, union or enum, or none fits
fn index_args(c: *Checker, set: *Node, at: Token, object: *Node, index: *Node, value: *Node) -> ([]*Node, bool) {
    let none: []*Node;
    if (set == null)
        return none, false;
    let ot = check_expr(c, object, null);
    if (!user_type(ot)) {
        left_to_built_in(c, object, null, null);
        return none, false;
    }
    // `.Red` and `.{...}` take their types from the parameters, as in calls
    if (!is_contextual(index) && !is_open_literal(index))
        check_expr(c, index, null);
    if (value != null && !is_contextual(value) && !is_open_literal(value))
        check_expr(c, value, null);
    let count: isize = if (value != null) 3 else 2;
    for (by_pointer in .[false, true]) {
        let first = object;
        if (by_pointer) {
            if (!is_place(object))
                continue;
            first = new_node(object.tok, .Unary(.AddressOf, object));
            first.color = object.color;
            check_expr(c, first, null);
        }
        let args = new([]*Node, count);
        args[0], args[1] = first, index;
        if (value != null)
            args[2] = value;
        if (fits_any(c, at, set, args))
            return args, true;
    }
    left_to_built_in(c, object, index, value);
    return none, false;
}

// operands checked for an operator function, which the built-in operator
// takes from here: they aren't checked again (`c.pre_checked`)
fn left_to_built_in(c: *Checker, a: *Node, b: *Node, d: *Node) -> (*Type, bool) {
    for (n in .[a, b, d])
        if (n != null && n.ty != null)
            map_put(&c.pre_checked, n, true);
    return null, false;
}

// can `n` be read twice without running anything twice: names, fields,
// `p.*`, and indexes by those
fn without_effects(n: *Node) -> bool {
    switch (n.kind) {
    case .Identifier, .Number, .Char, .Bool: return true;
    case .Grouped{inner}: return without_effects(inner);
    case .Member{object}: return without_effects(object);
    case .Deref{pointer}: return without_effects(pointer);
    case .Index{object, index}: return without_effects(object) && without_effects(index);
    default: return false;
    }
}

fn op_of(compound: string) -> string { return compound[..compound.len - 1]; }

fn compound_op(compound: string) -> BinaryOp {
    return switch (compound) {
    case "+=": .Add;
    case "-=": .Sub;
    case "*=": .Mul;
    case "/=": .Div;
    case "%=": .Mod;
    case "&=": .BitAnd;
    case "|=": .BitOr;
    case "^=": .BitXor;
    case "<<=": .Shl;
    default: .Shr;
    };
}

// a generic candidate: a parameter its type parameters appear in takes an
// argument of that shape (rank 6); the others rank as usual
fn rank_generic_call(c: *Checker, f: *Node, args: []*Node) -> ([]i32, bool) {
    let ranks = new([]i32, args.len, context.temp_allocator);
    let params = fn_params(f);
    if (!count_fits(f, null, args.len))
        return ranks, false;
    for (i in 0..args.len) {
        let last = params.len - 1;
        let p = if (i < params.len) params[i] else params[last]; // past the end: a `..T`
        let arg = args[i];
        if (is_type_param(p)) { // `$T: type`: a type goes there
            ranks[i] = if (arg.kind.tag == .TypeExpr) 6 else 0;
        } else if (arg.kind.tag == .TypeExpr) {
            ranks[i] = 0;
        } else {
            let declared = declared_of(p);
            let used: [..]*Node;
            used.allocator = context.temp_allocator;
            type_params_in(declared, &used);
            if (used.len > 0) {
                let e = if (arg.kind is .Spread{value}) value else arg;
                let bare = declared.kind.tag == .TypeParam || names_type_param(declared);
                ranks[i] = if (!shape_fits(c, declared, e)) 0 else if (bare) 7 else 6;
            } else {
                // a `..T` parameter's type is written as its element's;
                // `..xs` passes a slice of them
                let pt = type_from_node(c, declared);
                if (arg.kind is .Spread{value})
                    ranks[i] = rank_arg(c, value, if (is_variadic_param(p)) slice_of(&c.types, pt) else pt);
                else
                    ranks[i] = rank_arg(c, arg, pt);
            }
        }
        if (ranks[i] == 0)
            return ranks, false;
    }
    return ranks, true;
}

// can an argument go to a parameter written `pattern`, which uses type
// parameters: does its type have that shape?
fn shape_fits(c: *Checker, pattern: *Node, arg: *Node) -> bool {
    if (is_contextual(arg))
        return false; // `.{...}` and `.Red` need a type to start from
    if (is_open_literal(arg)) {
        let k = pattern.kind.tag;
        return k == .TypeSlice || k == .TypeArray || k == .TypeGrowable;
    }
    if (arg.ty == null || arg.ty.kind == .Error)
        return false;
    return type_fits(c, pattern, arg.ty);
}

fn type_fits(c: *Checker, pattern: *Node, t: *Type) -> bool {
    if (pattern.kind.tag == .TypeParam || names_type_param(pattern))
        return true;
    let used: [..]*Node;
    used.allocator = context.temp_allocator;
    type_params_in(pattern, &used);
    if (used.len == 0) // no type parameter in it: the type itself
        return can_coerce(c, null, t, type_from_node(c, pattern));
    switch (pattern.kind) {
    case .TypePointer{to}:
        return t.kind == .Ptr && type_fits(c, to, t.elem);
    case .TypeSlice{elem}:
        return (t.kind == .Slice || t.kind == .Array || t.kind == .Growable) && t.elem != null &&
               type_fits(c, elem, t.elem);
    case .TypeArray{elem}:
        return t.kind == .Array && type_fits(c, elem, t.elem);
    case .TypeGrowable{elem}:
        return t.kind == .Growable && type_fits(c, elem, t.elem);
    case .TypeFn{params}:
        return t.kind == .Fn && t.params.len == params.len;
    case .TypeName, .TypeMember: // List($T): an instance of List
        return (t.kind == .Struct || t.kind == .Union || t.kind == .Enum) && t.decl != null &&
               (t.decl.generic == pattern.decl || t.decl == pattern.decl);
    default:
        return true; // the generic call says what doesn't fit
    }
}

// a generic function as written: show(x: $T), largest(xs: []$T) -> T
fn describe_template(f: *Node) -> string {
    let out: [..]u8;
    out.allocator = context.temp_allocator;
    print_to(&out, "%(", shown_name(f));
    let params = fn_params(f);
    for (i in 0..params.len) {
        if (i > 0)
            append_string(&out, ", ");
        print_to(&out, "%: %{}%", params[i].tok.text, if (is_variadic_param(params[i])) ".." else "",
                 type_text(declared_of(params[i])));
    }
    append_string(&out, ")");
    let result: *Node = null;
    if (f.kind is .Fn{result: r})
        result = r;
    if (result != null)
        print_to(&out, " -> %", type_text(result));
    return out as string;
}

// a type as written
fn type_text(n: *Node) -> string {
    if (n == null)
        return "?";
    switch (n.kind) {
    case .TypeParam: return tformat("$%", n.tok.text);
    case .TypePointer{to}: return tformat("*%", type_text(to));
    case .TypeSlice{elem}: return tformat("[]%", type_text(elem));
    case .TypeGrowable{elem}: return tformat("[..]%", type_text(elem));
    case .TypeArray{elem, len}: return tformat("[%]%", if (len != null) len.tok.text else "", type_text(elem));
    case .TypeName{args}: return with_args(n.tok.text, args);
    case .TypeMember{args}: return with_args(n.tok.text, args);
    default: return n.tok.text;
    }
}

// List($T)
fn with_args(name: string, args: []*Node) -> string {
    if (args.len == 0)
        return name;
    let out: [..]u8;
    out.allocator = context.temp_allocator;
    print_to(&out, "%(", name);
    for (i in 0..args.len)
        print_to(&out, "%{}%", if (i > 0) ", " else "", type_text(args[i]));
    append_string(&out, ")");
    return out as string;
}

fn call_args_of(n: *Node) -> []*Node {
    if (n.kind is .Call{args})
        return args;
    return .[];
}

// the candidates the code at `at` can see: its own module's, and the
// others' exported ones
fn visible_candidates(c: *Checker, at: Token, fns: []*Node) -> [..]*Node {
    let caller = module_of(c.res, at.text.ptr);
    if (caller != null && caller.loaded_into != null)
        caller = caller.loaded_into;
    let out: [..]*Node;
    out.allocator = context.temp_allocator;
    for (f in fns)
        if (caller == null || caller.inserted_by != null || f.owner == caller || exported(f))
            array_add(&out, f);
    // a function of the caller's own module hides an imported one with the
    // same parameters: your names win. A generic one's parameters aren't
    // types until a call, so it neither hides nor is hidden (and typing
    // its declaration here would leave its instances broken).
    let kept: [..]*Node;
    kept.allocator = context.temp_allocator;
    for (f in out) {
        let hidden = false;
        if (caller != null && f.owner != caller && !is_template(f)) {
            for (g in out) {
                if (g.owner != caller || is_template(g))
                    continue;
                let a, b = decl_type(c, f), decl_type(c, g);
                hidden = hidden || (a.kind == .Fn && b.kind == .Fn && same_params(a, b));
            }
        }
        if (!hidden)
            array_add(&kept, f);
    }
    return kept;
}

// each argument's rank against `f`'s parameters, and whether they all fit
fn rank_call(c: *Checker, f: *Node, args: []*Node) -> ([]i32, bool) {
    if (is_template(f))
        return rank_generic_call(c, f, args);
    let t = decl_type(c, f);
    let ranks = new([]i32, args.len, context.temp_allocator);
    if (t.kind != .Fn || !count_fits(f, t, args.len))
        return ranks, false;
    for (i in 0..args.len) {
        let r = rank_at(c, f, t, args, i);
        if (r == 0)
            return ranks, false;
        ranks[i] = r;
    }
    return ranks, true;
}

// the i-th argument's rank; `..xs` only goes to a `..T` parameter, whole
fn rank_at(c: *Checker, f: *Node, t: *Type, args: []*Node, i: isize) -> i32 {
    if (args[i].kind is .Spread{value}) {
        let params = fn_params(f);
        let last = params.len - 1;
        if (last < 0 || !is_variadic_param(params[last]) || i != last || i != args.len - 1)
            return 0;
        return rank_arg(c, value, t.params[last]);
    }
    return rank_arg(c, args[i], param_type(f, t, i));
}

// enough arguments for the parameters without defaults, and not too many
fn count_fits(f: *Node, t: *Type, given: isize) -> bool {
    let params = fn_params(f);
    let variadic = params.len > 0 && is_variadic_param(params[params.len - 1]);
    let fixed = if (variadic) params.len - 1 else params.len;
    let needed: isize = 0;
    for (i in 0..fixed)
        if (value_of(params[i]) == null)
            needed = i + 1;
    return given >= needed && (variadic || given <= params.len);
}

// the type the i-th argument goes to: a `..T` parameter takes each extra
// argument as a T
fn param_type(f: *Node, t: *Type, i: isize) -> *Type {
    let params = fn_params(f);
    let last = params.len - 1;
    if (last >= 0 && is_variadic_param(params[last]) && i >= last)
        return t.params[last].elem;
    return t.params[i];
}

// 0: doesn't fit; 1 to 5: see the top of the file
fn rank_arg(c: *Checker, arg: *Node, pt: *Type) -> i32 {
    if (pt.kind == .Error)
        return 5; // reported: don't make it worse
    if (is_contextual(arg) || is_open_literal(arg))
        return if (literal_fits(c, arg, pt)) 2 else 0;
    let at = arg.ty;
    if (at == null)
        return 0;
    if (at == pt)
        return 1;
    if (!can_coerce(c, arg, at, pt))
        return 0;
    switch (at.kind) {
    case .UntypedInt:
        return if (pt == c.types.isize) 2 else if (pt == c.types.i64) 3 else 4;
    case .UntypedFloat:
        return if (pt == c.types.f64) 2 else 4;
    case .UntypedString:
        return if (pt == c.types.string_) 2 else 4;
    case .Null:
        return 4;
    default:
        return 5;
    }
}

// can `.Red`, `.Some(1)`, `.{...}` or `.[...]` be a `pt`?
fn literal_fits(c: *Checker, arg: *Node, pt: *Type) -> bool {
    let e = ungroup(arg);
    switch (e.kind) {
    case .EnumShorthand:
        return has_variant(pt, e.tok.text[1..]);
    case .Call{callee}: // .Some(1)
        return pt.is_tagged && has_variant(pt, callee.tok.text[1..]);
    case .StructInit{variant}:
        if (variant) // .Let{...}
            return pt.is_tagged;
        return (pt.kind == .Struct && !pt.is_tuple) || pt.kind == .Union;
    case .ArrayLiteral:
        return pt.kind == .Array || pt.kind == .Slice || pt.kind == .Growable;
    default:
        return false;
    }
}

fn has_variant(t: *Type, name: string) -> bool {
    if (t.kind != .Enum && !t.is_tagged)
        return false;
    if (t.decl == null)
        return false;
    for (v in enum_variants(t.decl))
        if (v.tok.text == name)
            return true;
    return false;
}

// does `a` rank better or equal on every argument, and better on one?
fn better(a: []i32, b: []i32) -> bool {
    let strictly = false;
    for (i in 0..a.len) {
        if (a[i] > b[i])
            return false;
        if (a[i] < b[i])
            strictly = true;
    }
    return strictly;
}

fn same_params(a: *Type, b: *Type) -> bool {
    if (a.params.len != b.params.len || a.is_variadic != b.is_variadic)
        return false;
    for (i in 0..a.params.len)
        if (a.params[i] != b.params[i])
            return false;
    return true;
}

// "Rect, i64": the arguments' types, as far as they're known
fn arg_types(c: *Checker, args: []*Node) -> string {
    let out: [..]u8;
    out.allocator = context.temp_allocator;
    for (i in 0..args.len) {
        if (i > 0)
            append_string(&out, ", ");
        let a = args[i];
        if (a.kind is .Spread{value})
            print_to(&out, "..%", if (value.ty != null) type_name(value.ty) else "?");
        else if (is_contextual(a) || is_open_literal(a))
            append_string(&out, source_of(a));
        else if (a.ty != null)
            append_string(&out, kind_of_value(a.ty));
        else
            append_string(&out, "?");
    }
    return out as string;
}

// what a call quotes of an argument: its text
fn source_of(a: *Node) -> string { return if (a.span.len > 0) a.span else ungroup(a).tok.text; }

// a type, or what a constant is: "an integer constant" reads better than
// "untyped int"
fn kind_of_value(t: *Type) -> string {
    return switch (t.kind) {
    case .UntypedInt: "an integer constant";
    case .UntypedFloat: "a float constant";
    case .UntypedString: "a string literal";
    case .Null: "null";
    default: type_name(t);
    };
}

// why `f` doesn't take `args`
fn why_not(c: *Checker, f: *Node, args: []*Node) -> string {
    if (is_template(f)) {
        if (!count_fits(f, null, args.len)) {
            let params = fn_params(f);
            return tformat("it takes % argument%{}, given %", params.len, if (params.len == 1) "" else "s", args.len);
        }
        let ranks, _ = rank_generic_call(c, f, args);
        let params = fn_params(f);
        for (i in 0..args.len) {
            if (ranks[i] != 0)
                continue;
            let p = if (i < params.len) params[i] else params[params.len - 1];
            let a = args[i];
            let given = if (is_contextual(a) || is_open_literal(a)) tformat("`%`", source_of(a))
                        else if (a.ty != null && is_untyped(a.ty)) kind_of_value(a.ty)
                        else if (a.ty != null) tformat("a %", qt(a.ty)) else "this";
            return tformat("the % argument is %, which isn't a `%`", ordinal(i), given, type_text(declared_of(p)));
        }
        return "it doesn't fit";
    }
    let t = decl_type(c, f);
    if (t.kind != .Fn)
        return "its type is broken";
    if (!count_fits(f, t, args.len)) {
        let params = fn_params(f);
        return tformat("it takes % argument%{}, given %", params.len, if (params.len == 1) "" else "s", args.len);
    }
    for (i in 0..args.len) {
        if (rank_at(c, f, t, args, i) != 0)
            continue;
        let a = args[i];
        if (a.kind is .Spread{value})
            return tformat("`..%` passes a slice to a `..T` parameter, the last", value.tok.text);
        let given = if (is_contextual(a) || is_open_literal(a)) tformat("`%`", source_of(a))
                    else if (a.ty != null && is_untyped(a.ty)) kind_of_value(a.ty)
                    else if (a.ty != null) tformat("a %", qt(a.ty)) else "this";
        return tformat("the % argument is %, not a %", ordinal(i), given, qt(param_type(f, t, i)));
    }
    return "it doesn't fit";
}

fn ambiguity_hint(c: *Checker, fitting: []*Node, args: []*Node) -> string {
    // the same parameters, from different modules: only the module tells
    let same = true;
    for (f in fitting[1..])
        same = same && f.owner != fitting[0].owner && same_params(decl_type(c, f), decl_type(c, fitting[0]));
    if (same) {
        let out: [..]u8;
        out.allocator = context.temp_allocator;
        for (i in 0..fitting.len)
            print_to(&out, "%`%.%`", if (i == 0) "" else " or ", path_stem(fitting[i].owner.path), fitting[i].tok.text);
        return tformat("; they take the same arguments: write the module, %", out as string);
    }
    for (a in args)
        if (is_contextual(a) || is_open_literal(a))
            return "; give a literal its type to pick one (`Circle.{ ... }`, `Color.Red`)";
    return "; convert an argument with `as` to pick one";
}

fn ordinal(i: isize) -> string {
    return switch (i) {
    case 0: "1st";
    case 1: "2nd";
    case 2: "3rd";
    default: tformat("%{}th", i + 1);
    };
}
