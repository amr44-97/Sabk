// Narrowing: where the checker knows which variant a value is, `x.Some`
// needs no check. It knows after `if (x is .V)` (in its body, and on the
// right of `&&`), and after `if (x !is .V) return;` (or `continue` and
// `break`). Only for a local, a parameter, or a field of one reached
// without a pointer, and only when that variable is never assigned or has
// its address taken in the function, so nothing in between can change it.

#import "std/array";
#import "std/fmt";
#import "std/map";
#import "ast";
#import "types";
#import "check";
#import "patterns";

// the variables `n` assigns or takes the address of, anywhere in it
fn find_unstable(c: *Checker, n: *Node) {
    if (n == null)
        return;
    switch (n.kind) {
    case .Assign{target}:
        if (target.kind is .Values{items}) {
            for (t in items)
                mark_unstable(c, t);
        } else {
            mark_unstable(c, target);
        }
    case .Inc{target}: mark_unstable(c, target);
    case .Dec{target}: mark_unstable(c, target);
    case .Unary{op: .AddressOf, operand}: mark_unstable(c, operand);
    default:
    }
    for (child in code_children(n))
        find_unstable(c, child);
}

// is the variant of `place` known to be `variant`?
fn is_narrowed(c: *Checker, place: *Node, variant: *Node) -> bool {
    let path = path_of(c, place);
    if (path.len == 0)
        return false;
    for (f in c.facts)
        if (f.variant == variant && f.path == path)
            return true;
    return false;
}

// what `cond` says about variants when it's `truth`
fn add_facts(c: *Checker, cond: *Node, truth: bool) {
    switch (cond.kind) {
    case .Grouped{inner}:
        add_facts(c, inner, truth);
    case .Unary{op: .Not, operand}:
        add_facts(c, operand, !truth);
    case .Binary{op: .And, lhs, rhs}:
        if (truth) { // both hold
            add_facts(c, lhs, true);
            add_facts(c, rhs, true);
        }
    case .Binary{op: .Or, lhs, rhs}:
        if (!truth) { // neither holds
            add_facts(c, lhs, false);
            add_facts(c, rhs, false);
        }
    case .Is{value, pattern}:
        if (!truth)
            return;
        let head = pattern_head(pattern);
        if (head.decl == null || head.decl.kind.tag != .Variant)
            return;
        let path = path_of(c, value);
        if (path.len > 0)
            array_add(&c.facts, Fact.{ .path = path, .variant = head.decl });
    default:
    }
}

// does every way through `n` leave the block it's in: return, break,
// continue?
fn always_leaves(n: *Node) -> bool {
    if (n == null)
        return false;
    switch (n.kind) {
    case .Return, .Break, .Continue: return true;
    case .Block{stmts, gives_value: false}:
        for (s in stmts)
            if (always_leaves(s))
                return true;
        return false;
    case .If{then, else_, gives_value: false}:
        return else_ != null && always_leaves(then) && always_leaves(else_);
    case .StaticIf: return always_leaves(static_if_branch(n));
    default: return false;
    }
}

#scope_file

fn mark_unstable(c: *Checker, target: *Node) {
    let e = target;
    while (true) {
        switch (e.kind) {
        case .Grouped{inner}: e = inner; continue;
        case .Member{object}:
            if (e.decl != null)
                break;
            e = object;
            continue;
        case .Index{object}: e = object; continue;
        default:
        }
        break;
    }
    if (e.decl != null)
        map_put(&c.unstable, e.decl, true);
}

// a place narrowing can know about: x, x.f, x.f.g, with x a local or
// parameter nothing changes; "" for anything else
fn path_of(c: *Checker, n: *Node) -> string {
    switch (n.kind) {
    case .Grouped{inner}:
        return path_of(c, inner);
    case .Identifier:
        let d = n.decl;
        if (d == null || d.owner != null || map_has(&c.unstable, d))
            return "";
        switch (d.kind.tag) {
        case .Let, .Const, .Param, .ForIn, .LoopIndex, .Binding:
            return tformat("%", d as usize);
        default:
            return "";
        }
    case .Member{object}:
        if (n.decl != null || object.ty == null || object.ty.kind == .Ptr)
            return "";
        let base = path_of(c, object);
        return if (base.len == 0) "" else tformat("%.%", base, n.tok.text);
    default:
        return "";
    }
}
