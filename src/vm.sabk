// Runs code while compiling (#run). Checked syntax trees are compiled to a
// register bytecode (lower.sabk) and interpreted here. Values live in
// native memory laid out exactly like the generated C, so pointers, slices
// and allocators behave the same at compile time as at run time; C
// functions are called through libffi (vm_ffi.c). See "Compile-time
// execution" in docs/reference.md.
//
// A failure (a runtime error, or code that can't run at compile time) is
// kept in the Vm (`error`), and every step returns false up to evaluate(),
// which reports it.

#import "std/array";
#import "std/c";
#import "std/fs";
#import "std/fmt";
#import "std/io";
#import "std/map";
#import "std/mem";
#import "std/path";
#import "std/str";
#import "ast";
#import "const";
#import "module";
#import "resolve";
#import "token";
#import "types";
#import "check";
#import "comptime";
#import "lower";

// how a scalar is stored, which picks the arithmetic; vm_ffi.c knows the
// order
enum VmKind: u8 { I8, I16, I32, I64, U8, U16, U32, U64, F32, F64, Bool, Ptr }

enum VmOp: u8 {
    Const,       // slot a = imm (the low bytes, for kind)
    Zero,        // slot a = imm zero bytes
    Fill,        // slot a = imm bytes of 0xAA: a `---` local, so reading
                 // it before writing it shows
    Move,        // slot a = slot b, imm bytes
    AddrFrame,   // slot a = the address of slot b
    Addr,        // slot a = imm, a fixed address (global, string, function)
    Load,        // slot a = imm bytes from the pointer in slot b
    Store,       // imm bytes from slot b to the pointer in slot a
    PtrAdd,      // slot a = pointer b + (u64 c) * imm
    PtrOffset,   // slot a = pointer b + imm
    Bin,         // slot a = b <sub> c, both of kind
    Cmp,         // bool slot a = b <sub> c, both of kind
    Un,          // slot a = <sub> b
    Conv,        // slot a (kind) = slot b (kind sub)
    Jmp,         // to imm
    Jz,          // to imm if bool slot b is false
    Jnz,         // to imm if bool slot b is true
    Call,        // call site imm
    Ret,
    CheckIndex,  // u64 slot b < u64 slot c, or a bounds error
    CheckSlice,  // u64 slots a <= b <= c, or a bounds error
    CheckNull,   // pointer slot b isn't null, or "out of memory"
    MemZero,     // zeroes u64 slot c bytes at the pointer in slot b
    Fail,        // stops with message imm (an index into `messages`)
    StrEq,       // bool slot a = the strings in slots b and c are equal
}

enum VmBin: u8 { Add, Sub, Mul, Div, Mod, And, Or, Xor, Shl, Shr }
enum VmCmp: u8 { Eq, Ne, Lt, Gt, Le, Ge }
enum VmUn: u8 { Neg, Not, BitNot }

struct VmInstr {
    op: VmOp;
    kind: VmKind = .I64;
    sub: u8;
    a: u32;
    b: u32;
    c: u32;
    imm: u64;
    loc: u32; // index into VmFunction.locs, for errors
}

struct ArgSlot {
    slot: u32;
    size: u32;
}

struct VmCallSite {
    callee: *VmFunction; // a direct call, or null: the function value in
    fn_slot: u32;        // this slot
    args: [..]ArgSlot;   // in order
    arg_types: [..]*Type; // for C calls
    ret_slot: u32;
    ret_size: u32;
    ret_type: *Type;
    // a call through a C function pointer (`fn(...) #c_call`): the value is
    // a C address, called with libffi; c_fixed: a variadic one's fixed
    // parameters, else -1
    c_call: bool;
    c_fixed: i32;
    // a C call's libffi description, prepared the first time it runs
    prepared: bool;
    cif: *void;
    ffi_args: [..]*void;
}

struct VmFunction {
    decl: *Node;
    name: string;
    compiled: bool;
    compiling: bool;
    code: [..]VmInstr;
    calls: [..]VmCallSite;
    locs: [..]Token;
    messages: [..]string;   // for Fail
    frame_size: u32;
    frame_align: u32;       // its most aligned slot's alignment (#align)
    param_offsets: [..]u32; // the context pointer first, for Sabk code
    ret_offset: u32;
    ret_size: u32;

    // a C function
    native: bool;
    address: *void;
    unavailable: string;    // why `address` is null: its library's error
    is_abort: bool;         // stopped instead of called
    is_exit: bool;

    // a #c_call function, passed to C: a libffi closure that runs it
    closure_code: *void;    // what C calls
    closure_args: [..]*void;
}

// an error while compiling or running compile-time code
struct VmError {
    where: Token;
    message: string;
    silent: bool;          // the problem was reported already
    in_lowering: bool;     // the code can't run at compile time at all
    trace: [..]Token;      // the calls that led to it, innermost first
}

struct Vm {
    c: *Checker;
    functions: Map(*Node, *VmFunction);
    // the *VmFunctions handed out as values: what a Sabk function value
    // can hold (a C address there came through `as`, and C can't run it)
    function_values: Map(*void, bool);
    globals: Map(*Node, *u8);
    type_infos: Map(*Type, *u8);
    stack: []u8;
    stack_top: isize;
    depth: i32;
    steps: u64;
    ctx: *u8;
    failed: bool;
    error: VmError;
}

fn make_vm(c: *Checker) -> *Vm {
    let vm = new(Vm);
    vm.c = c;
    vm.stack = new([]u8, STACK_SIZE);
    running_vm = vm;
    return vm;
}

// the first failure is the one kept
fn vm_fail(vm: *Vm, where: Token, message: string, in_lowering: bool) {
    if (vm.failed)
        return;
    vm.failed = true;
    let none: [..]Token;
    vm.error = .{ .where = where, .message = message, .in_lowering = in_lowering, .trace = none };
}

/* ------------------------------------------------------------------ types */

fn concrete(vm: *Vm, t: *Type) -> *Type {
    let ts = &vm.c.types;
    return switch (t.kind) {
    case .UntypedInt: ts.i64;
    case .UntypedFloat: ts.f64;
    case .UntypedString: ts.string_;
    case .Null: ts.rawptr;
    default: t;
    };
}

fn kind_of(t: *Type) -> VmKind {
    switch (t.kind) {
    case .Int:
        return switch (t.bits) {
        case 8: if (t.is_signed) VmKind.I8 else VmKind.U8;
        case 16: if (t.is_signed) VmKind.I16 else VmKind.U16;
        case 32: if (t.is_signed) VmKind.I32 else VmKind.U32;
        default: if (t.is_signed) VmKind.I64 else VmKind.U64;
        };
    case .Enum: return kind_of(t.elem);
    case .Float: return if (t.bits == 32) .F32 else .F64;
    case .Bool: return .Bool;
    case .UntypedInt: return .I64;
    case .UntypedFloat: return .F64;
    default: return .Ptr; // pointers, rawptr, functions, null
    }
}

fn kind_size(k: VmKind) -> u32 {
    return switch (k) {
    case .I8, .U8, .Bool: 1;
    case .I16, .U16: 2;
    case .I32, .U32, .F32: 4;
    default: 8;
    };
}

fn is_float(k: VmKind) -> bool { return k == .F32 || k == .F64; }

// a float's bits as an instruction's immediate
fn float_bits(k: VmKind, v: f64) -> u64 {
    let bits: u64 = 0;
    write_float(&bits as *u8, k, v);
    return bits;
}

fn vm_size_of(vm: *Vm, of_type: *Type) -> u32 {
    let t = concrete(vm, of_type);
    if (t.kind == .Void)
        return 0;
    layout(vm.c, t);
    return t.size as u32;
}

fn vm_align_of(vm: *Vm, of_type: *Type) -> u32 {
    let t = concrete(vm, of_type);
    layout(vm.c, t);
    return if (t.align != 0) t.align as u32 else 1;
}

/* ------------------------------------------------------------------ C */

fn vm_dlsym(name: string) -> *void {
    let c_name = to_cstring(name);
    defer free(c_name);
    return vmffi_dlsym(c_name);
}

// Where a foreign function or variable is while compiling: in its
// library, opened for #run (once), or among what the compiler itself
// links. Null, and why when its library is the reason.
fn vm_foreign_address(decl: *Node) -> (*void, string) {
    let symbol = c_symbol(decl);
    let lib = foreign_library(decl);
    // libc and libm are the compiler's own (and glibc's libc.so can't be
    // dlopen-ed: it's a linker script), so a system library's names are
    // looked for there first
    if (lib == null || lib.kind is .Library{system: true}) {
        let found = vm_dlsym(symbol);
        if (found != null || lib == null)
            return found, "";
    }
    let handle, why = vm_open_library(lib);
    if (handle == null)
        return null, why;
    let c_name = to_cstring(symbol);
    defer free(c_name);
    let found = vmffi_dlsym_in(handle, c_name);
    if (found == null)
        return null, tformat("library `%` has no `%` (%)", library_text(lib), symbol, from_cstring(vmffi_dlerror()));
    return found, "";
}

// a library's handle for #run, opened the first time; null and why if it
// can't be
fn vm_open_library(lib: *Node) -> (*void, string) {
    let known = map_get(&opened_libraries, lib) or_else null;
    if (known != null)
        return known, "";
    let file = "";
    if (lib.kind is .Library{system: true}) {
        file = tformat("%.%", library_text(lib), if (OS == .MacOS) "dylib" else "so");
    } else {
        let found, _, tried = library_file(lib, true);
        if (found.len == 0) {
            let static_file, _, _ = library_file(lib, false);
            if (static_file.len > 0)
                return null, tformat("library `%` is a static archive (%), which only the program links: `#run` can only call into a shared one (%)",
                                     library_text(lib), path_base(static_file), if (OS == .MacOS) ".dylib" else ".so");
            return null, tformat("can't find library `%` (looked for %)", library_text(lib), join(tried, ", "));
        }
        file = found;
    }
    let handle, why = vm_dlopen(file, 0);
    if (handle == null)
        return null, tformat("can't open library `%` for `#run`: %", library_text(lib), why);
    map_put(&opened_libraries, lib, handle);
    return handle, "";
}

// dlopen, and through a linker script: glibc's libc.so and libm.so (and
// some systems' libncurses.so) are text, `GROUP ( /usr/lib/libm.so.6 ...
// )`, which only the linker reads, so the shared object it names is
// opened instead. Null and dlerror's text if it can't be.
fn vm_dlopen(file: string, depth: isize) -> (*void, string) {
    let c_path = to_cstring(file);
    defer free(c_path);
    let handle = vmffi_dlopen(c_path);
    if (handle != null)
        return handle, "";
    let why = copy_string(from_cstring(vmffi_dlerror()));
    // dlerror says "<the file it found>: invalid ELF header"
    let colon = index_of(why, ": ");
    if (depth > 2 || colon <= 0)
        return null, why;
    let text, err = read_file(why[..colon]);
    if (err != .None || !(contains(text, "GROUP") || contains(text, "INPUT")))
        return null, why;
    for (name in script_inputs(text)) {
        let target = if (starts_with(name, "-l")) tformat("lib%.so", name[2..]) else name;
        if (!contains(path_base(target), ".so"))
            continue; // a static part, like libc_nonshared.a
        let inner, _ = vm_dlopen(target, depth + 1);
        if (inner != null)
            return inner, "";
    }
    return null, why;
}

// the file names in a linker script's GROUP ( ... ) or INPUT ( ... )
fn script_inputs(text: string) -> [..]string {
    let names: [..]string;
    let word: [..]u8;
    let inside = false;
    for (c in text) {
        let space = c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '(' || c == ')';
        if (!space) {
            array_add(&word, c);
            continue;
        }
        if (word.len > 0) {
            let w = copy_string(word as string);
            if (inside && w != "AS_NEEDED")
                array_add(&names, w);
            word.len = 0;
        }
        if (c == '(')
            inside = true;
    }
    return names;
}

// a library's name as written: "libm", "vendor/libraylib"
fn library_text(lib: *Node) -> string {
    if (lib.kind is .Library{path})
        return path.text[1..path.text.len - 1];
    return "";
}

// A `#library`'s file: the path as written when it names a file, else the
// static archive (unless `shared_only`), then the shared object. Also
// whether it's shared, and the paths looked at, for an error.
fn library_file(lib: *Node, shared_only: bool) -> (string, bool, []string) {
    let tried: [..]string;
    let path, dir = "", "";
    if (lib.kind is .Library{path: p, dir: d})
        path, dir = p.text[1..p.text.len - 1], d;
    let full = path_normalize(path_join(dir, path, context.temp_allocator));
    let candidates: [..]string;
    array_add(&candidates, full);
    if (!shared_only)
        array_add(&candidates, tformat("%.a", full));
    array_add(&candidates, tformat("%.%", full, if (OS == .MacOS) "dylib" else "so"));
    for (file in candidates) {
        let shared = is_shared_object(file);
        if (shared_only && !shared && file != full)
            continue;
        array_add(&tried, file);
        if (file_exists(file) && !is_dir(file) && (shared || !shared_only))
            return path_real(file) or_else file, shared, tried;
    }
    return "", false, tried;
}

// libfoo.so, libfoo.so.6, libfoo.dylib
fn is_shared_object(file: string) -> bool {
    let base = path_base(file);
    return ends_with(base, ".so") || contains(base, ".so.") || ends_with(base, ".dylib");
}

// `#system_library "libm"` to the linker: `m`, or "" if it isn't named
// with its `lib`
fn system_link_name(lib: *Node) -> string {
    if (lib.kind is .Library{path}) {
        let name = path.text[1..path.text.len - 1];
        if (starts_with(name, "lib") && name.len > 3)
            return name[3..];
    }
    return "";
}

/* ---------------------------------------------- build script functions */

// What build scripts (top-level `#run`, using std/build) set. The compiler
// starts from these; options given on the command line win.
// std/build's BoundsChecks, in its order: index and slice checks as
// written (#no_bounds_check turns a function's off), none, or everywhere
enum BoundsChecks { On, Off, Always }

struct BuildOptions {
    output: string;        // the executable's path
    release: bool;
    bounds_checks: BoundsChecks;
    strict: bool;          // the strict warnings: dropped failures, values
                           // used before their failure is checked
    werror: bool;          // warnings fail the build
    c_flags: [..]string;   // passed to the C compiler as written
    libraries: [..]string; // -l<name>
    c_files: [..]string;   // compiled and linked with the program
    // what `#library` declarations the program uses link: static archives
    // by path, shared objects as -L<dir> -l:<file> (no rpath, as in Jai)
    library_files: [..]string;
    shared_libraries: [..]string;
    library_dirs: [..]string; // add_library_dir: -L, and --run's search path
    base_dir: string;      // relative paths are relative to this: the
                           // directory of the program's main file
    program_args: [..]string; // args() while compiling: the program's
                              // name, then what follows `--`
}

// std/build's functions: the compiler's own, which exist only while
// compiling
fn is_build_function(name: string) -> bool {
    return starts_with(name, "sabk_build_") && host_function(name) != null;
}

/* -------------------------------------------------------------- the VM */

// NUL-terminated, kept forever
fn vm_intern(vm: *Vm, bytes: string) -> *u8 {
    let p = alloc(bytes.len + 1) as *u8;
    copy_memory(p, bytes.ptr, bytes.len);
    p[bytes.len] = 0;
    return p;
}

// zeroed, 16-aligned, kept forever
fn vm_keep(vm: *Vm, size: isize, align: isize = 16) -> *u8 {
    let rounded = (size + 15) / 16 * 16 + 16;
    if (align <= 16) {
        let p = alloc(rounded, 16) as *u8;
        zero_memory(p, rounded);
        return p;
    }
    // kept forever, so the bytes before the aligned start are just unused
    let p = alloc(rounded + align, 16) as *u8;
    zero_memory(p, rounded + align);
    let start = ((p as isize) + align - 1) / align * align;
    return start as *u8;
}

fn vm_function_for(vm: *Vm, decl: *Node) -> *VmFunction {
    let known = map_get(&vm.functions, decl) or_else null;
    if (known != null)
        return known;
    let f = new(VmFunction);
    f.decl = decl;
    f.name = decl.tok.text;
    if (decl.kind is .Fn{is_extern: true, body} && body == null) {
        f.native = true;
        let symbol = c_symbol(decl);
        f.is_abort = symbol == "abort";
        f.is_exit = symbol == "exit";
        f.address = host_function(symbol);
        if (f.address == null)
            f.address, f.unavailable = vm_foreign_address(decl);
    }
    map_put(&vm.functions, decl, f);
    map_put(&vm.function_values, f, true);
    return f;
}

// a global's memory, its value in it; null (with the error kept) if it
// can't have one while compiling
fn vm_global_storage(vm: *Vm, decl: *Node) -> *u8 {
    let known = map_get(&vm.globals, decl) or_else null;
    if (known != null)
        return known;
    decl_type(vm.c, decl); // its initializer is checked, any #run in it baked
    if (decl.kind is .Let{is_extern: true}) { // C's own: the compiler's copy of it
        let found, why = vm_foreign_address(decl);
        let address = found as *u8;
        if (address == null) {
            let none: Token;
            vm_fail(vm, none, if (why.len > 0) why else tformat("the C variable `%` isn't available while compiling", decl.tok.text), false);
            return null;
        }
        map_put(&vm.globals, decl, address);
        return address;
    }
    let t = concrete(vm, decl.ty);
    let size = vm_size_of(vm, t);
    let storage = vm_keep(vm, size as isize, vm_align_of(vm, t) as isize);
    map_put(&vm.globals, decl, storage);
    let value = value_of(decl);
    if (value != null || has_defaults(vm.c, t)) {
        // the initializer (or the type's defaults) is a constant: run it
        // once, like the C's static data
        let init = new(VmFunction);
        init.name = "initializer";
        let l = make_lower(vm, init);
        l.lasting = true;
        if (value != null)
            lower_thunk(&l, value);
        else
            lower_default_thunk(&l, t);
        if (vm.failed)
            return null;
        let saved = vm.stack_top;
        let frame = push_frame(vm, init);
        if (frame == null || !execute(vm, init, frame))
            return null;
        copy_memory(storage, frame + init.ret_offset, size as isize);
        vm.stack_top = saved;
    }
    return storage;
}

// the compile-time context: the prelude's default_context(), run with an
// empty context to start
fn vm_context(vm: *Vm) -> *u8 {
    if (vm.ctx != null)
        return vm.ctx;
    let size = vm_size_of(vm, vm.c.context_type);
    vm.ctx = vm_keep(vm, size as isize);
    let boot = vm_keep(vm, size as isize);
    let decl = module_decl(vm.c.res.prelude, "default_context");
    let f = vm_function_for(vm, decl);
    if (!compile(vm, f))
        return vm.ctx;
    let saved = vm.stack_top;
    let frame = push_frame(vm, f);
    if (frame == null)
        return vm.ctx;
    ((frame + f.param_offsets[0] as isize) as **u8).* = boot;
    if (execute(vm, f, frame))
        copy_memory(vm.ctx, frame + f.ret_offset, size as isize);
    vm.stack_top = saved;
    return vm.ctx;
}

// a type's TypeInfo (the prelude's), built once: the same data the code
// generator writes for the program
fn vm_type_info(vm: *Vm, of_type: *Type) -> *u8 {
    let t = concrete(vm, of_type);
    let known = map_get(&vm.type_infos, t) or_else null;
    if (known != null)
        return known;
    let info_type = vm.c.type_info_type;
    let info = vm_keep(vm, vm_size_of(vm, info_type) as isize);
    map_put(&vm.type_infos, t, info); // first: a type can refer to itself
    let shape = shape_of(vm.c, t);
    set_int(info, info_type, "kind", type_kind_value(vm.c, shape.kind) as u64);
    set_text(vm, info, info_type, "name", type_name(t));
    set_int(info, info_type, "size", t.size);
    set_int(info, info_type, "align", t.align);
    set_int(info, info_type, "is_signed", if (t.kind == .Int && t.is_signed) 1 else 0);
    if (shape.elem != null)
        set_int(info, info_type, "elem", vm_type_info(vm, shape.elem) as usize);
    set_int(info, info_type, "count", shape.count);
    if (shape.fields.len > 0) {
        let field_type = prelude_type(vm, "TypeField");
        let size = vm_size_of(vm, field_type) as isize;
        let fields = vm_keep(vm, size * shape.fields.len);
        for (i in 0..shape.fields.len) {
            let f = fields + i * size;
            set_text(vm, f, field_type, "name", shape.fields[i].name);
            set_int(f, field_type, "info", vm_type_info(vm, shape.fields[i].ty) as usize);
            set_int(f, field_type, "offset", shape.fields[i].offset);
        }
        set_slice(info, info_type, "fields", fields, shape.fields.len as u64);
    }
    if (shape.variants.len > 0) {
        let variant_type = prelude_type(vm, "TypeVariant");
        let size = vm_size_of(vm, variant_type) as isize;
        let variants = vm_keep(vm, size * shape.variants.len);
        for (i in 0..shape.variants.len) {
            let v = variants + i * size;
            let shaped = shape.variants[i];
            set_text(vm, v, variant_type, "name", shaped.name);
            set_int(v, variant_type, "value", shaped.value as u64);
            if (shaped.payload != null)
                set_int(v, variant_type, "payload", vm_type_info(vm, shaped.payload) as usize);
        }
        set_slice(info, info_type, "variants", variants, shape.variants.len as u64);
    }
    return info;
}

// Runs `n`, a checked expression, and returns its value's bytes; on
// failure reports an error at `at` and returns false.
fn vm_evaluate(vm: *Vm, n: *Node, at: *Node) -> ([]u8, bool) {
    let saved_top = vm.stack_top;
    // While #run code runs, what it prints goes to stderr, like the
    // compiler's own messages: stdout may be carrying --emit-c's output.
    fflush(null);
    let saved_stdout = dup(1);
    dup2(2, 1);
    if (vm.depth == 0)
        vm.steps = 0;
    // a #run inside the code being compiled for another has its own errors
    let outer_failed, outer_error = vm.failed, vm.error;
    vm.failed = false;

    let out: []u8;
    let run = new(VmFunction);
    run.name = "#run";
    let l = make_lower(vm, run);
    l.lasting = true; // baked after this frame is gone
    lower_thunk(&l, n);
    if (!vm.failed) {
        let frame = push_frame(vm, run);
        if (frame != null && execute(vm, run, frame))
            out = clone_slice((frame + run.ret_offset)[0..run.ret_size as isize]);
    }

    fflush(null);
    dup2(saved_stdout, 1);
    close(saved_stdout);
    vm.stack_top = saved_top;
    let ok = !vm.failed;
    if (!ok)
        report_failure(vm, at);
    vm.failed, vm.error = outer_failed, outer_error;
    return out, ok;
}

/* --------------------------------------------------------- calls into C */

// a function C code can call: a C function, or a closure for a `#c_call`
// function; null if there's none
fn vm_c_address(vm: *Vm, f: *VmFunction) -> *void {
    if (f.native)
        return f.address;
    if (f.closure_code != null)
        return f.closure_code;
    let t = f.decl.ty;
    f.closure_args.len = 0;
    for (p in t.params) {
        if (!is_scalar(p))
            return null;
        array_add(&f.closure_args, ffi_type_for(vm, p));
    }
    if (t.ret.kind != .Void && !is_scalar(t.ret))
        return null;
    let ret = if (t.ret.kind == .Void) vmffi_type(-1) else ffi_type_for(vm, t.ret);
    let cif = vmffi_cif(-1, f.closure_args.len as i32, f.closure_args.ptr, ret);
    if (cif == null)
        return null;
    let data = new(ClosureData.{ .vm = vm, .f = f });
    f.closure_code = vmffi_closure(cif, closure_entry, data);
    return f.closure_code;
}

/* ----------------------------------------------------------------- baking */

// `#run` results that can become part of the program: no pointers; why
// not, if not
fn vm_bakeable(vm: *Vm, of_type: *Type) -> (bool, string) {
    let t = concrete(vm, of_type);
    switch (t.kind) {
    case .Int, .Float, .Bool, .Enum:
        return true, "";
    case .Array, .Slice:
        return vm_bakeable(vm, t.elem);
    case .Struct:
        if (t.is_tagged) { // only the variant it holds is kept
            for (fl in t.fields[1].ty.fields) {
                let ok, why = vm_bakeable(vm, fl.ty);
                if (!ok)
                    return false, tformat("its variant `%`: %", fl.name, why);
            }
            return true, "";
        }
        for (fl in t.fields) {
            let ok, why = vm_bakeable(vm, fl.ty);
            if (!ok)
                return false, tformat("its field `%`: %", fl.name, why);
        }
        return true, "";
    case .Ptr, .Rawptr:
        return false, "a pointer's address means nothing once the program runs";
    case .Fn:
        return false, "a function can't be carried over yet";
    case .DynArray:
        return false, "a dynamic array's elements were allocated while compiling; return a slice or an array instead";
    case .Union:
        return false, "a union doesn't say which of its fields holds the value";
    default:
        return false, tformat("% can't be carried over", type_name(t));
    }
}

// The value at `p`, of type `t`, as literals the code generator can write;
// null if it has a tagged enum whose tag isn't one of its variants (made
// with `as`), which has no literal
fn vm_bake(vm: *Vm, of_type: *Type, p: *u8, at: Token) -> *Node {
    let t = concrete(vm, of_type);
    let n: *Node = null;
    switch (t.kind) {
    case .Int, .Enum, .Bool:
        let k = kind_of(t);
        let v = read_int(p, k);
        let value = if (kind_signed(k)) i128(v as i64) else i128_u(v);
        if (t.kind == .Bool) {
            n = new_node(at, .Bool);
            n.cval = bool_const(v != 0);
        } else {
            n = new_node(at, .Number);
            n.cval = int_const(value);
        }
    case .Float:
        n = new_node(at, .Float);
        n.cval = float_const(read_float(p, kind_of(t)));
    case .Slice:
        let data = read_ptr(p);
        let len = read_u64(p + 8) as isize;
        if (t.elem == vm.c.types.u8) { // a string
            n = new_node(at, .String(quote_string(copy_string(data[0..len] as string))));
            break;
        }
        let items: [..]*Node;
        let size = vm_size_of(vm, t.elem) as isize;
        for (i in 0..len) {
            let item = vm_bake(vm, t.elem, data + i * size, at);
            if (item == null)
                return null;
            array_add(&items, item);
        }
        n = new_node(at, .ArrayLiteral(null, items));
    case .Array:
        let items: [..]*Node;
        let size = vm_size_of(vm, t.elem) as isize;
        for (i in 0..t.len as isize) {
            let item = vm_bake(vm, t.elem, p + i * size, at);
            if (item == null)
                return null;
            array_add(&items, item);
        }
        n = new_node(at, .ArrayLiteral(null, items));
    default:
        layout(vm.c, t);
        if (t.is_tagged) { // the variant its tag names, and that one's value
            let tag = t.fields[0];
            let tag_value = vm_bake(vm, tag.ty, p + tag.offset, at);
            let variant: *Node = null;
            for (v in enum_variants(t.decl))
                if (i128_eq(v.cval.i, tag_value.cval.i))
                    variant = v;
            if (variant == null)
                return null;
            let held: *Node = null;
            let payload = t.fields[1];
            for (fl in payload.ty.fields) {
                if (fl.decl == variant) {
                    held = vm_bake(vm, fl.ty, p + payload.offset, at);
                    if (held == null)
                        return null;
                }
            }
            n = new_node(at, .VariantValue(held));
            n.decl = variant;
            break;
        }
        let items: [..]*Node; // the fields in order
        for (fl in t.fields) {
            let item = vm_bake(vm, fl.ty, p + fl.offset, at);
            if (item == null)
                return null;
            array_add(&items, item);
        }
        n = new_node(at, .StructInit(null, items));
    }
    n.ty = t;
    return n;
}

#scope_file

// a runaway #run (an endless loop) stops with an error instead of hanging
const MAX_STEPS: u64 = 1000000000;
const MAX_DEPTH = 100000;
const STACK_SIZE = 64 << 20;

/* ------------------------------------------------------------------ types */

fn kind_signed(k: VmKind) -> bool { return k == .I8 || k == .I16 || k == .I32 || k == .I64; }

// a scalar at `p` as 64 bits, sign-extended for signed kinds
fn read_int(p: *u8, k: VmKind) -> u64 {
    return switch (k) {
    case .I8: ((p as *i8).* as i64) as u64;
    case .I16: ((p as *i16).* as i64) as u64;
    case .I32: ((p as *i32).* as i64) as u64;
    case .U8, .Bool: p.* as u64;
    case .U16: (p as *u16).* as u64;
    case .U32: (p as *u32).* as u64;
    default: (p as *u64).*;
    };
}

fn read_float(p: *u8, k: VmKind) -> f64 {
    if (k == .F32)
        return (p as *f32).* as f64;
    return (p as *f64).*;
}

// the low bytes: little-endian
fn write_int(p: *u8, k: VmKind, v: u64) {
    switch (kind_size(k)) {
    case 1: p.* = v as u8;
    case 2: (p as *u16).* = v as u16;
    case 4: (p as *u32).* = v as u32;
    default: (p as *u64).* = v;
    }
}

fn write_float(p: *u8, k: VmKind, v: f64) {
    if (k == .F32)
        (p as *f32).* = v as f32;
    else
        (p as *f64).* = v;
}

/* ------------------------------------------------------------------ C */

fn vmffi_dlsym(name: *u8) -> *void #foreign;
fn vmffi_dlopen(path: *u8) -> *void #foreign;
fn vmffi_dlsym_in(library: *void, name: *u8) -> *void #foreign;
fn vmffi_dlerror() -> *u8 #foreign;

let opened_libraries: Map(*Node, *void); // #run's handles, by library
fn vmffi_type(kind: i32) -> *void #foreign;
fn vmffi_cif(fixed: i32, count: i32, types: **void, ret: *void) -> *void #foreign;
fn vmffi_call(cif: *void, f: *void, ret: *void, args: **void) #foreign;
fn vmffi_closure(cif: *void, entry: *void, data: *void) -> *void #foreign;
fn memset(p: *void, c: i32, size: usize) -> *void #foreign libc;
fn memcmp(a: *void, b: *void, size: usize) -> i32 #foreign libc;
fn fflush(file: *void) -> i32 #foreign libc;
fn dup(fd: i32) -> i32 #foreign libc;
fn dup2(from: i32, to: i32) -> i32 #foreign libc;
fn close(fd: i32) -> i32 #foreign libc;
fn sabk_errno() -> i32 #foreign;

fn ffi_type_for(vm: *Vm, t: *Type) -> *void { return vmffi_type(kind_of(concrete(vm, t)) as i32); }

fn is_scalar(t: *Type) -> bool {
    switch (t.kind) {
    case .Int, .Float, .Bool, .Enum, .Ptr, .Rawptr, .Fn, .Null, .UntypedInt, .UntypedFloat: return true;
    default: return false;
    }
}

/* ---------------------------------------------- build script functions */

// the VM running now: what the host functions below work on
let running_vm: *Vm;

fn building() -> *BuildOptions { return &running_vm.c.build; }

fn host_path(p: *u8, len: isize) -> string {
    let path = copy_string(from_parts(p, len));
    let base = building().base_dir;
    if (path.len == 0 || path[0] == '/' || base.len == 0)
        return path;
    return format("%/%", base, path);
}

fn from_parts(p: *u8, len: isize) -> string { return p[0..len] as string; }

// std/build's functions call these, with strings as (pointer, length)
fn host_set_output(p: *u8, len: isize) #c_call { building().output = host_path(p, len); }
fn host_set_release(on: bool) #c_call { building().release = on; }
fn host_is_release() -> bool #c_call { return building().release; }
fn host_set_bounds_checks(mode: i32) #c_call { building().bounds_checks = mode as BoundsChecks; }
fn host_set_strict(on: bool) #c_call { building().strict = on; }
fn host_set_werror(on: bool) #c_call { building().werror = on; }
fn host_add_c_flags(p: *u8, len: isize) #c_call {
    array_add(&building().c_flags, copy_string(from_parts(p, len)));
}
fn host_link_library(p: *u8, len: isize) #c_call {
    let name = copy_string(from_parts(p, len));
    for (have in building().libraries)
        if (have == name)
            return; // several modules can ask for the same one
    array_add(&building().libraries, name);
}
fn host_add_c_file(p: *u8, len: isize) #c_call { array_add(&building().c_files, host_path(p, len)); }
fn host_add_library_dir(p: *u8, len: isize) #c_call {
    let dir = host_path(p, len);
    array_add(&building().library_dirs, path_real(dir) or_else dir);
}

// args() (std/os) while compiling
fn host_arg_count() -> i32 #c_call { return building().program_args.len as i32; }
fn host_arg(i: i32) -> *u8 #c_call { return vm_intern(running_vm, building().program_args[i]); }

// errno (std/io), of the C functions #run called
fn host_errno() -> i32 #c_call { return sabk_errno(); }

// --sanitize's poisoning (the C runtime's); #run code isn't built with it
fn host_poison(memory: *void, size: isize) #c_call {}

// error_enum() (the prelude's): the TypeInfo of the enum an Error came from
fn host_error_type(id: u32) -> *void #c_call {
    let enums = running_vm.c.error_enums;
    if (id == 0 || (id as isize) > enums.len)
        return null;
    return vm_type_info(running_vm, enums[id - 1]);
}

fn host_function(name: string) -> *void {
    return switch (name) {
    case "sabk_arg_count": host_arg_count;
    case "sabk_arg": host_arg;
    case "sabk_errno": host_errno;
    case "sabk_poison": host_poison;
    case "sabk_unpoison": host_poison;
    case "sabk_error_type": host_error_type;
    case "sabk_build_set_output": host_set_output;
    case "sabk_build_set_release": host_set_release;
    case "sabk_build_is_release": host_is_release;
    case "sabk_build_set_bounds_checks": host_set_bounds_checks;
    case "sabk_build_set_strict": host_set_strict;
    case "sabk_build_set_werror": host_set_werror;
    case "sabk_build_add_c_flags": host_add_c_flags;
    case "sabk_build_link_library": host_link_library;
    case "sabk_build_add_c_file": host_add_c_file;
    case "sabk_build_add_library_dir": host_add_library_dir;
    default: null;
    };
}

/* -------------------------------------------------------------- the VM */

// false (with the error kept) if it can't be compiled; it starts over if
// it's needed again
fn compile(vm: *Vm, f: *VmFunction) -> bool {
    if (f.compiled)
        return true;
    f.compiling = true;
    let l = make_lower(vm, f);
    lower_function(&l);
    f.compiling = false;
    if (vm.failed) {
        f.code.len = 0;
        f.calls.len = 0;
        f.locs.len = 0;
        f.param_offsets.len = 0;
        f.frame_size, f.ret_offset, f.ret_size = 0, 0, 0;
        return false;
    }
    f.compiled = true;
    return true;
}

fn field_named(t: *Type, name: string) -> *Field {
    for (i in 0..t.fields.len)
        if (t.fields[i].name == name)
            return &t.fields[i];
    return null;
}

fn set_int(base: *u8, of: *Type, name: string, value: u64) {
    let f = field_named(of, name);
    if (f != null)
        write_int(base + f.offset, kind_of(f.ty), value);
}

fn set_slice(base: *u8, of: *Type, name: string, data: *u8, len: u64) {
    let f = field_named(of, name);
    if (f != null) {
        ((base + f.offset) as **u8).* = data;
        ((base + f.offset + 8) as *u64).* = len;
    }
}

fn set_text(vm: *Vm, base: *u8, of: *Type, name: string, text: string) {
    set_slice(base, of, name, vm_intern(vm, text), text.len as u64);
}

fn prelude_type(vm: *Vm, name: string) -> *Type {
    let d = module_decl(vm.c.res.prelude, name);
    return decl_type(vm.c, d);
}

// null (with the error kept) when the stack is full
fn push_frame(vm: *Vm, f: *VmFunction) -> *u8 {
    // the frame's address is as aligned as its most aligned slot, so an
    // #align(64) local is where C would put it
    let align: isize = if (f.frame_align > 16) f.frame_align as isize else 16;
    let base = vm.stack.ptr as isize;
    vm.stack_top = (base + vm.stack_top + align - 1) / align * align - base;
    if (vm.stack_top + (f.frame_size as isize) + 16 > vm.stack.len) {
        let none: Token;
        vm_fail(vm, none, "the compile-time stack overflowed (recursion too deep?)", false);
        return null;
    }
    let frame = vm.stack.ptr + vm.stack_top;
    zero_memory(frame, f.frame_size as isize);
    vm.stack_top += f.frame_size as isize;
    return frame;
}

fn same_place(a: Token, b: Token) -> bool { return a.text.ptr == b.text.ptr; }

fn has_place(t: Token) -> bool { return t.text.ptr != null; }

fn report_failure(vm: *Vm, at: *Node) {
    let e = &vm.error;
    let c = vm.c;
    if (e.silent)
        return;
    if (e.in_lowering) { // the code can't run at compile time at all
        error(c, e.where, e.message);
        return;
    }
    error(c, at.tok, tformat("`#run` failed: %", e.message));
    if (has_place(e.where))
        note(c, e.where, "here");
    // the calls that led there, innermost first; recursion shows once
    let shown = 0;
    let i: isize = 0;
    while (i < e.trace.len) {
        let same: isize = 1;
        while (i + same < e.trace.len && same_place(e.trace[i + same], e.trace[i]))
            same++;
        shown++;
        if (shown == 6 && i + same < e.trace.len) {
            note(c, e.trace[e.trace.len - 1], tformat("called from here, % calls further out", e.trace.len - i - 1));
            break;
        }
        note(c, e.trace[i], if (same == 1) "called from here" else tformat("called from here, % times in a row", same));
        i += same;
    }
}

/* --------------------------------------------------------- calls into C */

struct ClosureData {
    vm: *Vm;
    f: *VmFunction;
}

fn closure_entry(cif: *void, ret: *void, args: **void, data: *void) #c_call {
    let d = data as *ClosureData;
    call_from_c(d.vm, d.f, ret as *u8, args);
}

// C called back into compile-time code. A failure can't unwind through the
// C function's frames: it's kept, and the C function's caller sees it once
// it returns.
fn call_from_c(vm: *Vm, f: *VmFunction, ret: *u8, args: **void) {
    let ret_type = concrete(vm, f.decl.ty.ret);
    let ret_size = if (ret_type.kind == .Void) 0 else vm_size_of(vm, ret_type);
    if (ret_size != 0)
        zero_memory(ret, if (ret_size < 8) 8 else ret_size as isize);
    if (vm.failed)
        return; // an earlier call failed; let C finish quickly
    let saved = vm.stack_top;
    if (compile(vm, f)) {
        let frame = push_frame(vm, f);
        if (frame != null) {
            let params = f.decl.ty.params;
            for (i in 0..params.len)
                copy_memory(frame + f.param_offsets[i], args[i], vm_size_of(vm, params[i]) as isize);
            if (execute(vm, f, frame) && ret_size != 0) {
                // libffi wants small integers widened to a whole register
                let k = kind_of(ret_type);
                if (!is_float(k) && ret_size < 8)
                    (ret as *u64).* = read_int(frame + f.ret_offset, k);
                else
                    copy_memory(ret, frame + f.ret_offset, ret_size as isize);
            }
        }
    }
    vm.stack_top = saved;
}

// false (with the error kept) if it fails
fn call_native(vm: *Vm, call: *VmCallSite, f: *VmFunction, frame: *u8) -> bool {
    let none: Token; // execute() puts the call's location in
    if (f.is_abort) {
        vm_fail(vm, none, "it called abort() (a panic?)", false);
        return false;
    }
    if (f.is_exit) {
        let code = ((frame + call.args[0].slot as isize) as *i32).*;
        vm_fail(vm, none, tformat("it called exit(%)", code), false);
        return false;
    }
    if (f.address == null) {
        vm_fail(vm, none, if (f.unavailable.len > 0) tformat("can't call `%`: %", f.name, f.unavailable)
                          else tformat("the C function `%` isn't available while compiling", f.name), false);
        return false;
    }
    let fixed: i32 = if (f.decl.ty.is_variadic) f.decl.ty.params.len as i32 else -1;
    return call_c(vm, call, f.address, tformat("the C function `%`", f.name), fixed, frame);
}

// calls C code at `address` with libffi: `what` names it in errors;
// `fixed`, a variadic function's fixed parameters, else -1
fn call_c(vm: *Vm, call: *VmCallSite, address: *void, what: string, fixed: i32, frame: *u8) -> bool {
    let none: Token; // execute() puts the call's location in
    if (!call.prepared) {
        call.ffi_args.len = 0;
        for (t in call.arg_types) {
            // a C function pointer is an address C can call; a Sabk function
            // isn't (it would need a context)
            if (t.kind == .Fn && !t.is_c_call) {
                vm_fail(vm, none, tformat("can't pass a Sabk function to % at compile time: C can't call it without its context", what), false);
                return false;
            }
            if (!is_scalar(t)) {
                vm_fail(vm, none, tformat("can't call % at compile time: it takes a % by value", what, type_name(t)), false);
                return false;
            }
            array_add(&call.ffi_args, ffi_type_for(vm, t));
        }
        let ret = call.ret_type;
        if (ret.kind != .Void && !is_scalar(ret)) {
            vm_fail(vm, none, tformat("can't call % at compile time: it returns a %", what, type_name(ret)), false);
            return false;
        }
        let ret_ffi = if (ret.kind == .Void) vmffi_type(-1) else ffi_type_for(vm, ret);
        call.cif = vmffi_cif(fixed, call.ffi_args.len as i32, call.ffi_args.ptr, ret_ffi);
        if (call.cif == null) {
            vm_fail(vm, none, tformat("can't call %", what), false);
            return false;
        }
        call.prepared = true;
    }
    let values = new([]*void, call.args.len, context.temp_allocator);
    for (i in 0..call.args.len)
        values[i] = frame + call.args[i].slot as isize;
    let result: [2]u64 = .[0, 0]; // at least an ffi_arg
    vmffi_call(call.cif, address, &result, values.ptr);
    if (vm.failed)
        return false; // a callback from C failed
    if (call.ret_size != 0)
        copy_memory(frame + call.ret_slot as isize, &result, call.ret_size as isize);
    return true;
}

/* -------------------------------------------------------- the interpreter */

struct Caller {
    f: *VmFunction;
    frame: *u8;
    pc: isize;        // just after the call
    stack_top: isize; // before the callee's frame
}

// where instruction `in` of `f` came from
fn location(f: *VmFunction, i: VmInstr) -> Token {
    if ((i.loc as isize) < f.locs.len)
        return f.locs[i.loc];
    let none: Token;
    return none;
}

fn slot(frame: *u8, at_offset: u32) -> *u8 { return frame + at_offset as isize; }
fn read_ptr(p: *u8) -> *u8 { return (p as **u8).*; }
fn read_u64(p: *u8) -> u64 { return (p as *u64).*; }
fn read_i64(p: *u8) -> i64 { return (p as *i64).*; }

// Runs `f` in `frame`; false (with the error kept) if it fails. Calls
// between Sabk functions don't recurse here: the callers wait on
// `callers`, so deep recursion in the program can't overflow the
// compiler's own stack.
fn execute(vm: *Vm, entry: *VmFunction, entry_frame: *u8) -> bool #no_bounds_check {
    let callers: [..]Caller;
    defer array_free(&callers);
    let f = entry;
    let frame = entry_frame;
    let pc: isize = 0;
    vm.depth++;
    let ok = run(vm, &f, &frame, &pc, &callers);
    if (!ok) {
        // where it failed, and the calls that led there
        let e = &vm.error;
        let here = location(f, f.code[pc - 1]);
        if (!has_place(e.where) && !e.silent) // from push_frame or a C call
            e.where = here;
        if (!e.in_lowering) {
            if (!same_place(e.where, here)) // from a callback from C
                array_add(&e.trace, here);
            let i = callers.len;
            while (i > 0) {
                i--;
                let caller = callers[i];
                array_add(&e.trace, location(caller.f, caller.f.code[caller.pc - 1]));
            }
        }
    }
    vm.depth--;
    return ok;
}

fn fail_at(vm: *Vm, f: *VmFunction, i: VmInstr, message: string) -> bool {
    vm_fail(vm, location(f, i), message, false);
    return false;
}

fn run(vm: *Vm, fp: **VmFunction, framep: **u8, pcp: *isize, callers: *[..]Caller) -> bool #no_bounds_check {
    let f = fp.*;
    let frame = framep.*;
    let pc = pcp.*;
    defer {
        fp.* = f;
        framep.* = frame;
        pcp.* = pc;
    }
    while (true) {
        let i = f.code[pc];
        pc++;
        vm.steps++;
        if (vm.steps > MAX_STEPS)
            return fail_at(vm, f, i, "it ran for over a billion steps; is it stuck in a loop?");
        switch (i.op) {
        case .Const:
            write_int(slot(frame, i.a), i.kind, i.imm);
        case .Zero:
            zero_memory(slot(frame, i.a), i.imm as isize);
        case .Fill:
            memset(slot(frame, i.a), 0xAA, i.imm as usize);
        case .Move:
            copy_memory(slot(frame, i.a), slot(frame, i.b), i.imm as isize);
        case .AddrFrame:
            (slot(frame, i.a) as **u8).* = slot(frame, i.b);
        case .Addr:
            (slot(frame, i.a) as *u64).* = i.imm;
        case .Load:
            let p = read_ptr(slot(frame, i.b));
            if (p == null)
                return fail_at(vm, f, i, "a null pointer was dereferenced");
            copy_memory(slot(frame, i.a), p, i.imm as isize);
        case .Store:
            let p = read_ptr(slot(frame, i.a));
            if (p == null)
                return fail_at(vm, f, i, "a null pointer was dereferenced");
            copy_memory(p, slot(frame, i.b), i.imm as isize);
        case .PtrAdd:
            let p = read_u64(slot(frame, i.b));
            let index = read_u64(slot(frame, i.c));
            (slot(frame, i.a) as *u64).* = p + index * i.imm;
        case .PtrOffset:
            (slot(frame, i.a) as *u64).* = read_u64(slot(frame, i.b)) + i.imm;
        case .Bin:
            if (!binary(vm, f, i, frame))
                return false;
        case .Cmp:
            slot(frame, i.a).* = if (compare(i, frame)) 1 else 0;
        case .Un:
            if (i.sub == VmUn.Not as u8) {
                slot(frame, i.a).* = if (slot(frame, i.b).* == 0) 1 else 0;
            } else if (is_float(i.kind)) {
                write_float(slot(frame, i.a), i.kind, -read_float(slot(frame, i.b), i.kind));
            } else {
                let x = read_int(slot(frame, i.b), i.kind);
                write_int(slot(frame, i.a), i.kind, if (i.sub == VmUn.Neg as u8) 0 - x else ~x);
            }
        case .Conv:
            convert_scalar(i, frame);
        case .Jmp:
            pc = i.imm as isize;
        case .Jz:
            if (slot(frame, i.b).* == 0)
                pc = i.imm as isize;
        case .Jnz:
            if (slot(frame, i.b).* != 0)
                pc = i.imm as isize;
        case .Call:
            let call = &f.calls[i.imm];
            let callee = call.callee;
            if (callee == null && call.c_call) { // through a C function pointer
                let address = (slot(frame, call.fn_slot) as **void).*;
                if (address == null)
                    return fail_at(vm, f, i, "a null C function pointer was called");
                if (map_has(&vm.function_values, address))
                    return fail_at(vm, f, i, "a Sabk function was called through a C function type (`#c_call`): it needs the context C doesn't pass; declare it `#c_call`");
                if (!call_c(vm, call, address, "this C function pointer", call.c_fixed, frame))
                    return false;
                continue;
            }
            if (callee == null) {
                callee = (slot(frame, call.fn_slot) as **VmFunction).*;
                if (callee == null)
                    return fail_at(vm, f, i, "a null function pointer was called");
                if (!map_has(&vm.function_values, callee))
                    return fail_at(vm, f, i, "a C function was called through a Sabk function type: give the type `#c_call`");
            }
            if (callee.native) {
                if (!call_native(vm, call, callee, frame))
                    return false;
                continue;
            }
            if (!callee.compiled) {
                if (callee.compiling)
                    return fail_at(vm, f, i, tformat("`%` is needed while it's being compiled", callee.name));
                if (!compile(vm, callee))
                    return false;
            }
            if (callers.len >= MAX_DEPTH)
                return fail_at(vm, f, i, tformat("the calls went over % deep; is the recursion endless?", MAX_DEPTH));
            let saved = vm.stack_top;
            let callee_frame = push_frame(vm, callee);
            if (callee_frame == null)
                return false;
            for (k in 0..call.args.len) {
                if (k >= callee.param_offsets.len)
                    break;
                copy_memory(slot(callee_frame, callee.param_offsets[k]), slot(frame, call.args[k].slot),
                            call.args[k].size as isize);
            }
            array_add(callers, Caller.{ .f = f, .frame = frame, .pc = pc, .stack_top = saved });
            f = callee;
            frame = callee_frame;
            pc = 0;
        case .Fail:
            return fail_at(vm, f, i, f.messages[i.imm]);
        case .StrEq:
            let x = read_ptr(slot(frame, i.b));
            let x_len = read_u64(slot(frame, i.b + 8));
            let y = read_ptr(slot(frame, i.c));
            let y_len = read_u64(slot(frame, i.c + 8));
            let same = x_len == y_len && (x_len == 0 || memcmp(x, y, x_len as usize) == 0);
            slot(frame, i.a).* = if (same) 1 else 0;
        case .Ret:
            if (callers.len == 0)
                return true;
            let callee = f;
            let callee_frame = frame;
            let caller = callers.*[callers.len - 1];
            callers.len--;
            f = caller.f;
            frame = caller.frame;
            pc = caller.pc;
            let call = &f.calls[f.code[pc - 1].imm];
            if (call.ret_size != 0)
                copy_memory(slot(frame, call.ret_slot), slot(callee_frame, callee.ret_offset), call.ret_size as isize);
            vm.stack_top = caller.stack_top;
        case .CheckIndex:
            let index = read_i64(slot(frame, i.b)); // as the compiled code sees them: isize
            let len = read_i64(slot(frame, i.c));
            if ((index as u64) >= (len as u64)) // a negative index is huge unsigned
                return fail_at(vm, f, i, tformat("index % is out of bounds for length %", index, len));
        case .CheckSlice:
            let lo = read_i64(slot(frame, i.a));
            let hi = read_i64(slot(frame, i.b));
            let len = read_i64(slot(frame, i.c));
            if (lo > hi)
                return fail_at(vm, f, i, tformat("slice [%..%] starts after it ends", lo, hi));
            if (lo < 0 || hi > len)
                return fail_at(vm, f, i, tformat("slice [%..%] is out of bounds for length %", lo, hi, len));
        case .CheckNull:
            if (read_ptr(slot(frame, i.b)) == null)
                return fail_at(vm, f, i, "out of memory");
        case .MemZero:
            zero_memory(read_ptr(slot(frame, i.b)), read_u64(slot(frame, i.c)) as isize);
        }
    }
    return true;
}

fn binary(vm: *Vm, f: *VmFunction, i: VmInstr, frame: *u8) -> bool {
    let op = i.sub as VmBin;
    if (is_float(i.kind)) {
        let r: f64 = 0.0;
        if (i.kind == .F32) { // float arithmetic, like the C
            let x = read_float(slot(frame, i.b), i.kind) as f32;
            let y = read_float(slot(frame, i.c), i.kind) as f32;
            let fr: f32 = 0.0;
            switch (op) {
            case .Add: fr = x + y;
            case .Sub: fr = x - y;
            case .Mul: fr = x * y;
            case .Div: fr = x / y;
            default:
            }
            r = fr as f64;
        } else {
            let x = read_float(slot(frame, i.b), i.kind);
            let y = read_float(slot(frame, i.c), i.kind);
            switch (op) {
            case .Add: r = x + y;
            case .Sub: r = x - y;
            case .Mul: r = x * y;
            case .Div: r = x / y;
            default:
            }
        }
        write_float(slot(frame, i.a), i.kind, r);
        return true;
    }
    let x = read_int(slot(frame, i.b), i.kind);
    let y = if (op == .Shl || op == .Shr) read_int(slot(frame, i.c), .U64) else read_int(slot(frame, i.c), i.kind);
    let r: u64 = 0;
    let signed = kind_signed(i.kind);
    let bits = (kind_size(i.kind) * 8) as u64;
    switch (op) {
    case .Add: r = x + y;
    case .Sub: r = x - y;
    case .Mul: r = x * y;
    case .And: r = x & y;
    case .Or: r = x | y;
    case .Xor: r = x ^ y;
    case .Div, .Mod:
        if (y == 0)
            return fail_at(vm, f, i, "division by zero");
        if (signed) {
            let sx, sy = x as i64, y as i64;
            if (sy == -1)
                r = if (op == .Div) 0 - x else 0; // wraps, like -fwrapv
            else
                r = (if (op == .Div) sx / sy else sx % sy) as u64;
        } else {
            // the operands are already zero-extended to 64 bits
            r = if (op == .Div) x / y else x % y;
        }
    case .Shl:
        r = if (y >= bits) 0 else x << y;
    case .Shr:
        if (signed)
            r = ((x as i64) >> (if (y >= 64) 63 else y)) as u64;
        else
            r = if (y >= 64) 0 else x >> y;
    }
    write_int(slot(frame, i.a), i.kind, r);
    return true;
}

fn compare(i: VmInstr, frame: *u8) -> bool {
    let op = i.sub as VmCmp;
    if (is_float(i.kind)) {
        let x = read_float(slot(frame, i.b), i.kind);
        let y = read_float(slot(frame, i.c), i.kind);
        return switch (op) {
        case .Eq: x == y;
        case .Ne: x != y;
        case .Lt: x < y;
        case .Gt: x > y;
        case .Le: x <= y;
        case .Ge: x >= y;
        };
    }
    let x = read_int(slot(frame, i.b), i.kind);
    let y = read_int(slot(frame, i.c), i.kind);
    if (kind_signed(i.kind)) {
        let sx, sy = x as i64, y as i64;
        return switch (op) {
        case .Eq: sx == sy;
        case .Ne: sx != sy;
        case .Lt: sx < sy;
        case .Gt: sx > sy;
        case .Le: sx <= sy;
        case .Ge: sx >= sy;
        };
    }
    return switch (op) {
    case .Eq: x == y;
    case .Ne: x != y;
    case .Lt: x < y;
    case .Gt: x > y;
    case .Le: x <= y;
    case .Ge: x >= y;
    };
}

fn convert_scalar(i: VmInstr, frame: *u8) {
    let from = i.sub as VmKind;
    let to = i.kind;
    if (is_float(from) && is_float(to)) {
        write_float(slot(frame, i.a), to, read_float(slot(frame, i.b), from));
    } else if (is_float(from)) { // truncates, like a C cast
        let v = read_float(slot(frame, i.b), from);
        let r = if (kind_signed(to) || v < 0.0) (v as i64) as u64 else v as u64;
        write_int(slot(frame, i.a), to, r);
    } else if (is_float(to)) {
        let v = read_int(slot(frame, i.b), from);
        let d = if (kind_signed(from)) (v as i64) as f64 else v as f64;
        write_float(slot(frame, i.a), to, d);
    } else {
        write_int(slot(frame, i.a), to, read_int(slot(frame, i.b), from));
    }
}
